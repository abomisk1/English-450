<h2>بَرْدُ اليقين — عناصر المراجعة الشرعية والتعليمية (302 عنصرًا)</h2>
<p>مرتّبة بالأولوية ثم الوحدة. حالة الاعتماد «بانتظار المراجعة» للجميع — لم يُعتمد أي عنصر تلقائيًّا.</p>
<table><thead><tr><th>البند</th><th>العدد</th></tr></thead><tbody><tr><td>عالية</td><td>28</td></tr><tr><td>متوسطة</td><td>130</td></tr><tr><td>منخفضة</td><td>144</td></tr><tr><td>تفسير ما يتكرر</td><td>46</td></tr><tr><td>الأخلاق</td><td>45</td></tr><tr><td>الرقائق</td><td>61</td></tr><tr><td>الأحاديث النبوية</td><td>20</td></tr><tr><td>مراتب الدين</td><td>18</td></tr><tr><td>الفقه</td><td>37</td></tr><tr><td>الأذكار والآداب</td><td>75</td></tr></tbody></table>
<br>
<table><thead><tr><th>م</th><th>الوحدة</th><th>الدرس</th><th>نوع العنصر</th><th>النص</th><th>المصدر</th><th>صفحة الكتاب</th><th>سبب الحاجة إلى المراجعة</th><th>الأولوية</th><th>حالة الاعتماد</th><th>الملاحظات</th><th>النص بعد التحرير</th><th>نص الكتاب المرجعي</th><th>المرجع</th><th>المعرّف</th><th>موضعه في البرنامج</th></tr></thead><tbody><tr class="p-high"><td>9</td><td>تفسير ما يتكرر</td><td>البسملة</td><td>نصّ قرآني</td><td>بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</td><td>نصّ قرآني</td><td>7</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>الفاتحة: ١</td><td>u1/u1l2/cards/c1</td><td>#/lesson/u1/u1l2</td></tr><tr class="p-high"><td>15</td><td>تفسير ما يتكرر</td><td>سورة الفاتحة</td><td>نصّ قرآني</td><td>بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ ﴿١﴾ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ﴿٢﴾ الرَّحْمَٰنِ الرَّحِيمِ ﴿٣﴾ مَالِكِ يَوْمِ الدِّينِ ﴿٤﴾ إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ ﴿٥﴾ اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ ﴿٦﴾ صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ ﴿٧﴾</td><td>نصّ قرآني</td><td>8</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>سورة الفاتحة: ١-٧</td><td>u1/u1l3/cards/c1</td><td>#/lesson/u1/u1l3</td></tr><tr class="p-high"><td>17</td><td>تفسير ما يتكرر</td><td>سورة الفاتحة</td><td>interaction:complete-quran</td><td>أكمل الآية.<br>✔ نَسْتَعِينُ<br>— نَسْتَغْفِرُ<br>— نَشْكُرُ<br>— نَدْعُو<br>التفسير: معناها في الكتاب: نعبدك وحدك، ونستعين بك وحدك.</td><td>derived</td><td>8</td><td>إكمال مقطع من آية بالاختيار — الخيارات الثلاثة الأخرى صياغات تُشبه القرآن وليست منه، فيحتاج إقرارًا صريحًا لأسلوب السؤال قبل النشر، لا لنصّه فقط.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَجِبُ عَلَى الْمُسْلِمِ أَنْ يَتَعَلَّمَ قِرَاءَةَ سُورَةِ الْفَاتِحَةِ؛ لِأَنَّ الصَّلَاةَ لَا تَصِحُّ إِلَّا بِهَا، وَيَحْسُنُ أَنْ يَتَعَلَّمَ قِرَاءَةَ كِتَابِ اللهِ كَامِلًا، فَإِنْ لَمْ يَكُنْ فَمَا اسْتَطَاعَ مِنْهُ.</td><td></td><td>u1/u1l3/interaction/i3</td><td>#/lesson/u1/u1l3</td></tr><tr class="p-high"><td>21</td><td>تفسير ما يتكرر</td><td>آية الكرسي</td><td>نصّ قرآني</td><td>اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ ۚ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ ۚ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۗ مَنْ ذَا الَّذِي يَشْفَعُ عِنْدَهُ إِلَّا بِإِذْنِهِ ۚ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ ۖ وَلَا يُحِيطُونَ بِشَيْءٍ مِنْ عِلْمِهِ إِلَّا بِمَا شَاءَ ۚ وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ ۖ وَلَا يَئُودُهُ حِفْظُهُمَا ۚ وَهُوَ الْعَلِيُّ الْعَظِيمُ ﴿٢٥٥﴾</td><td>نصّ قرآني</td><td>10</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>البقرة: ٢٥٥</td><td>u1/u1l4/cards/c1</td><td>#/lesson/u1/u1l4</td></tr><tr class="p-high"><td>22</td><td>تفسير ما يتكرر</td><td>آية الكرسي</td><td>interaction:complete-quran</td><td>أكمل الآية.<br>✔ الْحَيُّ الْقَيُّومُ<br>— الْعَلِيُّ الْعَظِيمُ<br>— الْغَفُورُ الرَّحِيمُ<br>— السَّمِيعُ الْعَلِيمُ<br>التفسير: أول آية الكرسي: ﴿اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ﴾.</td><td>derived</td><td>10</td><td>إكمال مقطع من آية بالاختيار — الخيارات الثلاثة الأخرى صياغات تُشبه القرآن وليست منه، فيحتاج إقرارًا صريحًا لأسلوب السؤال قبل النشر، لا لنصّه فقط.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ أَعْظَمُ آيَةٍ فِي الْقُرْآنِ.</td><td></td><td>u1/u1l4/interaction/i2</td><td>#/lesson/u1/u1l4</td></tr><tr class="p-high"><td>26</td><td>تفسير ما يتكرر</td><td>آخر آيتين من سورة البقرة</td><td>نصّ قرآني</td><td>آمَنَ الرَّسُولُ بِمَا أُنْزِلَ إِلَيْهِ مِنْ رَبِّهِ وَالْمُؤْمِنُونَ ۚ كُلٌّ آمَنَ بِاللَّهِ وَمَلَائِكَتِهِ وَكُتُبِهِ وَرُسُلِهِ لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِنْ رُسُلِهِ ۚ وَقَالُوا سَمِعْنَا وَأَطَعْنَا ۖ غُفْرَانَكَ رَبَّنَا وَإِلَيْكَ الْمَصِيرُ ﴿٢٨٥﴾</td><td>نصّ قرآني</td><td>11</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>البقرة: ٢٨٥</td><td>u1/u1l5/cards/c1</td><td>#/lesson/u1/u1l5</td></tr><tr class="p-high"><td>27</td><td>تفسير ما يتكرر</td><td>آخر آيتين من سورة البقرة</td><td>نصّ قرآني</td><td>لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا ۚ لَهَا مَا كَسَبَتْ وَعَلَيْهَا مَا اكْتَسَبَتْ ۗ رَبَّنَا لَا تُؤَاخِذْنَا إِنْ نَسِينَا أَوْ أَخْطَأْنَا ۚ رَبَّنَا وَلَا تَحْمِلْ عَلَيْنَا إِصْرًا كَمَا حَمَلْتَهُ عَلَى الَّذِينَ مِنْ قَبْلِنَا ۚ رَبَّنَا وَلَا تُحَمِّلْنَا مَا لَا طَاقَةَ لَنَا بِهِ ۖ وَاعْفُ عَنَّا وَاغْفِرْ لَنَا وَارْحَمْنَا ۚ أَنْتَ مَوْلَانَا فَانْصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ ﴿٢٨٦﴾</td><td>نصّ قرآني</td><td>11</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>البقرة: ٢٨٦</td><td>u1/u1l5/cards/c2</td><td>#/lesson/u1/u1l5</td></tr><tr class="p-high"><td>31</td><td>تفسير ما يتكرر</td><td>سورة الكافرون</td><td>نصّ قرآني</td><td>قُلْ يَا أَيُّهَا الْكَافِرُونَ ﴿١﴾ لَا أَعْبُدُ مَا تَعْبُدُونَ ﴿٢﴾ وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ ﴿٣﴾ وَلَا أَنَا عَابِدٌ مَا عَبَدْتُمْ ﴿٤﴾ وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ ﴿٥﴾ لَكُمْ دِينُكُمْ وَلِيَ دِينِ ﴿٦﴾</td><td>نصّ قرآني</td><td>12</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>سورة الكافرون</td><td>u1/u1l6/cards/c1</td><td>#/lesson/u1/u1l6</td></tr><tr class="p-high"><td>32</td><td>تفسير ما يتكرر</td><td>سورة الكافرون</td><td>interaction:complete-quran</td><td>أكمل الآية الأخيرة.<br>✔ وَلِيَ دِينِ<br>— وَلَنَا دِينُنَا<br>— وَلِيَ عَمَلِي<br>— وَأَنْتُمْ بَرِيئُونَ<br>التفسير: خاتمة السورة: ﴿لَكُمْ دِينُكُمْ وَلِيَ دِينِ﴾.</td><td>derived</td><td>12</td><td>إكمال مقطع من آية بالاختيار — الخيارات الثلاثة الأخرى صياغات تُشبه القرآن وليست منه، فيحتاج إقرارًا صريحًا لأسلوب السؤال قبل النشر، لا لنصّه فقط.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَتُسَنُّ قِرَاءَتُهَا فِي الرَّكْعَةِ الْأُولَى مِنَ السُّنَّةِ الْقَبْلِيَّةِ لِصَلَاةِ الْفَجْرِ.</td><td></td><td>u1/u1l6/interaction/i2</td><td>#/lesson/u1/u1l6</td></tr><tr class="p-high"><td>36</td><td>تفسير ما يتكرر</td><td>سورة الإخلاص</td><td>نصّ قرآني</td><td>قُلْ هُوَ اللَّهُ أَحَدٌ ﴿١﴾ اللَّهُ الصَّمَدُ ﴿٢﴾ لَمْ يَلِدْ وَلَمْ يُولَدْ ﴿٣﴾ وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ ﴿٤﴾</td><td>نصّ قرآني</td><td>13</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>سورة الإخلاص</td><td>u1/u1l7/cards/c1</td><td>#/lesson/u1/u1l7</td></tr><tr class="p-high"><td>40</td><td>تفسير ما يتكرر</td><td>سورة الفلق</td><td>نصّ قرآني</td><td>قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ ﴿١﴾ مِنْ شَرِّ مَا خَلَقَ ﴿٢﴾ وَمِنْ شَرِّ غَاسِقٍ إِذَا وَقَبَ ﴿٣﴾ وَمِنْ شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ ﴿٤﴾ وَمِنْ شَرِّ حَاسِدٍ إِذَا حَسَدَ ﴿٥﴾</td><td>نصّ قرآني</td><td>13</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>سورة الفلق</td><td>u1/u1l8/cards/c1</td><td>#/lesson/u1/u1l8</td></tr><tr class="p-high"><td>44</td><td>تفسير ما يتكرر</td><td>سورة الناس</td><td>نصّ قرآني</td><td>قُلْ أَعُوذُ بِرَبِّ النَّاسِ ﴿١﴾ مَلِكِ النَّاسِ ﴿٢﴾ إِلَٰهِ النَّاسِ ﴿٣﴾ مِنْ شَرِّ الْوَسْوَاسِ الْخَنَّاسِ ﴿٤﴾ الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ ﴿٥﴾ مِنَ الْجِنَّةِ وَالنَّاسِ ﴿٦﴾</td><td>نصّ قرآني</td><td>14</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>سورة الناس</td><td>u1/u1l9/cards/c1</td><td>#/lesson/u1/u1l9</td></tr><tr class="p-high"><td>201</td><td>الأخلاق</td><td>الصدق</td><td>نصّ قرآني</td><td>﴿يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَكُونُوا مَعَ الصَّادِقِينَ﴾</td><td>نصّ قرآني</td><td>59</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>التوبة: ١١٩</td><td>u6/u6l1/cards/c1</td><td>#/lesson/u6/u6l1</td></tr><tr class="p-high"><td>205</td><td>الأخلاق</td><td>الصبر</td><td>نصّ قرآني</td><td>﴿إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُمْ بِغَيْرِ حِسَابٍ﴾</td><td>نصّ قرآني</td><td>59</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>الزمر: ١٠</td><td>u6/u6l2/cards/c1</td><td>#/lesson/u6/u6l2</td></tr><tr class="p-high"><td>209</td><td>الأخلاق</td><td>الأمانة</td><td>نصّ قرآني</td><td>﴿إِنَّ اللَّهَ يَأْمُرُكُمْ أَنْ تُؤَدُّوا الْأَمَانَاتِ إِلَىٰ أَهْلِهَا﴾</td><td>نصّ قرآني</td><td>60</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>النساء: ٥٨</td><td>u6/u6l3/cards/c1</td><td>#/lesson/u6/u6l3</td></tr><tr class="p-high"><td>214</td><td>الأخلاق</td><td>العفاف</td><td>نصّ قرآني</td><td>﴿وَرَاوَدَتْهُ الَّتِي هُوَ فِي بَيْتِهَا عَنْ نَفْسِهِ وَغَلَّقَتِ الْأَبْوَابَ وَقَالَتْ هَيْتَ لَكَ ۚ قَالَ مَعَاذَ اللَّهِ ۖ إِنَّهُ رَبِّي أَحْسَنَ مَثْوَايَ ۖ إِنَّهُ لَا يُفْلِحُ الظَّالِمُونَ ﴿٢٣﴾</td><td>نصّ قرآني</td><td>60</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>يوسف: ٢٣</td><td>u6/u6l4/cards/c1</td><td>#/lesson/u6/u6l4</td></tr><tr class="p-high"><td>218</td><td>الأخلاق</td><td>الحياء</td><td>نصّ قرآني</td><td>﴿يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَدْخُلُوا بُيُوتَ النَّبِيِّ إِلَّا أَنْ يُؤْذَنَ لَكُمْ إِلَىٰ طَعَامٍ غَيْرَ نَاظِرِينَ إِنَاهُ وَلَٰكِنْ إِذَا دُعِيتُمْ فَادْخُلُوا فَإِذَا طَعِمْتُمْ فَانْتَشِرُوا وَلَا مُسْتَأْنِسِينَ لِحَدِيثٍ ۚ إِنَّ ذَٰلِكُمْ كَانَ يُؤْذِي النَّبِيَّ فَيَسْتَحْيِي مِنْكُمْ ۖ وَاللَّهُ لَا يَسْتَحْيِي مِنَ الْحَقِّ﴾</td><td>نصّ قرآني</td><td>61</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>الأحزاب: ٥٣</td><td>u6/u6l5/cards/c1</td><td>#/lesson/u6/u6l5</td></tr><tr class="p-high"><td>222</td><td>الأخلاق</td><td>الشجاعة</td><td>نصّ قرآني</td><td>﴿وَلَا تَهِنُوا وَلَا تَحْزَنُوا وَأَنْتُمُ الْأَعْلَوْنَ إِنْ كُنْتُمْ مُؤْمِنِينَ ﴿١٣٩﴾</td><td>نصّ قرآني</td><td>61</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>آل عمران: ١٣٩</td><td>u6/u6l6/cards/c1</td><td>#/lesson/u6/u6l6</td></tr><tr class="p-high"><td>228</td><td>الأخلاق</td><td>الكرم</td><td>نصّ قرآني</td><td>﴿إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ إِذَا ذُكِرَ اللَّهُ وَجِلَتْ قُلُوبُهُمْ وَإِذَا تُلِيَتْ عَلَيْهِمْ آيَاتُهُ زَادَتْهُمْ إِيمَانًا وَعَلَىٰ رَبِّهِمْ يَتَوَكَّلُونَ ﴿٢﴾ الَّذِينَ يُقِيمُونَ الصَّلَاةَ وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ ﴿٣﴾ أُولَٰئِكَ هُمُ الْمُؤْمِنُونَ حَقًّا ۚ لَهُمْ دَرَجَاتٌ عِنْدَ رَبِّهِمْ وَمَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ ﴿٤﴾</td><td>نصّ قرآني</td><td>62</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>الأنفال: ٢-٤</td><td>u6/u6l7/cards/c1</td><td>#/lesson/u6/u6l7</td></tr><tr class="p-high"><td>232</td><td>الأخلاق</td><td>الوفاء</td><td>نصّ قرآني</td><td>﴿وَأَوْفُوا بِالْعَهْدِ ۖ إِنَّ الْعَهْدَ كَانَ مَسْئُولًا ﴿٣٤﴾</td><td>نصّ قرآني</td><td>62</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>الإسراء: ٣٤</td><td>u6/u6l8/cards/c1</td><td>#/lesson/u6/u6l8</td></tr><tr class="p-high"><td>237</td><td>الأخلاق</td><td>حسن الجوار</td><td>نصّ قرآني</td><td>﴿وَاعْبُدُوا اللَّهَ وَلَا تُشْرِكُوا بِهِ شَيْئًا ۖ وَبِالْوَالِدَيْنِ إِحْسَانًا وَبِذِي الْقُرْبَىٰ وَالْيَتَامَىٰ وَالْمَسَاكِينِ وَالْجَارِ ذِي الْقُرْبَىٰ وَالْجَارِ الْجُنُبِ وَالصَّاحِبِ بِالْجَنْبِ وَابْنِ السَّبِيلِ وَمَا مَلَكَتْ أَيْمَانُكُمْ ۗ إِنَّ اللَّهَ لَا يُحِبُّ مَنْ كَانَ مُخْتَالًا فَخُورًا﴾</td><td>نصّ قرآني</td><td>63</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>النساء: ٣٦</td><td>u6/u6l9/cards/c1</td><td>#/lesson/u6/u6l9</td></tr><tr class="p-high"><td>241</td><td>الأخلاق</td><td>مساعدة ذي الحاجة</td><td>نصّ قرآني</td><td>﴿يَا أَيُّهَا الَّذِينَ آمَنُوا ارْكَعُوا وَاسْجُدُوا وَاعْبُدُوا رَبَّكُمْ وَافْعَلُوا الْخَيْرَ لَعَلَّكُمْ تُفْلِحُونَ ﴿٧٧﴾</td><td>نصّ قرآني</td><td>63</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>الحج: ٧٧</td><td>u6/u6l10/cards/c1</td><td>#/lesson/u6/u6l10</td></tr><tr class="p-high"><td>245</td><td>الرقائق</td><td>الخوف والرجاء</td><td>نصّ قرآني</td><td>﴿نَبِّئْ عِبَادِي أَنِّي أَنَا الْغَفُورُ الرَّحِيمُ ﴿٤٩﴾ وَأَنَّ عَذَابِي هُوَ الْعَذَابُ الْأَلِيمُ ﴿٥٠﴾</td><td>نصّ قرآني</td><td>67</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>الحجر: ٤٩-٥٠</td><td>u7/u7l1/cards/c1</td><td>#/lesson/u7/u7l1</td></tr><tr class="p-high"><td>250</td><td>الرقائق</td><td>الصحة والفراغ</td><td>نصّ قرآني</td><td>﴿وَإِنْ تَعُدُّوا نِعْمَتَ اللَّهِ لَا تُحْصُوهَا﴾</td><td>نصّ قرآني</td><td>67</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>إبراهيم: ٣٤</td><td>u7/u7l2/cards/c1</td><td>#/lesson/u7/u7l2</td></tr><tr class="p-high"><td>281</td><td>الرقائق</td><td>رحمة الله</td><td>نصّ قرآني</td><td>﴿وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ﴾</td><td>نصّ قرآني</td><td>69</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>الأعراف: ١٥٦</td><td>u7/u7l8/cards/c1</td><td>#/lesson/u7/u7l8</td></tr><tr class="p-high"><td>282</td><td>الرقائق</td><td>رحمة الله</td><td>نصّ قرآني</td><td>﴿قُلْ يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَىٰ أَنْفُسِهِمْ لَا تَقْنَطُوا مِنْ رَحْمَةِ اللَّهِ ۚ إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا ۚ إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ ﴿٥٣﴾</td><td>نصّ قرآني</td><td>69</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>الزمر: ٥٣</td><td>u7/u7l8/cards/c2</td><td>#/lesson/u7/u7l8</td></tr><tr class="p-high"><td>296</td><td>الرقائق</td><td>المجاهدة</td><td>نصّ قرآني</td><td>﴿وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا ۚ وَإِنَّ اللَّهَ لَمَعَ الْمُحْسِنِينَ ﴿٦٩﴾</td><td>نصّ قرآني</td><td>70</td><td>نصّ قرآني كُتب بالرسم المعتمد ولم يُستخرج من ملف الكتاب؛ يحتاج تدقيقًا حرفيًّا وتشكيليًّا وتحقّقًا من حدود المقطع.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td></td><td>العنكبوت: ٦٩</td><td>u7/u7l11/cards/c1</td><td>#/lesson/u7/u7l11</td></tr><tr class="p-high"><td>297</td><td>الرقائق</td><td>المجاهدة</td><td>interaction:complete-quran</td><td>أكمل الآية.<br>✔ لَنَهْدِيَنَّهُمْ سُبُلَنَا<br>— لَنُدْخِلَنَّهُمُ الْجَنَّةَ<br>— لَنَغْفِرَنَّ لَهُمْ<br>— لَنُثِيبَنَّهُمْ أَجْرًا<br>التفسير: ﴿وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا﴾ [العنكبوت: ٦٩].</td><td>derived</td><td>70</td><td>إكمال مقطع من آية بالاختيار — الخيارات الثلاثة الأخرى صياغات تُشبه القرآن وليست منه، فيحتاج إقرارًا صريحًا لأسلوب السؤال قبل النشر، لا لنصّه فقط.</td><td>عالية</td><td>بانتظار المراجعة</td><td></td><td></td><td>«حُجِبَتِ النَّارُ بِالشَّهَوَاتِ، وَحُجِبَتِ الْجَنَّةُ بِالْمَكَارِهِ»</td><td></td><td>u7/u7l11/interaction/i2</td><td>#/lesson/u7/u7l11</td></tr><tr class="p-med"><td>3</td><td>تفسير ما يتكرر</td><td>الاستعاذة</td><td>خلاصة الدرس</td><td>• لفظ الاستعاذة: أعوذ بالله من الشيطان الرجيم.<br>• ليست من القرآن، ويُستحبّ قولها قبل قراءة شيء من القرآن.<br>• معناها: ألتجئ إلى الله المعبود بحقٍّ وحده، من الشيطان المطرود من رحمة الله.</td><td>صياغة تعليمية مساعدة</td><td>7</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>أَعُوذُ بِاللهِ مِنَ الشَّيْطَانِ الرَّجِيمِ</td><td></td><td>u1/u1l1/summary</td><td>#/lesson/u1/u1l1</td></tr><tr class="p-med"><td>5</td><td>تفسير ما يتكرر</td><td>الاستعاذة</td><td>ملحوظة تعليمية</td><td>لاحظ الترتيب: التجاء (أعوذ) ← إلى مَن (بالله) ← ممن (من الشيطان الرجيم). هذا الترتيب نفسه يساعدك على تذكّر اللفظ كاملًا.</td><td>صياغة تعليمية مساعدة</td><td>7</td><td>ملحوظة تعليمية مستحدثة تُعرض ضمن محتوى الدرس؛ يحتاج تأكيد أنها لا تضيف حكمًا ولا تفسيرًا من خارج الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>أَعُوذُ بِاللهِ مِنَ الشَّيْطَانِ الرَّجِيمِ</td><td></td><td>u1/u1l1/cards/c4</td><td>#/lesson/u1/u1l1</td></tr><tr class="p-med"><td>8</td><td>تفسير ما يتكرر</td><td>البسملة</td><td>خلاصة الدرس</td><td>• البسملة آية للفصل بين السور، وليست آية من الفاتحة ولا من غيرها.<br>• ﴿بِسْمِ اللَّهِ﴾: أبتدئ قراءة القرآن مستعينًا بكل اسم لله.<br>• ﴿الرَّحْمَٰنِ﴾ سعة الرحمة، و﴿الرَّحِيمِ﴾ وصولها للعباد.</td><td>صياغة تعليمية مساعدة</td><td>7</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ آيَةٌ جَاءَتْ لِلْفَصْلِ بَيْنَ السُّوَرِ، فَلَيْسَتْ آيَةً مِنْ سُورَةِ الْفَاتِحَةِ وَلَا مِنْ غَيْرِهَا مِنَ السُّوَرِ.</td><td></td><td>u1/u1l2/summary</td><td>#/lesson/u1/u1l2</td></tr><tr class="p-med"><td>10</td><td>تفسير ما يتكرر</td><td>البسملة</td><td>ملحوظة تعليمية</td><td>فرقٌ لطيف يعينك على الحفظ: «الرحمن» سعة الرحمة، و«الرحيم» وصولها إلى العباد.</td><td>صياغة تعليمية مساعدة</td><td>8</td><td>ملحوظة تعليمية مستحدثة تُعرض ضمن محتوى الدرس؛ يحتاج تأكيد أنها لا تضيف حكمًا ولا تفسيرًا من خارج الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ آيَةٌ جَاءَتْ لِلْفَصْلِ بَيْنَ السُّوَرِ، فَلَيْسَتْ آيَةً مِنْ سُورَةِ الْفَاتِحَةِ وَلَا مِنْ غَيْرِهَا مِنَ السُّوَرِ.</td><td></td><td>u1/u1l2/cards/c4</td><td>#/lesson/u1/u1l2</td></tr><tr class="p-med"><td>13</td><td>تفسير ما يتكرر</td><td>سورة الفاتحة</td><td>خلاصة الدرس</td><td>• الفاتحة أعظم سورة في القرآن، ولا تصحّ الصلاة إلا بها.<br>• ﴿مَالِكِ يَوْمِ الدِّينِ﴾ يوم القيامة الذي يجازي الله فيه العباد.<br>• ﴿اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ﴾ أي دلّنا ووفّقنا وثبّتنا عليه، وهو الإسلام.<br>• (آمين) معناها: اللهم استجب، وليست من القرآن.</td><td>صياغة تعليمية مساعدة</td><td>8</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَجِبُ عَلَى الْمُسْلِمِ أَنْ يَتَعَلَّمَ قِرَاءَةَ سُورَةِ الْفَاتِحَةِ؛ لِأَنَّ الصَّلَاةَ لَا تَصِحُّ إِلَّا بِهَا، وَيَحْسُنُ أَنْ يَتَعَلَّمَ قِرَاءَةَ كِتَابِ اللهِ كَامِلًا، فَإِنْ لَمْ يَكُنْ فَمَا اسْتَطَاعَ مِنْهُ.</td><td></td><td>u1/u1l3/summary</td><td>#/lesson/u1/u1l3</td></tr><tr class="p-med"><td>16</td><td>تفسير ما يتكرر</td><td>سورة الفاتحة</td><td>ملحوظة تعليمية</td><td>الفرق بين المغضوب عليهم والضالين كما في الكتاب: الأول عَلِم فترك، والثاني عَمِل بلا عِلم. فاحرص على العلم والعمل معًا.</td><td>صياغة تعليمية مساعدة</td><td>9</td><td>ملحوظة تعليمية مستحدثة تُعرض ضمن محتوى الدرس؛ يحتاج تأكيد أنها لا تضيف حكمًا ولا تفسيرًا من خارج الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَجِبُ عَلَى الْمُسْلِمِ أَنْ يَتَعَلَّمَ قِرَاءَةَ سُورَةِ الْفَاتِحَةِ؛ لِأَنَّ الصَّلَاةَ لَا تَصِحُّ إِلَّا بِهَا، وَيَحْسُنُ أَنْ يَتَعَلَّمَ قِرَاءَةَ كِتَابِ اللهِ كَامِلًا، فَإِنْ لَمْ يَكُنْ فَمَا اسْتَطَاعَ مِنْهُ.</td><td></td><td>u1/u1l3/cards/c5</td><td>#/lesson/u1/u1l3</td></tr><tr class="p-med"><td>20</td><td>تفسير ما يتكرر</td><td>آية الكرسي</td><td>خلاصة الدرس</td><td>• آية الكرسي أعظم آية في القرآن.<br>• ﴿الْحَيُّ﴾ حياة كاملة لا نقص فيها، و﴿الْقَيُّومُ﴾ القائم بنفسه وبه قامت المخلوقات.<br>• ﴿سِنَةٌ﴾ نعاس، و﴿لَا يَئُودُهُ﴾ لا يُثقله ولا يشقّ عليه.</td><td>صياغة تعليمية مساعدة</td><td>10</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ أَعْظَمُ آيَةٍ فِي الْقُرْآنِ.</td><td></td><td>u1/u1l4/summary</td><td>#/lesson/u1/u1l4</td></tr><tr class="p-med"><td>25</td><td>تفسير ما يتكرر</td><td>آخر آيتين من سورة البقرة</td><td>خلاصة الدرس</td><td>• الآيتان تجمعان الإيمان بالله وملائكته وكتبه ورسله، ثم الدعاء.<br>• ﴿لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا﴾: لا يطلب الله من عباده ما لا يطيقونه.<br>• ﴿لَهَا مَا كَسَبَتْ وَعَلَيْهَا مَا اكْتَسَبَتْ﴾: من فعل خيرًا نال خيرًا، ومن فعل شرًّا نال شرًّا.</td><td>صياغة تعليمية مساعدة</td><td>11</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>﴿لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِنْ رُسُلِهِ﴾: أَيْ: لَا نُفَرِّقُ فِي الْإِيمَانِ بَيْنَ الرُّسُلِ فَنُؤْمِنُ بِبَعْضِهِمْ وَنُنْكِرُ بَعْضَهُمْ، بَلْ نُؤْمِنُ بِهِمْ جَمِيعًا. | ﴿وَقَالُوا﴾: أَيِ: الرَّسُولُ وَالْمُؤْمِنُونَ. | ﴿غُفْرَانَكَ رَبَّنَا﴾: أَيْ: نَسْأَلُكَ مَغْفِرَتَكَ. | ﴿وَإِلَيْكَ الْمَصِيرُ﴾: أَيِ: الْمَرْجِعُ. | ﴿لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا﴾: أَيْ: لَا يَطْلُبُ اللهُ مِنْ عِبَادِهِ مَا لَا يُطِيقُونَهُ. | ﴿لَهَا مَا كَسَبَتْ وَعَلَيْهَا مَا اكْتَسَبَتْ﴾: فَمَنْ فَعَلَ خَيْرًا نَالَ خَيْرًا، وَمَنْ فَعَلَ شَرًّا نَالَ شَرًّا. | ﴿رَبَّنَا وَلَا تَحْمِلْ عَلَيْ</td><td></td><td>u1/u1l5/summary</td><td>#/lesson/u1/u1l5</td></tr><tr class="p-med"><td>30</td><td>تفسير ما يتكرر</td><td>سورة الكافرون</td><td>خلاصة الدرس</td><td>• سورة الكافرون تُقرأ في الركعة الأولى من سنة الفجر القبلية.<br>• ﴿مَا تَعْبُدُونَ﴾ من الأصنام والآلهة الباطلة، و﴿مَا أَعْبُدُ﴾ هو الله وحده.<br>• ﴿وَلِيَ دِينِ﴾ الذي لا أبغي غيره.</td><td>صياغة تعليمية مساعدة</td><td>12</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَتُسَنُّ قِرَاءَتُهَا فِي الرَّكْعَةِ الْأُولَى مِنَ السُّنَّةِ الْقَبْلِيَّةِ لِصَلَاةِ الْفَجْرِ.</td><td></td><td>u1/u1l6/summary</td><td>#/lesson/u1/u1l6</td></tr><tr class="p-med"><td>35</td><td>تفسير ما يتكرر</td><td>سورة الإخلاص</td><td>خلاصة الدرس</td><td>• الإخلاص تُقرأ في الركعة الثانية من سنة الفجر القبلية.<br>• ﴿أَحَدٌ﴾ المتفرّد بالألوهية والربوبية والأسماء والصفات.<br>• ﴿الصَّمَدُ﴾ الكامل في صفات الشرف والمجد، الذي يقصده الخلائق في حوائجهم.</td><td>صياغة تعليمية مساعدة</td><td>13</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَتُسَنُّ قِرَاءَتُهَا فِي الرَّكْعَةِ الثَّانِيَةِ مِنَ السُّنَّةِ الْقَبْلِيَّةِ لِصَلَاةِ الْفَجْرِ.</td><td></td><td>u1/u1l7/summary</td><td>#/lesson/u1/u1l7</td></tr><tr class="p-med"><td>39</td><td>تفسير ما يتكرر</td><td>سورة الفلق</td><td>خلاصة الدرس</td><td>• ﴿الْفَلَقِ﴾ هو الصبح.<br>• ﴿غَاسِقٍ إِذَا وَقَبَ﴾ الليل شديد الظلمة إذا دخل وتغلغل.<br>• الحسد: كراهية وصول النعمة للغير.</td><td>صياغة تعليمية مساعدة</td><td>13</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>﴿قُلْ﴾: أَيُّهَا الرَّسُولُ. | ﴿بِرَبِّ الْفَلَقِ﴾: وَهُوَ: الصُّبْحُ. | ﴿مِنْ شَرِّ مَا خَلَقَ﴾: أَيْ: جَمِيعِ الْمَخْلُوقَاتِ. | ﴿غَاسِقٍ﴾: أَيِ: اللَّيْلِ شَدِيدِ الظُّلْمَةِ. | ﴿إِذَا وَقَبَ﴾: إِذَا دَخَلَ وَتَغَلْغَلَ، وَمَا فِيهِ مِنَ الشُّرُورِ وَالْمُؤْذِيَاتِ. | ﴿النَّفَّاثَاتِ فِي الْعُقَدِ﴾: أَيِ: السَّاحِرَاتِ اللَّاتِي يَنْفُخْنَ فِيمَا يَعْقِدْنَ مِنْ عُقَدٍ بِقَصْدِ السِّحْرِ. | ﴿وَمِنْ شَرِّ حَاسِدٍ إِذَا حَسَدَ﴾: وَالْحَسَدُ: كَرَاهِيَةُ وُصُولِ النِّعْمَةِ لِلْغَيْرِ.</td><td></td><td>u1/u1l8/summary</td><td>#/lesson/u1/u1l8</td></tr><tr class="p-med"><td>43</td><td>تفسير ما يتكرر</td><td>سورة الناس</td><td>خلاصة الدرس</td><td>• الوسواس الخنّاس: الشيطان الذي يوسوس عند الغفلة ويختفي عند ذكر الله.<br>• الشياطين من الجن ومن الإنس.<br>• السورة استعاذة بالرب المَلِك الإله من هذا الشرّ.</td><td>صياغة تعليمية مساعدة</td><td>14</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>﴿قُلْ﴾: أَيُّهَا الرَّسُولُ. | ﴿الْوَسْوَاسِ الْخَنَّاسِ﴾: أَيِ: الشَّيْطَانِ الَّذِي يُوَسْوِسُ عِنْدَ الْغَفْلَةِ، وَيَخْتَفِي عِنْدَ ذِكْرِ اللهِ. | ﴿مِنَ الْجِنَّةِ وَالنَّاسِ﴾: فَمِنَ الْجِنِّ شَيَاطِينُ، وَمِنَ الْإِنْسِ شَيَاطِينُ.</td><td></td><td>u1/u1l9/summary</td><td>#/lesson/u1/u1l9</td></tr><tr class="p-med"><td>45</td><td>تفسير ما يتكرر</td><td>سورة الناس</td><td>ملحوظة تعليمية</td><td>وصف الخنّاس يعطيك الدواء: الوسوسة تأتي عند الغفلة، وتنقطع عند الذكر. فمتى وجدت الوسوسة فاذكر الله.</td><td>صياغة تعليمية مساعدة</td><td>14</td><td>ملحوظة تعليمية مستحدثة تُعرض ضمن محتوى الدرس؛ يحتاج تأكيد أنها لا تضيف حكمًا ولا تفسيرًا من خارج الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>﴿قُلْ﴾: أَيُّهَا الرَّسُولُ. | ﴿الْوَسْوَاسِ الْخَنَّاسِ﴾: أَيِ: الشَّيْطَانِ الَّذِي يُوَسْوِسُ عِنْدَ الْغَفْلَةِ، وَيَخْتَفِي عِنْدَ ذِكْرِ اللهِ. | ﴿مِنَ الْجِنَّةِ وَالنَّاسِ﴾: فَمِنَ الْجِنِّ شَيَاطِينُ، وَمِنَ الْإِنْسِ شَيَاطِينُ.</td><td></td><td>u1/u1l9/cards/c3</td><td>#/lesson/u1/u1l9</td></tr><tr class="p-med"><td>46</td><td>تفسير ما يتكرر</td><td>سورة الناس</td><td>موقف تطبيقي (داخل الدرس)</td><td>شعرت بوساوس كثيرة عند نومك. ما أقرب تصرّف يوافق ما ذكره الكتاب في وصف الخنّاس؟<br>✔ أشغل نفسي بذكر الله فإنه يختفي عند ذكر الله<br>— أحاول ألا أفكر بشيء إطلاقًا<br>— أفتح الجوال حتى أنام<br>— أستيقظ وأترك النوم<br>التفسير: الكتاب وصفه بأنه «يُوَسْوِسُ عِنْدَ الْغَفْلَةِ، وَيَخْتَفِي عِنْدَ ذِكْرِ اللهِ».</td><td>صياغة تعليمية مساعدة</td><td>14</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>﴿قُلْ﴾: أَيُّهَا الرَّسُولُ. | ﴿الْوَسْوَاسِ الْخَنَّاسِ﴾: أَيِ: الشَّيْطَانِ الَّذِي يُوَسْوِسُ عِنْدَ الْغَفْلَةِ، وَيَخْتَفِي عِنْدَ ذِكْرِ اللهِ. | ﴿مِنَ الْجِنَّةِ وَالنَّاسِ﴾: فَمِنَ الْجِنِّ شَيَاطِينُ، وَمِنَ الْإِنْسِ شَيَاطِينُ.</td><td></td><td>u1/u1l9/interaction/i1</td><td>#/lesson/u1/u1l9</td></tr><tr class="p-med"><td>49</td><td>الأحاديث النبوية</td><td>أصول الإسلام على ثلاثة أحاديث</td><td>خلاصة الدرس</td><td>• نقل الكتاب عن الإمام أحمد أن أصول الإسلام على ثلاثة أحاديث، ثم ساقها.</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>قَالَ الْإِمَامُ أَحْمَدُ: (أُصُولُ الْإِسْلَامِ عَلَى ثَلَاثَةِ أَحَادِيثَ...) ثُمَّ ذَكَرَهَا، وَهِيَ:</td><td></td><td>u2/u2l0/summary</td><td>#/lesson/u2/u2l0</td></tr><tr class="p-med"><td>50</td><td>الأحاديث النبوية</td><td>أصول الإسلام على ثلاثة أحاديث</td><td>ملحوظة تعليمية</td><td>ستدرس في هذه الوحدة الأحاديث الثلاثة، ثم ما يدلّ عليه كل حديث كما بيّنه الكتاب.</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>ملحوظة تعليمية مستحدثة تُعرض ضمن محتوى الدرس؛ يحتاج تأكيد أنها لا تضيف حكمًا ولا تفسيرًا من خارج الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>قَالَ الْإِمَامُ أَحْمَدُ: (أُصُولُ الْإِسْلَامِ عَلَى ثَلَاثَةِ أَحَادِيثَ...) ثُمَّ ذَكَرَهَا، وَهِيَ:</td><td></td><td>u2/u2l0/cards/c2</td><td>#/lesson/u2/u2l0</td></tr><tr class="p-med"><td>51</td><td>الأحاديث النبوية</td><td>أصول الإسلام على ثلاثة أحاديث</td><td>interaction:complete</td><td>أكمل كلمة الإمام أحمد كما نقلها الكتاب.<br>✔ ثَلَاثَةِ<br>— أَرْبَعَةِ<br>— خَمْسَةِ<br>— سَبْعَةِ<br>التفسير: نصّ الكتاب: «أُصُولُ الْإِسْلَامِ عَلَى ثَلَاثَةِ أَحَادِيثَ».</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>إكمال نصّ بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد مطابقة النصّ للكتاب وسلامة الخيارات.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>قَالَ الْإِمَامُ أَحْمَدُ: (أُصُولُ الْإِسْلَامِ عَلَى ثَلَاثَةِ أَحَادِيثَ...) ثُمَّ ذَكَرَهَا، وَهِيَ:</td><td></td><td>u2/u2l0/interaction/x1</td><td>#/lesson/u2/u2l0</td></tr><tr class="p-med"><td>52</td><td>الأحاديث النبوية</td><td>أصول الإسلام على ثلاثة أحاديث</td><td>interaction:mcq</td><td>ماذا صنع الكتاب بعد نقل كلمة الإمام أحمد؟<br>✔ ذكر الأحاديث الثلاثة<br>— اكتفى بذكر الكلمة<br>— أحال إلى كتاب آخر<br>— ذكر حديثًا واحدًا منها<br>التفسير: نصّ الكتاب: «ثُمَّ ذَكَرَهَا، وَهِيَ:» ثم ساق الأحاديث الثلاثة.</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>سؤال اختيار بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد أنه لا يضيف حكمًا ولا معلومة من خارج الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>قَالَ الْإِمَامُ أَحْمَدُ: (أُصُولُ الْإِسْلَامِ عَلَى ثَلَاثَةِ أَحَادِيثَ...) ثُمَّ ذَكَرَهَا، وَهِيَ:</td><td></td><td>u2/u2l0/interaction/x2</td><td>#/lesson/u2/u2l0</td></tr><tr class="p-med"><td>55</td><td>الأحاديث النبوية</td><td>الحديث الأول: الأعمال بالنية</td><td>خلاصة الدرس</td><td>• الأعمال بالنية، ولكل امرئ ما نوى.<br>• لا يكون العمل عبادةً إلا بنية التعبّد.<br>• ليس لك من الأجر إلا بقدر ما نويت.</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«الْأَعْمَالُ بِالنِّيَّةِ، وَلِكُلِّ امْرِئٍ مَا نَوَى، فَمَنْ كَانَتْ هِجْرَتُهُ إِلَى اللهِ وَرَسُولِهِ فَهِجْرَتُهُ إِلَى اللهِ وَرَسُولِهِ، وَمَنْ كَانَتْ هِجْرَتُهُ لِدُنْيَا يُصِيبُهَا، أَوِ امْرَأَةٍ يَتَزَوَّجُهَا، فَهِجْرَتُهُ إِلَى مَا هَاجَرَ إِلَيْهِ».</td><td></td><td>u2/u2l1/summary</td><td>#/lesson/u2/u2l1</td></tr><tr class="p-med"><td>57</td><td>الأحاديث النبوية</td><td>الحديث الأول: الأعمال بالنية</td><td>ملحوظة تعليمية</td><td>الحديث يجعل ميزانك الداخلي هو الفيصل: السؤال ليس «ماذا فعلت؟» بل «لماذا فعلت؟».</td><td>صياغة تعليمية مساعدة</td><td>19</td><td>ملحوظة تعليمية مستحدثة تُعرض ضمن محتوى الدرس؛ يحتاج تأكيد أنها لا تضيف حكمًا ولا تفسيرًا من خارج الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«الْأَعْمَالُ بِالنِّيَّةِ، وَلِكُلِّ امْرِئٍ مَا نَوَى، فَمَنْ كَانَتْ هِجْرَتُهُ إِلَى اللهِ وَرَسُولِهِ فَهِجْرَتُهُ إِلَى اللهِ وَرَسُولِهِ، وَمَنْ كَانَتْ هِجْرَتُهُ لِدُنْيَا يُصِيبُهَا، أَوِ امْرَأَةٍ يَتَزَوَّجُهَا، فَهِجْرَتُهُ إِلَى مَا هَاجَرَ إِلَيْهِ».</td><td></td><td>u2/u2l1/cards/c3</td><td>#/lesson/u2/u2l1</td></tr><tr class="p-med"><td>58</td><td>الأحاديث النبوية</td><td>الحديث الأول: الأعمال بالنية</td><td>موقف تطبيقي (داخل الدرس)</td><td>رجلان تصدّقا بالمبلغ نفسه؛ أحدهما أراد وجه الله، والآخر أراد ثناء الناس. ما الذي يقرّره الحديث الأول؟<br>✔ لكلٍّ ما نوى؛ فلا أجر إلا بقدر ما نوى<br>— الأجر واحد لأن العمل واحد<br>— لا أجر لواحد منهما<br>— الأجر للثاني لأن نفعه أظهر<br>التفسير: الكتاب: «وَأَنْ لَيْسَ لَكَ مِنَ الْأَجْرِ إِلَّا بِقَدْرِ مَا نَوَيْتَ».</td><td>صياغة تعليمية مساعدة</td><td>19</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«الْأَعْمَالُ بِالنِّيَّةِ، وَلِكُلِّ امْرِئٍ مَا نَوَى، فَمَنْ كَانَتْ هِجْرَتُهُ إِلَى اللهِ وَرَسُولِهِ فَهِجْرَتُهُ إِلَى اللهِ وَرَسُولِهِ، وَمَنْ كَانَتْ هِجْرَتُهُ لِدُنْيَا يُصِيبُهَا، أَوِ امْرَأَةٍ يَتَزَوَّجُهَا، فَهِجْرَتُهُ إِلَى مَا هَاجَرَ إِلَيْهِ».</td><td></td><td>u2/u2l1/interaction/i2</td><td>#/lesson/u2/u2l1</td></tr><tr class="p-med"><td>61</td><td>الأحاديث النبوية</td><td>الحديث الثاني: من أحدث في أمرنا</td><td>خلاصة الدرس</td><td>• «مَنْ أَحْدَثَ فِي أَمْرِنَا هَذَا مَا لَيْسَ فِيهِ، فَهُوَ رَدٌّ».<br>• البدعة: ما أُحدث في الدين مما ليس منه، بقصد التعبّد.<br>• البدع مردودة على صاحبها، وهو آثم بها.</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«مَنْ أَحْدَثَ فِي أَمْرِنَا هَذَا مَا لَيْسَ فِيهِ، فَهُوَ رَدٌّ».</td><td></td><td>u2/u2l2/summary</td><td>#/lesson/u2/u2l2</td></tr><tr class="p-med"><td>64</td><td>الأحاديث النبوية</td><td>الحديث الثالث: الحلال بيّن والحرام بيّن</td><td>خلاصة الدرس</td><td>• الحلال بيّن والحرام بيّن وبينهما مشتبهات.<br>• من اتقى الشبهات استبرأ لدينه وعِرضه، ومن وقع فيها وقع في الحرام.<br>• في الجسد مضغة إذا صلحت صلح الجسد كله، ألا وهي القلب.</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الْحَلَالَ بَيِّنٌ، وَإِنَّ الْحَرَامَ بَيِّنٌ، وَبَيْنَهُمَا مُشْتَبِهَاتٌ لَا يَعْلَمُهُنَّ كَثِيرٌ مِنَ النَّاسِ، فَمَنِ اتَّقَى الشُّبُهَاتِ اسْتَبْرَأَ لِدِينِهِ، وَعِرْضِهِ، وَمَنْ وَقَعَ فِي الشُّبُهَاتِ وَقَعَ فِي الْحَرَامِ، كَالرَّاعِي يَرْعَى حَوْلَ الْحِمَى، يُوشِكُ أَنْ يَرْتَعَ فِيهِ، أَلَا وَإِنَّ لِكُلِّ مَلِكٍ حِمًى، أَلَا وَإِنَّ حِمَى اللهِ مَحَارِمُهُ، أَلَا وَإِنَّ فِي الْجَسَدِ مُضْغَةً، إِذَا صَلَحَتْ، صَلَحَ الْجَسَدُ كُلُّهُ، وَإِذَا فَسَدَتْ، فَسَدَ الْجَسَدُ كُلُّهُ، أَلَا وَهِيَ الْقَلْبُ».</td><td></td><td>u2/u2l3/summary</td><td>#/lesson/u2/u2l3</td></tr><tr class="p-med"><td>65</td><td>الأحاديث النبوية</td><td>الحديث الثالث: الحلال بيّن والحرام بيّن</td><td>ملحوظة تعليمية</td><td>مَثَل الراعي حول الحِمى يوضّح القاعدة: القرب من الحدّ طريقٌ إلى تجاوزه، فالبُعد عن المشتبه حفظٌ للدين والعِرض.</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>ملحوظة تعليمية مستحدثة تُعرض ضمن محتوى الدرس؛ يحتاج تأكيد أنها لا تضيف حكمًا ولا تفسيرًا من خارج الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الْحَلَالَ بَيِّنٌ، وَإِنَّ الْحَرَامَ بَيِّنٌ، وَبَيْنَهُمَا مُشْتَبِهَاتٌ لَا يَعْلَمُهُنَّ كَثِيرٌ مِنَ النَّاسِ، فَمَنِ اتَّقَى الشُّبُهَاتِ اسْتَبْرَأَ لِدِينِهِ، وَعِرْضِهِ، وَمَنْ وَقَعَ فِي الشُّبُهَاتِ وَقَعَ فِي الْحَرَامِ، كَالرَّاعِي يَرْعَى حَوْلَ الْحِمَى، يُوشِكُ أَنْ يَرْتَعَ فِيهِ، أَلَا وَإِنَّ لِكُلِّ مَلِكٍ حِمًى، أَلَا وَإِنَّ حِمَى اللهِ مَحَارِمُهُ، أَلَا وَإِنَّ فِي الْجَسَدِ مُضْغَةً، إِذَا صَلَحَتْ، صَلَحَ الْجَسَدُ كُلُّهُ، وَإِذَا فَسَدَتْ، فَسَدَ الْجَسَدُ كُلُّهُ، أَلَا وَهِيَ الْقَلْبُ».</td><td></td><td>u2/u2l3/cards/c3</td><td>#/lesson/u2/u2l3</td></tr><tr class="p-med"><td>66</td><td>الأحاديث النبوية</td><td>الحديث الثالث: الحلال بيّن والحرام بيّن</td><td>موقف تطبيقي (داخل الدرس)</td><td>عُرض عليك دخلٌ لم يتبيّن لك حلّه من حرمته. ما الذي يرشدك إليه الحديث الثالث؟<br>✔ أتجنّبه لأنه من المشتبهات<br>— آخذه حتى يتبيّن تحريمه<br>— أسأل مَن يوافق رغبتي<br>— أقسمه نصفين<br>التفسير: الكتاب: «فَإِنَّهُ مِنَ الْمُشْتَبِهَاتِ الَّتِي يَنْبَغِي تَجَنُّبُهَا».</td><td>صياغة تعليمية مساعدة</td><td>19</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الْحَلَالَ بَيِّنٌ، وَإِنَّ الْحَرَامَ بَيِّنٌ، وَبَيْنَهُمَا مُشْتَبِهَاتٌ لَا يَعْلَمُهُنَّ كَثِيرٌ مِنَ النَّاسِ، فَمَنِ اتَّقَى الشُّبُهَاتِ اسْتَبْرَأَ لِدِينِهِ، وَعِرْضِهِ، وَمَنْ وَقَعَ فِي الشُّبُهَاتِ وَقَعَ فِي الْحَرَامِ، كَالرَّاعِي يَرْعَى حَوْلَ الْحِمَى، يُوشِكُ أَنْ يَرْتَعَ فِيهِ، أَلَا وَإِنَّ لِكُلِّ مَلِكٍ حِمًى، أَلَا وَإِنَّ حِمَى اللهِ مَحَارِمُهُ، أَلَا وَإِنَّ فِي الْجَسَدِ مُضْغَةً، إِذَا صَلَحَتْ، صَلَحَ الْجَسَدُ كُلُّهُ، وَإِذَا فَسَدَتْ، فَسَدَ الْجَسَدُ كُلُّهُ، أَلَا وَهِيَ الْقَلْبُ».</td><td></td><td>u2/u2l3/interaction/i2</td><td>#/lesson/u2/u2l3</td></tr><tr class="p-med"><td>69</td><td>مراتب الدين</td><td>مراتب الدين الثلاث</td><td>خلاصة الدرس</td><td>• مراتب الدين ثلاث: الإسلام، والإيمان، والإحسان، ولكل مرتبة أركان.</td><td>صياغة تعليمية مساعدة</td><td>23</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>مَرَاتِبُ الدِّينِ ثَلَاثٌ: الْإِسْلَامُ وَالْإِيمَانُ وَالْإِحْسَانُ، وَكُلُّ مَرْتَبَةٍ لَهَا أَرْكَانٌ.</td><td></td><td>u3/u3l0/summary</td><td>#/lesson/u3/u3l0</td></tr><tr class="p-med"><td>70</td><td>مراتب الدين</td><td>مراتب الدين الثلاث</td><td>ملحوظة تعليمية</td><td>خريطة الوحدة: أركان الإسلام (خمسة) ← أركان الإيمان (ستة) ← الإحسان (ركن واحد).</td><td>صياغة تعليمية مساعدة</td><td>23</td><td>ملحوظة تعليمية مستحدثة تُعرض ضمن محتوى الدرس؛ يحتاج تأكيد أنها لا تضيف حكمًا ولا تفسيرًا من خارج الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>مَرَاتِبُ الدِّينِ ثَلَاثٌ: الْإِسْلَامُ وَالْإِيمَانُ وَالْإِحْسَانُ، وَكُلُّ مَرْتَبَةٍ لَهَا أَرْكَانٌ.</td><td></td><td>u3/u3l0/cards/c2</td><td>#/lesson/u3/u3l0</td></tr><tr class="p-med"><td>71</td><td>مراتب الدين</td><td>مراتب الدين الثلاث</td><td>interaction:match</td><td>طابِق بين كل مرتبة وعدد أركانها كما في هذا الفصل.<br>التفسير: الكتاب في هذا الفصل: أركان الإسلام «وَهِيَ خَمْسَةٌ» (ص٢٣)، وأركان الإيمان «وَهِيَ سِتَّةٌ» (ص٢٤)، والإحسان «رُكْنٌ وَاحِدٌ» (ص٢٦).</td><td>صياغة تعليمية مساعدة</td><td>23</td><td>مطابقة بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد صحّة الأزواج ومطابقتها لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>مَرَاتِبُ الدِّينِ ثَلَاثٌ: الْإِسْلَامُ وَالْإِيمَانُ وَالْإِحْسَانُ، وَكُلُّ مَرْتَبَةٍ لَهَا أَرْكَانٌ.</td><td></td><td>u3/u3l0/interaction/x1</td><td>#/lesson/u3/u3l0</td></tr><tr class="p-med"><td>72</td><td>مراتب الدين</td><td>مراتب الدين الثلاث</td><td>interaction:complete</td><td>أكمل نصّ الكتاب.<br>✔ ثَلَاثٌ<br>— اثْنَتَانِ<br>— أَرْبَعٌ<br>— خَمْسٌ<br>التفسير: نصّ الكتاب: «مَرَاتِبُ الدِّينِ ثَلَاثٌ».</td><td>صياغة تعليمية مساعدة</td><td>23</td><td>إكمال نصّ بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد مطابقة النصّ للكتاب وسلامة الخيارات.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>مَرَاتِبُ الدِّينِ ثَلَاثٌ: الْإِسْلَامُ وَالْإِيمَانُ وَالْإِحْسَانُ، وَكُلُّ مَرْتَبَةٍ لَهَا أَرْكَانٌ.</td><td></td><td>u3/u3l0/interaction/x2</td><td>#/lesson/u3/u3l0</td></tr><tr class="p-med"><td>75</td><td>مراتب الدين</td><td>أركان الإسلام</td><td>خلاصة الدرس</td><td>• أركان الإسلام خمسة، أولها وأعظمها الشهادتان.<br>• معنى لا إله إلا الله: لا معبود بحقٍّ إلا الله.<br>• شهادة أن محمدًا رسول الله: تصديقه فيما أخبر، وطاعته فيما أمر، واجتناب ما نهى عنه وزجر، وألا يُعبد الله إلا بما شرع.<br>• العبادة اسم جامع لما يحبه الله ويرضاه من الأقوال والأعمال الظاهرة والباطنة.</td><td>صياغة تعليمية مساعدة</td><td>23</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ خَمْسَةٌ: أَوَّلُهَا وَأَعْظَمُهَا: شَهَادَةُ أَلَّا إِلَهَ إِلَّا اللهُ، وَأَنَّ مُحَمَّدًا رَسُولُ اللهِ.</td><td></td><td>u3/u3l1/summary</td><td>#/lesson/u3/u3l1</td></tr><tr class="p-med"><td>79</td><td>مراتب الدين</td><td>أركان الإيمان والقدر الواجب فيها</td><td>خلاصة الدرس</td><td>• أركان الإيمان ستة.<br>• مسائل الإيمان نوعان: قدرٌ واجب مجزئ على كل مسلم، وقدرٌ مستحبّ زائد عليه.<br>• الإيمان بالكتب يشمل أنّ كلها منسوخة بالقرآن.<br>• الإيمان بالقدر: علمه أزلًا ثم كتبه، ولا يكون شيء إلا بمشيئته وخلقه.</td><td>صياغة تعليمية مساعدة</td><td>24</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ سِتَّةٌ: (الْإِيمَانُ بِاللهِ، وَمَلَائِكَتِهِ، وَكُتُبِهِ، وَرُسُلِهِ، وَالْيَوْمِ الْآخِرِ، وَالْقَدَرِ خَيْرِهِ وَشَرِّهِ).</td><td></td><td>u3/u3l2/summary</td><td>#/lesson/u3/u3l2</td></tr><tr class="p-med"><td>82</td><td>مراتب الدين</td><td>الإحسان</td><td>خلاصة الدرس</td><td>• الإحسان ركن واحد: أن تعبد الله كأنك تراه، فإن لم تكن تراه فإنه يراك.</td><td>صياغة تعليمية مساعدة</td><td>26</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>رُكْنٌ وَاحِدٌ: أَنْ تَعْبُدَ اللهَ كَأَنَّكَ تَرَاهُ، فَإِنْ لَمْ تَكُنْ تَرَاهُ فَإِنَّهُ يَرَاكَ.</td><td></td><td>u3/u3l3/summary</td><td>#/lesson/u3/u3l3</td></tr><tr class="p-med"><td>83</td><td>مراتب الدين</td><td>الإحسان</td><td>ملحوظة تعليمية</td><td>الإحسان مرتبة مراقبة: لا يتغيّر عملك سواءً رآك الناس أم لا، لأنّ الله يراك في الحالين.</td><td>صياغة تعليمية مساعدة</td><td>26</td><td>ملحوظة تعليمية مستحدثة تُعرض ضمن محتوى الدرس؛ يحتاج تأكيد أنها لا تضيف حكمًا ولا تفسيرًا من خارج الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>رُكْنٌ وَاحِدٌ: أَنْ تَعْبُدَ اللهَ كَأَنَّكَ تَرَاهُ، فَإِنْ لَمْ تَكُنْ تَرَاهُ فَإِنَّهُ يَرَاكَ.</td><td></td><td>u3/u3l3/cards/c2</td><td>#/lesson/u3/u3l3</td></tr><tr class="p-med"><td>84</td><td>مراتب الدين</td><td>الإحسان</td><td>موقف تطبيقي (داخل الدرس)</td><td>أنت وحدك في عملك ولا رقيب عليك. أيّ تصرّف يوافق مرتبة الإحسان؟<br>✔ أُتقن عملي لأنّ الله يراني<br>— أُقلّل العمل ما دام لا أحد يراقب<br>— أعمل بحسب مزاجي<br>— أنتظر حتى يأتي المدير<br>التفسير: لأنّ الإحسان: أن تعبد الله كأنك تراه، فإن لم تكن تراه فإنه يراك.</td><td>صياغة تعليمية مساعدة</td><td>26</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>رُكْنٌ وَاحِدٌ: أَنْ تَعْبُدَ اللهَ كَأَنَّكَ تَرَاهُ، فَإِنْ لَمْ تَكُنْ تَرَاهُ فَإِنَّهُ يَرَاكَ.</td><td></td><td>u3/u3l3/interaction/i2</td><td>#/lesson/u3/u3l3</td></tr><tr class="p-med"><td>87</td><td>الفقه</td><td>شروط الوضوء</td><td>خلاصة الدرس</td><td>• شروط الوضوء تسعة.<br>• منها: الإسلام والعقل والتمييز والنية واستصحاب حكمها.<br>• ومنها: طهورية الماء وإباحته، وإزالة ما يمنع وصوله إلى البشرة.</td><td>صياغة تعليمية مساعدة</td><td>30</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ تِسْعَةٌ:</td><td></td><td>u4/u4l1/summary</td><td>#/lesson/u4/u4l1</td></tr><tr class="p-med"><td>88</td><td>الفقه</td><td>شروط الوضوء</td><td>ملحوظة تعليمية</td><td>لاحظ أنّ الشروط تجمع بين شروطٍ في الشخص (الإسلام، العقل، التمييز، النية) وشروطٍ في الماء والبدن (طهورية الماء وإباحته، وإزالة الحائل).</td><td>صياغة تعليمية مساعدة</td><td>30</td><td>ملحوظة تعليمية مستحدثة تُعرض ضمن محتوى الدرس؛ يحتاج تأكيد أنها لا تضيف حكمًا ولا تفسيرًا من خارج الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ تِسْعَةٌ:</td><td></td><td>u4/u4l1/cards/c3</td><td>#/lesson/u4/u4l1</td></tr><tr class="p-med"><td>89</td><td>الفقه</td><td>شروط الوضوء</td><td>موقف تطبيقي (داخل الدرس)</td><td>على ظُفرك طلاءٌ سميك يمنع وصول الماء. ما الشرط الذي أخلَّ به؟<br>✔ إِزَالَةُ مَا يَمْنَعُ وُصُولَ الْمَاءِ إِلَى الْبَشَرَةِ<br>— النِّيَّةُ<br>— انْقِطَاعُ مُوجِبِ الْوُضُوءِ<br>— التَّمْيِيزُ<br>التفسير: هذا الشرط التاسع في الكتاب: «وَإِزَالَةُ مَا يَمْنَعُ وُصُولَهُ إِلَى الْبَشَرَةِ».</td><td>صياغة تعليمية مساعدة</td><td>30</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ تِسْعَةٌ:</td><td></td><td>u4/u4l1/interaction/i2</td><td>#/lesson/u4/u4l1</td></tr><tr class="p-med"><td>92</td><td>الفقه</td><td>أركان الوضوء</td><td>خلاصة الدرس</td><td>• أركان الوضوء ستة.<br>• غسل الوجه ومنه المضمضة والاستنشاق، وغسل اليدين مع المرفقين، ومسح جميع الرأس، وغسل الرجلين مع الكعبين.<br>• والترتيب والموالاة ركنان أيضًا.</td><td>صياغة تعليمية مساعدة</td><td>30</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ سِتَّةٌ:</td><td></td><td>u4/u4l2/summary</td><td>#/lesson/u4/u4l2</td></tr><tr class="p-med"><td>95</td><td>الفقه</td><td>من سنن الوضوء</td><td>خلاصة الدرس</td><td>• من سنن الوضوء: السواك، والتسمية، وغسل الكفين ثلاثًا، والتثليث، والتخليل، ومسح الأذنين، وتقديم اليمنى.<br>• المبالغة في المضمضة والاستنشاق لغير الصائم.<br>• يُسنّ الوضوء لكل صلاة، إلا إذا صلّى صلوات وراء بعض كالجمع والتراويح.</td><td>صياغة تعليمية مساعدة</td><td>30</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>١: السِّوَاكُ. | ٢: قَوْلُ: (بِاسْمِ اللهِ). | ٣: غَسْلُ الْكَفَّيْنِ ثَلَاثًا. | ٤: بَدَاءَةٌ بِمَضْمَضَةٍ فَاسْتِنْشَاقٍ قَبْلَ غَسْلِ الْوَجْهِ. | ٥: مُبَالَغَةٌ فِيهِمَا لِغَيْرِ صَائِمٍ. | ٦: تَكْرَارُ غَسْلِ الْوَجْهِ -وَمِنْهُ الْمَضْمَضَةُ وَالِاسْتِنْشَاقُ- وَالْيَدَيْنِ وَالرِّجْلَيْنِ ثَلَاثَ مَرَّاتٍ. | ٧: تَخْلِيلُ الشَّعَرِ الْكَثِيفِ وَالْأَصَابِعِ. | ٨: أَخْذُ مَاءٍ جَدِيدٍ لِلرَّأْسِ. | ٩: الْبَدَاءَةُ بِمُقَدَّمِ الرَّأْسِ إِلَى الْقَفَا ثُمَّ الْعَوْدَةُ إِلَى الْمُقَدَّمِ، أَوِ الْبَدَاءَةُ بِالْمُقَدَّمِ إِلَى الْقَفَا مِنْ غَيْرِ عَوْدَةٍ. | ١٠: مَسْحُ الْأُذُنَيْنِ. | ١١</td><td></td><td>u4/u4l3/summary</td><td>#/lesson/u4/u4l3</td></tr><tr class="p-med"><td>96</td><td>الفقه</td><td>من سنن الوضوء</td><td>موقف تطبيقي (داخل الدرس)</td><td>لبست الجوربين على طهارة، ثم انتقض وضوؤك وأردت الوضوء. ماذا تفعل؟<br>✔ أتوضأ وأمسح على الجوربين ولا يُسنّ نزعهما<br>— أنزعهما وأغسل رجليّ وجوبًا<br>— أمسح على الجوربين بلا وضوء<br>— أعيد لبسهما بعد الغسل<br>التفسير: الكتاب: «فَإِنَّهُ يَتَوَضَّأُ وَيَمْسَحُ... وَلَا يُسَنُّ نَزْعُهُمَا لِيَغْسِلَ رِجْلَيْهِ».</td><td>صياغة تعليمية مساعدة</td><td>31</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>١: السِّوَاكُ. | ٢: قَوْلُ: (بِاسْمِ اللهِ). | ٣: غَسْلُ الْكَفَّيْنِ ثَلَاثًا. | ٤: بَدَاءَةٌ بِمَضْمَضَةٍ فَاسْتِنْشَاقٍ قَبْلَ غَسْلِ الْوَجْهِ. | ٥: مُبَالَغَةٌ فِيهِمَا لِغَيْرِ صَائِمٍ. | ٦: تَكْرَارُ غَسْلِ الْوَجْهِ -وَمِنْهُ الْمَضْمَضَةُ وَالِاسْتِنْشَاقُ- وَالْيَدَيْنِ وَالرِّجْلَيْنِ ثَلَاثَ مَرَّاتٍ. | ٧: تَخْلِيلُ الشَّعَرِ الْكَثِيفِ وَالْأَصَابِعِ. | ٨: أَخْذُ مَاءٍ جَدِيدٍ لِلرَّأْسِ. | ٩: الْبَدَاءَةُ بِمُقَدَّمِ الرَّأْسِ إِلَى الْقَفَا ثُمَّ الْعَوْدَةُ إِلَى الْمُقَدَّمِ، أَوِ الْبَدَاءَةُ بِالْمُقَدَّمِ إِلَى الْقَفَا مِنْ غَيْرِ عَوْدَةٍ. | ١٠: مَسْحُ الْأُذُنَيْنِ. | ١١</td><td></td><td>u4/u4l3/interaction/i2</td><td>#/lesson/u4/u4l3</td></tr><tr class="p-med"><td>99</td><td>الفقه</td><td>نواقض الوضوء</td><td>خلاصة الدرس</td><td>• نواقض الوضوء ستة.<br>• منها الخارج من السبيلين، وزوال العقل بنوم أو غيره.<br>• ومنها أكل لحم الإبل، والردة عن الإسلام.</td><td>صياغة تعليمية مساعدة</td><td>32</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ سِتَّةٌ:</td><td></td><td>u4/u4l4/summary</td><td>#/lesson/u4/u4l4</td></tr><tr class="p-med"><td>102</td><td>الفقه</td><td>شروط الصلاة</td><td>خلاصة الدرس</td><td>• شروط الصلاة تسعة.<br>• منها: رفع الحدث، وإزالة النجاسة، وستر العورة.<br>• ومنها: دخول الوقت، واستقبال القبلة، والنية.</td><td>صياغة تعليمية مساعدة</td><td>32</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ تِسْعَةٌ:</td><td></td><td>u4/u4l5/summary</td><td>#/lesson/u4/u4l5</td></tr><tr class="p-med"><td>103</td><td>الفقه</td><td>شروط الصلاة</td><td>موقف تطبيقي (داخل الدرس)</td><td>صلّيت قبل دخول وقت الصلاة. أيّ شرط أخللت به؟<br>✔ دُخُولُ الْوَقْتِ<br>— النِّيَّةُ<br>— سَتْرُ الْعَوْرَةِ<br>— اسْتِقْبَالُ الْقِبْلَةِ<br>التفسير: «دُخُولُ الْوَقْتِ» شرط من شروط الصلاة التسعة في الكتاب.</td><td>صياغة تعليمية مساعدة</td><td>32</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ تِسْعَةٌ:</td><td></td><td>u4/u4l5/interaction/i2</td><td>#/lesson/u4/u4l5</td></tr><tr class="p-med"><td>106</td><td>الفقه</td><td>أركان الصلاة</td><td>خلاصة الدرس</td><td>• أركان الصلاة أربعة عشر.<br>• منها: القيام مع القدرة، وتكبيرة الإحرام، وقراءة الفاتحة، والركوع، والاعتدال.<br>• ومنها: الطمأنينة في جميع الأفعال، والتشهد الأخير، والتسليمتان، والترتيب بين الأركان.</td><td>صياغة تعليمية مساعدة</td><td>32</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ أَرْبَعَةَ عَشَرَ:</td><td></td><td>u4/u4l6/summary</td><td>#/lesson/u4/u4l6</td></tr><tr class="p-med"><td>109</td><td>الفقه</td><td>واجبات الصلاة والفرق بينها وبين الأركان</td><td>خلاصة الدرس</td><td>• واجبات الصلاة ثمانية.<br>• قول (سمع الله لمن حمده) للإمام والمنفرد، و(ربنا ولك الحمد) للكل.<br>• الركن لا يسقط عمدًا ولا سهوًا ولا جهلًا، والواجب يسقط سهوًا وجهلًا ويُجبر بسجود السهو.</td><td>صياغة تعليمية مساعدة</td><td>33</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ ثَمَانِيَةٌ:</td><td></td><td>u4/u4l7/summary</td><td>#/lesson/u4/u4l7</td></tr><tr class="p-med"><td>111</td><td>الفقه</td><td>واجبات الصلاة والفرق بينها وبين الأركان</td><td>موقف تطبيقي (داخل الدرس)</td><td>قمتَ سهوًا عن التشهد الأول. ماذا يترتب على ذلك بحسب الكتاب؟<br>✔ يسقط سهوًا ويُجبر بسجود السهو لأنه واجب<br>— تبطل الصلاة لأنه ركن<br>— لا شيء عليك مطلقًا<br>— تعيد الصلاة من أولها<br>التفسير: الكتاب: «وَأَمَّا الْوَاجِبُ فَيَسْقُطُ سَهْوًا وَجَهْلًا وَيُجْبَرُ بِسُجُودِ السَّهْوِ».</td><td>صياغة تعليمية مساعدة</td><td>34</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ ثَمَانِيَةٌ:</td><td></td><td>u4/u4l7/interaction/i2</td><td>#/lesson/u4/u4l7</td></tr><tr class="p-med"><td>114</td><td>الفقه</td><td>من سنن الصلاة</td><td>خلاصة الدرس</td><td>• من سنن الصلاة: الاستفتاح، ووضع اليمنى على اليسرى، ورفع اليدين في المواضع الأربعة.<br>• التورّك في التشهد الأخير في الرباعية والثلاثية.<br>• الجهر في الفجر والجمعة والعيدين والاستسقاء والأوليين من المغرب والعشاء، والإسرار فيما عدا ذلك.<br>• ويُسنّ أن تكون الصلاة على النبي ﷺ بالصلاة الإبراهيمية.</td><td>صياغة تعليمية مساعدة</td><td>34</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>١: الِاسْتِفْتَاحُ. | ٢: جَعْلُ كَفِّ الْيَدِ الْيُمْنَى عَلَى الْيُسْرَى حِينَ الْقِيَامِ قَبْلَ الرُّكُوعِ وَبَعْدَهُ. | ٣: رَفْعُ الْيَدَيْنِ مَضْمُومَتَيِ الْأَصَابِعِ مَمْدُودَةً حَذْوَ الْمَنْكِبَيْنِ أَوِ الْأُذُنَيْنِ عِنْدَ التَّكْبِيرِ الْأَوَّلِ، وَعِنْدَ الرُّكُوعِ، وَالرَّفْعِ مِنْهُ، وَعِنْدَ الْقِيَامِ مِنَ التَّشَهُّدِ الْأَوَّلِ إِلَى الثَّالِثَةِ. | ٤: مَا زَادَ عَنْ وَاحِدَةٍ فِي تَسْبِيحِ الرُّكُوعِ وَالسُّجُودِ. | ٥: مَا زَادَ عَلَى قَوْلِ: (رَبَّنَا وَلَكَ الْحَمْدُ) بَعْدَ الْقِيَامِ مِنَ الرُّكُوعِ. | ٦: مَا زَادَ عَنْ وَاحِدَةٍ فِي الدُّعَاءِ بِالْمَغْفِرَةِ بَيْنَ الس</td><td></td><td>u4/u4l8/summary</td><td>#/lesson/u4/u4l8</td></tr><tr class="p-med"><td>117</td><td>الفقه</td><td>مبطلات الصلاة</td><td>خلاصة الدرس</td><td>• مبطلات الصلاة ثمانية.<br>• منها: الكلام العمد مع الذكر والعلم، والضحك، والأكل، والشرب.<br>• ومنها: انكشاف العورة، والانحراف الكثير عن القبلة، والعبث الكثير المتوالي، وانتقاض الطهارة.</td><td>صياغة تعليمية مساعدة</td><td>36</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ ثَمَانِيَةٌ:</td><td></td><td>u4/u4l9/summary</td><td>#/lesson/u4/u4l9</td></tr><tr class="p-med"><td>120</td><td>الفقه</td><td>من صلاة التطوع</td><td>خلاصة الدرس</td><td>• السنن الرواتب: أربع قبل الظهر، وركعتان بعدها، وركعتان بعد المغرب، وركعتان بعد العشاء، وركعتان قبل الفجر.<br>• الضحى أقلها ركعتان ولا حدّ لأكثرها.<br>• الوتر أقله ركعة وأكثره إحدى عشرة، ووقته من بعد العشاء إلى الفجر.</td><td>صياغة تعليمية مساعدة</td><td>36</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>السُّنَنُ الرَّوَاتِبُ، وَهِيَ: أَرْبَعُ رَكَعَاتٍ قَبْلَ الظُّهْرِ، وَرَكْعَتَانِ بَعْدَهَا، وَرَكْعَتَانِ بَعْدَ الْمَغْرِبِ، وَرَكْعَتَانِ بَعْدَ الْعِشَاءِ، وَرَكْعَتَانِ قَبْلَ الْفَجْرِ.</td><td></td><td>u4/u4l10/summary</td><td>#/lesson/u4/u4l10</td></tr><tr class="p-med"><td>121</td><td>الفقه</td><td>من صلاة التطوع</td><td>موقف تطبيقي (داخل الدرس)</td><td>تخشى ألا تستيقظ آخر الليل. متى توتر؟<br>✔ أوتر قبل أن أنام<br>— أترك الوتر<br>— أوتر بعد الفجر<br>— أوتر ركعة واحدة فقط بعد الفجر<br>التفسير: الكتاب: «وَالْأَفْضَلُ أَنْ يَكُونَ آخِرَ اللَّيْلِ لِمَنْ يَغْلِبُ عَلَى ظَنِّهِ أَنْ يَقُومَ فِيهِ، وَإِلَّا أَوْتَرَ قَبْلَ أَنْ يَنَامَ».</td><td>صياغة تعليمية مساعدة</td><td>37</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>السُّنَنُ الرَّوَاتِبُ، وَهِيَ: أَرْبَعُ رَكَعَاتٍ قَبْلَ الظُّهْرِ، وَرَكْعَتَانِ بَعْدَهَا، وَرَكْعَتَانِ بَعْدَ الْمَغْرِبِ، وَرَكْعَتَانِ بَعْدَ الْعِشَاءِ، وَرَكْعَتَانِ قَبْلَ الْفَجْرِ.</td><td></td><td>u4/u4l10/interaction/i3</td><td>#/lesson/u4/u4l10</td></tr><tr class="p-med"><td>124</td><td>الأذكار والآداب</td><td>أذكار الصباح</td><td>خلاصة الدرس</td><td>• وقت أذكار الصباح من طلوع الفجر الثاني إلى طلوع الشمس.<br>• لا يلزم ترتيبها كما ذُكرت.<br>• من اعتادها فنسيها أو شُغل عنها بلا تفريط حتى خرج وقتها قالها بعده.<br>• وإن لم تقلها كلها فلا تتركها كلها.</td><td>صياغة تعليمية مساعدة</td><td>41</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَوَقْتُهَا مِنْ طُلُوعِ الْفَجْرِ الثَّانِي إِلَى طُلُوعِ الشَّمْسِ.</td><td></td><td>u5/u5l1/summary</td><td>#/lesson/u5/u5l1</td></tr><tr class="p-med"><td>126</td><td>الأذكار والآداب</td><td>أذكار الصباح</td><td>موقف تطبيقي (داخل الدرس)</td><td>شُغلت عن أذكار الصباح بلا تفريط حتى خرج وقتها. ماذا تفعل؟<br>✔ أقولها بعد خروج وقتها<br>— أتركها ولا شيء عليّ<br>— أضاعفها في المساء<br>— أقضيها في اليوم التالي<br>التفسير: الكتاب: «وَمَنِ اعْتَادَهَا فَنَسِيَهَا أَوْ شُغِلَ عَنْهَا بِلَا تَفْرِيطٍ حَتَّى خَرَجَ وَقْتُهَا؛ قَالَهَا بَعْدَهُ».</td><td>صياغة تعليمية مساعدة</td><td>46</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَوَقْتُهَا مِنْ طُلُوعِ الْفَجْرِ الثَّانِي إِلَى طُلُوعِ الشَّمْسِ.</td><td></td><td>u5/u5l1/interaction/i3</td><td>#/lesson/u5/u5l1</td></tr><tr class="p-med"><td>129</td><td>الأذكار والآداب</td><td>أذكار المساء</td><td>خلاصة الدرس</td><td>• وقت أذكار المساء من غروب الشمس إلى غياب الشفق الأحمر (ابتداء وقت العشاء).<br>• أكثر ألفاظها كأذكار الصباح مع تغيير (أصبحنا) إلى (أمسينا).<br>• ومنها: (أعوذ بكلمات الله التامات من شر ما خلق) وقراءة آخر آيتين من البقرة.</td><td>صياغة تعليمية مساعدة</td><td>44</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَوَقْتُهَا مِنْ غُرُوبِ الشَّمْسِ إِلَى غِيَابِ الشَّفَقِ الْأَحْمَرِ، وَهُوَ ابْتِدَاءُ وَقْتِ الْعِشَاءِ.</td><td></td><td>u5/u5l2/summary</td><td>#/lesson/u5/u5l2</td></tr><tr class="p-med"><td>132</td><td>الأذكار والآداب</td><td>الأذكار بعد الصلوات الخمس</td><td>خلاصة الدرس</td><td>• يبدأ بالاستغفار ثلاثًا ثم (اللهم أنت السلام...)، وما بعده لم يثبت فيه ترتيب.<br>• للتسبيح والتحميد والتكبير خمس صفات، وله أن يقرن بينها وله أن يفرق.<br>• السنة الجهر بهذه الأذكار إلا آية الكرسي فتُقرأ سرًّا.<br>• وقت أذكار كل صلاة بعدها إلى خروج وقتها.</td><td>صياغة تعليمية مساعدة</td><td>47</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَسْتَغْفِرُ اللهَ ثَلَاثًا، وَيَقُولُ: (اللَّهُمَّ أَنْتَ السَّلَامُ، وَمِنْكَ السَّلَامُ، تَبَارَكْتَ يَا ذَا الْجَلَالِ وَالْإِكْرَامِ). هَذَا أَوَّلُ مَا يَبْدَأُ بِهِ مِنَ الْأَذْكَارِ، وَأَمَّا الَّذِي بَعْدَهُ فَلَمْ يَثْبُتْ فِيهِ تَرْتِيبٌ.</td><td></td><td>u5/u5l3/summary</td><td>#/lesson/u5/u5l3</td></tr><tr class="p-med"><td>135</td><td>الأذكار والآداب</td><td>أذكار النوم</td><td>خلاصة الدرس</td><td>• يتوضأ، وينفض فراشه، ويضطجع على شقّه الأيمن.<br>• التسبيح ثلاث وثلاثون، والتحميد ثلاث وثلاثون، والتكبير أربع وثلاثون.<br>• يقرأ الإخلاص والمعوذتين في كفيه وينفث ويمسح، ثلاث مرات.<br>• ويجعل (اللهم أسلمت وجهي إليك...) آخر ما يقول.</td><td>صياغة تعليمية مساعدة</td><td>49</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>إِذَا أَرَدْتَ النَّوْمَ فَتَوَضَّأْ، ثُمَّ انْفُضْ فِرَاشَكَ، ثُمَّ اضْطَجِعْ عَلَى شِقِّكَ الْأَيْمَنِ، وَضَعْ يَدَكَ الْيُمْنَى تَحْتَ خَدِّكَ الْأَيْمَنِ، وَقُلْ:</td><td></td><td>u5/u5l4/summary</td><td>#/lesson/u5/u5l4</td></tr><tr class="p-med"><td>138</td><td>الأذكار والآداب</td><td>أذكار الاستيقاظ من النوم</td><td>خلاصة الدرس</td><td>• ذكر الاستيقاظ: (الحمد لله الذي أحيانا بعدما أماتنا وإليه النشور).<br>• وتُقرأ خواتيم آل عمران عند الاستيقاظ من نوم الليل فقط.</td><td>صياغة تعليمية مساعدة</td><td>50</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>(الْحَمْدُ لِلهِ الَّذِي أَحْيَانَا بَعْدَمَا أَمَاتَنَا وَإِلَيْهِ النُّشُورُ).</td><td></td><td>u5/u5l5/summary</td><td>#/lesson/u5/u5l5</td></tr><tr class="p-med"><td>139</td><td>الأذكار والآداب</td><td>أذكار الاستيقاظ من النوم</td><td>interaction:match</td><td>طابِق بين الحال وما يُقرأ فيها كما في الكتاب.<br>التفسير: الكتاب قيّد قراءة خواتيم آل عمران بقوله: «إِذَا اسْتَيْقَظَ مِنْ نَوْمِ اللَّيْلِ فَقَطْ».</td><td>صياغة تعليمية مساعدة</td><td>50</td><td>مطابقة بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد صحّة الأزواج ومطابقتها لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>(الْحَمْدُ لِلهِ الَّذِي أَحْيَانَا بَعْدَمَا أَمَاتَنَا وَإِلَيْهِ النُّشُورُ).</td><td></td><td>u5/u5l5/interaction/x1</td><td>#/lesson/u5/u5l5</td></tr><tr class="p-med"><td>140</td><td>الأذكار والآداب</td><td>أذكار الاستيقاظ من النوم</td><td>interaction:mcq</td><td>﴿إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ…﴾ إلى آخر أيّ سورة؟<br>✔ آل عمران<br>— البقرة<br>— النساء<br>— الأنعام<br>التفسير: نصّ الكتاب: «إِلَى آخِرِ سُورَةِ آلِ عِمْرَانَ».</td><td>صياغة تعليمية مساعدة</td><td>50</td><td>سؤال اختيار بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد أنه لا يضيف حكمًا ولا معلومة من خارج الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>(الْحَمْدُ لِلهِ الَّذِي أَحْيَانَا بَعْدَمَا أَمَاتَنَا وَإِلَيْهِ النُّشُورُ).</td><td></td><td>u5/u5l5/interaction/x2</td><td>#/lesson/u5/u5l5</td></tr><tr class="p-med"><td>143</td><td>الأذكار والآداب</td><td>إن رأى في نومه ما يكره</td><td>خلاصة الدرس</td><td>• ينفث عن يساره ثلاثًا، ويتعوذ بالله من شرّه، ولا يخبر به أحدًا.</td><td>صياغة تعليمية مساعدة</td><td>50</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَنْفُثُ عَنْ يَسَارِهِ ثَلَاثَ مَرَّاتٍ، وَيَتَعَوَّذُ بِاللهِ مِنْ شَرِّهِ، وَلَا يُخْبِرُ بِهِ أَحَدًا.</td><td></td><td>u5/u5l6/summary</td><td>#/lesson/u5/u5l6</td></tr><tr class="p-med"><td>144</td><td>الأذكار والآداب</td><td>إن رأى في نومه ما يكره</td><td>موقف تطبيقي (داخل الدرس)</td><td>رأيت رؤيا مزعجة واستيقظت خائفًا. ما أول ما تفعله بحسب الكتاب؟<br>✔ أنفث عن يساري ثلاثًا وأتعوذ بالله من شرها ولا أخبر بها أحدًا<br>— أتصل بأحد لأقصّها عليه<br>— أبحث عن تفسيرها<br>— أنشرها في وسائل التواصل<br>التفسير: الكتاب: «يَنْفُثُ عَنْ يَسَارِهِ ثَلَاثَ مَرَّاتٍ، وَيَتَعَوَّذُ بِاللهِ مِنْ شَرِّهِ، وَلَا يُخْبِرُ بِهِ أَحَدًا».</td><td>صياغة تعليمية مساعدة</td><td>50</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَنْفُثُ عَنْ يَسَارِهِ ثَلَاثَ مَرَّاتٍ، وَيَتَعَوَّذُ بِاللهِ مِنْ شَرِّهِ، وَلَا يُخْبِرُ بِهِ أَحَدًا.</td><td></td><td>u5/u5l6/interaction/i1</td><td>#/lesson/u5/u5l6</td></tr><tr class="p-med"><td>145</td><td>الأذكار والآداب</td><td>إن رأى في نومه ما يكره</td><td>interaction:order</td><td>رتّب ما يفعله من رأى في نومه ما يكره، كما ذكره الكتاب.<br>التفسير: هذا ترتيب الكتاب نصًّا في هذا الباب.</td><td>صياغة تعليمية مساعدة</td><td>50</td><td>ترتيب خطوات بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد أنّ الترتيب ثابت في نصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَنْفُثُ عَنْ يَسَارِهِ ثَلَاثَ مَرَّاتٍ، وَيَتَعَوَّذُ بِاللهِ مِنْ شَرِّهِ، وَلَا يُخْبِرُ بِهِ أَحَدًا.</td><td></td><td>u5/u5l6/interaction/x1</td><td>#/lesson/u5/u5l6</td></tr><tr class="p-med"><td>146</td><td>الأذكار والآداب</td><td>إن رأى في نومه ما يكره</td><td>interaction:complete</td><td>أكمل نصّ الكتاب.<br>✔ يَسَارِهِ<br>— يَمِينِهِ<br>— أَمَامِهِ<br>— خَلْفِهِ<br>التفسير: نصّ الكتاب: «يَنْفُثُ عَنْ يَسَارِهِ ثَلَاثَ مَرَّاتٍ».</td><td>صياغة تعليمية مساعدة</td><td>50</td><td>إكمال نصّ بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد مطابقة النصّ للكتاب وسلامة الخيارات.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَنْفُثُ عَنْ يَسَارِهِ ثَلَاثَ مَرَّاتٍ، وَيَتَعَوَّذُ بِاللهِ مِنْ شَرِّهِ، وَلَا يُخْبِرُ بِهِ أَحَدًا.</td><td></td><td>u5/u5l6/interaction/x2</td><td>#/lesson/u5/u5l6</td></tr><tr class="p-med"><td>149</td><td>الأذكار والآداب</td><td>من استيقظ من الليل</td><td>خلاصة الدرس</td><td>• من استيقظ من الليل فقال هذا الذكر ثم دعا استُجيب له، فإن توضأ وصلّى قُبلت صلاته.</td><td>صياغة تعليمية مساعدة</td><td>51</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>(لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ، وَلَهُ الْحَمْدُ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ، الْحَمْدُ لِلهِ، وَسُبْحَانَ اللهِ، وَلَا إِلَهَ إِلَّا اللهُ، وَاللهُ أَكْبَرُ، وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللهِ).</td><td></td><td>u5/u5l7/summary</td><td>#/lesson/u5/u5l7</td></tr><tr class="p-med"><td>150</td><td>الأذكار والآداب</td><td>من استيقظ من الليل</td><td>interaction:order</td><td>رتّب ما ذكره الكتاب في هذا الباب.<br>التفسير: نصّ الكتاب: «فَإِنْ قَالَ بَعْدَهَا: اللَّهُمَّ اغْفِرْ لِي -أَوْ دَعَا- اسْتُجِيبَ لَهُ، فَإِنْ تَوَضَّأَ وَصَلَّى قُبِلَتْ صَلَاتُهُ».</td><td>صياغة تعليمية مساعدة</td><td>51</td><td>ترتيب خطوات بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد أنّ الترتيب ثابت في نصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>(لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ، وَلَهُ الْحَمْدُ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ، الْحَمْدُ لِلهِ، وَسُبْحَانَ اللهِ، وَلَا إِلَهَ إِلَّا اللهُ، وَاللهُ أَكْبَرُ، وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللهِ).</td><td></td><td>u5/u5l7/interaction/x1</td><td>#/lesson/u5/u5l7</td></tr><tr class="p-med"><td>151</td><td>الأذكار والآداب</td><td>من استيقظ من الليل</td><td>interaction:complete</td><td>أكمل آخر الذكر.<br>✔ بِاللهِ<br>— بِرَبِّي<br>— بِالرَّحْمَنِ<br>— بِمَشِيئَتِهِ<br>التفسير: خاتمة الذكر في الكتاب: «وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللهِ».</td><td>صياغة تعليمية مساعدة</td><td>51</td><td>إكمال نصّ بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد مطابقة النصّ للكتاب وسلامة الخيارات.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>(لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ، وَلَهُ الْحَمْدُ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ، الْحَمْدُ لِلهِ، وَسُبْحَانَ اللهِ، وَلَا إِلَهَ إِلَّا اللهُ، وَاللهُ أَكْبَرُ، وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللهِ).</td><td></td><td>u5/u5l7/interaction/x2</td><td>#/lesson/u5/u5l7</td></tr><tr class="p-med"><td>154</td><td>الأذكار والآداب</td><td>آداب الأكل والشرب</td><td>خلاصة الدرس</td><td>• الأكل والشرب باليمين، جالسًا، مع التسمية، ويأكل مما يليه.<br>• إن نسي التسمية في أوله قال: (باسم الله أوله وآخره).<br>• شرب الماء على ثلاث دفعات، ولا يتنفس في الإناء.<br>• ولا يعيب طعامًا؛ إن اشتهاه أكله وإلا تركه.</td><td>صياغة تعليمية مساعدة</td><td>51</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَكُونُ بِالْيَمِينِ، جَالِسًا، وَيَقُولُ قَبْلَ الْأَكْلِ وَالشُّرْبِ: (بِاسْمِ اللهِ)، وَيَأْكُلُ مِمَّا يَلِيهِ.</td><td></td><td>u5/u5l8/summary</td><td>#/lesson/u5/u5l8</td></tr><tr class="p-med"><td>156</td><td>الأذكار والآداب</td><td>آداب الأكل والشرب</td><td>موقف تطبيقي (داخل الدرس)</td><td>بدأت الأكل ونسيت التسمية. ماذا تقول؟<br>✔ (بِاسْمِ اللهِ أَوَّلَهُ وَآخِرَهُ)<br>— (بِاسْمِ اللهِ) فقط<br>— (الْحَمْدُ لِلهِ)<br>— لا شيء عليّ<br>التفسير: الكتاب: «فَإِنْ نَسِيَ فِي أَوَّلِهِ فَلْيَقُلْ: (بِاسْمِ اللهِ أَوَّلَهُ وَآخِرَهُ)».</td><td>صياغة تعليمية مساعدة</td><td>51</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَكُونُ بِالْيَمِينِ، جَالِسًا، وَيَقُولُ قَبْلَ الْأَكْلِ وَالشُّرْبِ: (بِاسْمِ اللهِ)، وَيَأْكُلُ مِمَّا يَلِيهِ.</td><td></td><td>u5/u5l8/interaction/i1</td><td>#/lesson/u5/u5l8</td></tr><tr class="p-med"><td>159</td><td>الأذكار والآداب</td><td>آداب الخلاء</td><td>خلاصة الدرس</td><td>• عند الدخول: يقدّم اليسرى ويقول (بسم الله، اللهم إني أعوذ بك من الخبث والخبائث).<br>• عند الخروج: يقدّم اليمنى ويقول (غفرانك).<br>• ويحترز من البول، ولا يستنجي بيمينه، ولا يلبث فوق حاجته.</td><td>صياغة تعليمية مساعدة</td><td>52</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>عِنْدَ دُخُولِهِ يُقَدِّمُ رِجْلَهُ الْيُسْرَى وَيَقُولُ: (بِسْمِ اللهِ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْخُبْثِ وَالْخَبَائِثِ).</td><td></td><td>u5/u5l9/summary</td><td>#/lesson/u5/u5l9</td></tr><tr class="p-med"><td>162</td><td>الأذكار والآداب</td><td>السلام</td><td>خلاصة الدرس</td><td>• السلام: (السلام عليكم ورحمة الله وبركاته)، والردّ: (وعليكم السلام ورحمة الله وبركاته).</td><td>صياغة تعليمية مساعدة</td><td>52</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>إِذَا لَقِيتَ مُسْلِمًا فَسَلِّمْ عَلَيْهِ قَائِلًا: (السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ)، وَإِنْ سَلَّمَ عَلَيْكَ فَقُلْ: (وَعَلَيْكُمُ السَّلَامُ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ).</td><td></td><td>u5/u5l10/summary</td><td>#/lesson/u5/u5l10</td></tr><tr class="p-med"><td>163</td><td>الأذكار والآداب</td><td>السلام</td><td>interaction:complete</td><td>أكمل صيغة السلام كما في الكتاب.<br>✔ وَبَرَكَاتُهُ<br>— وَمَغْفِرَتُهُ<br>— وَرِضْوَانُهُ<br>— وَفَضْلُهُ<br>التفسير: نصّ الكتاب: «(السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ)».</td><td>صياغة تعليمية مساعدة</td><td>52</td><td>إكمال نصّ بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد مطابقة النصّ للكتاب وسلامة الخيارات.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>إِذَا لَقِيتَ مُسْلِمًا فَسَلِّمْ عَلَيْهِ قَائِلًا: (السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ)، وَإِنْ سَلَّمَ عَلَيْكَ فَقُلْ: (وَعَلَيْكُمُ السَّلَامُ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ).</td><td></td><td>u5/u5l10/interaction/x1</td><td>#/lesson/u5/u5l10</td></tr><tr class="p-med"><td>164</td><td>الأذكار والآداب</td><td>السلام</td><td>interaction:match</td><td>طابِق بين الحال وصيغتها.<br>التفسير: هذا نصّ الكتاب في باب السلام، والفرق بين الابتداء والردّ.</td><td>صياغة تعليمية مساعدة</td><td>52</td><td>مطابقة بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد صحّة الأزواج ومطابقتها لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>إِذَا لَقِيتَ مُسْلِمًا فَسَلِّمْ عَلَيْهِ قَائِلًا: (السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ)، وَإِنْ سَلَّمَ عَلَيْكَ فَقُلْ: (وَعَلَيْكُمُ السَّلَامُ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ).</td><td></td><td>u5/u5l10/interaction/x2</td><td>#/lesson/u5/u5l10</td></tr><tr class="p-med"><td>167</td><td>الأذكار والآداب</td><td>الاستئذان وآداب المجلس</td><td>خلاصة الدرس</td><td>• الاستئذان واقفًا عن يمين الباب أو يساره، ويُكرَّر ثلاثًا فقط.<br>• إذا سُئل: مَن؟ يقول اسمه ولا يقول: أنا.<br>• من آداب المجلس: الجلوس حيث ينتهي به المجلس، وألا يفرّق بين اثنين، وأن يفسح لمن دخل، ويذكر الله.</td><td>صياغة تعليمية مساعدة</td><td>52</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>إِذَا أَرَدْتَ الدُّخُولَ عَلَى أَحَدٍ فَاسْتَأْذِنْ، وَاقِفًا عَنْ يَمِينِ الْبَابِ أَوْ يَسَارِهِ، وَإِنْ أَرَدْتَ أَنْ تُكَرِّرَ الِاسْتِئْذَانَ فَكَرِّرْهُ ثَلَاثًا فَقَطْ، فَإِنْ سَأَلَكَ فَقَالَ: مَنْ؟ فَقُلْ: فُلَانٌ، وَلَا تَقُلْ: أَنَا. فَإِنْ أَذِنَ لَكَ دَخَلْتَ، وَإِنْ قِيلَ لَكَ: ارْجِعْ. فَارْجِعْ.</td><td></td><td>u5/u5l11/summary</td><td>#/lesson/u5/u5l11</td></tr><tr class="p-med"><td>168</td><td>الأذكار والآداب</td><td>الاستئذان وآداب المجلس</td><td>موقف تطبيقي (داخل الدرس)</td><td>استأذنت ثلاثًا ولم يُؤذن لك. ما التصرّف؟<br>✔ أرجع<br>— أكرّر الاستئذان حتى يُفتح لي<br>— أدخل لأنّ الباب مفتوح<br>— أتصل بهم مرارًا<br>التفسير: الكتاب: «فَكَرِّرْهُ ثَلَاثًا فَقَطْ... وَإِنْ قِيلَ لَكَ: ارْجِعْ. فَارْجِعْ».</td><td>صياغة تعليمية مساعدة</td><td>52</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>إِذَا أَرَدْتَ الدُّخُولَ عَلَى أَحَدٍ فَاسْتَأْذِنْ، وَاقِفًا عَنْ يَمِينِ الْبَابِ أَوْ يَسَارِهِ، وَإِنْ أَرَدْتَ أَنْ تُكَرِّرَ الِاسْتِئْذَانَ فَكَرِّرْهُ ثَلَاثًا فَقَطْ، فَإِنْ سَأَلَكَ فَقَالَ: مَنْ؟ فَقُلْ: فُلَانٌ، وَلَا تَقُلْ: أَنَا. فَإِنْ أَذِنَ لَكَ دَخَلْتَ، وَإِنْ قِيلَ لَكَ: ارْجِعْ. فَارْجِعْ.</td><td></td><td>u5/u5l11/interaction/i2</td><td>#/lesson/u5/u5l11</td></tr><tr class="p-med"><td>171</td><td>الأذكار والآداب</td><td>أذكار المسجد</td><td>خلاصة الدرس</td><td>• دخول المسجد: (اللهم افتح لي أبواب رحمتك)، والخروج: (اللهم إني أسألك من فضلك).</td><td>صياغة تعليمية مساعدة</td><td>53</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَقُولُ عِنْدَ دُخُولِهِ: (اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ). وَعِنْدَ خُرُوجِهِ: (اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ فَضْلِكَ).</td><td></td><td>u5/u5l12/summary</td><td>#/lesson/u5/u5l12</td></tr><tr class="p-med"><td>172</td><td>الأذكار والآداب</td><td>أذكار المسجد</td><td>ملحوظة تعليمية</td><td>عند الدخول تسأل الرحمة لأنك مُقبل على العبادة، وعند الخروج تسأل الفضل لأنك مُقبل على طلب الرزق.</td><td>صياغة تعليمية مساعدة</td><td>53</td><td>ملحوظة تعليمية مستحدثة تُعرض ضمن محتوى الدرس؛ يحتاج تأكيد أنها لا تضيف حكمًا ولا تفسيرًا من خارج الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَقُولُ عِنْدَ دُخُولِهِ: (اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ). وَعِنْدَ خُرُوجِهِ: (اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ فَضْلِكَ).</td><td></td><td>u5/u5l12/cards/c2</td><td>#/lesson/u5/u5l12</td></tr><tr class="p-med"><td>173</td><td>الأذكار والآداب</td><td>أذكار المسجد</td><td>interaction:complete</td><td>أكمل ذكر دخول المسجد.<br>✔ رَحْمَتِكَ<br>— فَضْلِكَ<br>— مَغْفِرَتِكَ<br>— الْجَنَّةِ<br>التفسير: نصّ الكتاب: «يَقُولُ عِنْدَ دُخُولِهِ: (اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ)».</td><td>صياغة تعليمية مساعدة</td><td>53</td><td>إكمال نصّ بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد مطابقة النصّ للكتاب وسلامة الخيارات.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَقُولُ عِنْدَ دُخُولِهِ: (اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ). وَعِنْدَ خُرُوجِهِ: (اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ فَضْلِكَ).</td><td></td><td>u5/u5l12/interaction/x1</td><td>#/lesson/u5/u5l12</td></tr><tr class="p-med"><td>174</td><td>الأذكار والآداب</td><td>أذكار المسجد</td><td>موقف تطبيقي (داخل الدرس)</td><td>خرجتَ من المسجد بعد الصلاة متوجّهًا إلى عملك. ما الذي تقوله؟<br>✔ (اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ فَضْلِكَ)<br>— (اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ)<br>— (غُفْرَانَكَ)<br>— لا ذكر عند الخروج<br>التفسير: نصّ الكتاب: «وَعِنْدَ خُرُوجِهِ: (اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ فَضْلِكَ)».</td><td>صياغة تعليمية مساعدة</td><td>53</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَقُولُ عِنْدَ دُخُولِهِ: (اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ). وَعِنْدَ خُرُوجِهِ: (اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ فَضْلِكَ).</td><td></td><td>u5/u5l12/interaction/x2</td><td>#/lesson/u5/u5l12</td></tr><tr class="p-med"><td>177</td><td>الأذكار والآداب</td><td>عند العطاس</td><td>خلاصة الدرس</td><td>• العاطس يغطّي وجهه ويقول: (الحمد لله).<br>• من سمعه يقول: (يرحمك الله).<br>• فيردّ العاطس: (يهديكم الله ويصلح بالكم).</td><td>صياغة تعليمية مساعدة</td><td>53</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يُغَطِّي الْعَاطِسُ وَجْهَهُ، فَإِذَا عَطَسَ يَقُولُ: (الْحَمْدُ لِلهِ). وَيَرُدُّ عَلَيْهِ مَنْ سَمِعَهُ فَيَقُولُ: (يَرْحَمُكَ اللهُ). فَيَرُدُّ عَلَيْهِ وَيَقُولُ: (يَهْدِيكُمُ اللهُ وَيُصْلِحُ بَالَكُمْ).</td><td></td><td>u5/u5l13/summary</td><td>#/lesson/u5/u5l13</td></tr><tr class="p-med"><td>178</td><td>الأذكار والآداب</td><td>عند العطاس</td><td>interaction:match</td><td>طابِق بين القائل وما يقوله.<br>التفسير: هذا نصّ الكتاب في باب العطاس.</td><td>صياغة تعليمية مساعدة</td><td>53</td><td>مطابقة بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد صحّة الأزواج ومطابقتها لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يُغَطِّي الْعَاطِسُ وَجْهَهُ، فَإِذَا عَطَسَ يَقُولُ: (الْحَمْدُ لِلهِ). وَيَرُدُّ عَلَيْهِ مَنْ سَمِعَهُ فَيَقُولُ: (يَرْحَمُكَ اللهُ). فَيَرُدُّ عَلَيْهِ وَيَقُولُ: (يَهْدِيكُمُ اللهُ وَيُصْلِحُ بَالَكُمْ).</td><td></td><td>u5/u5l13/interaction/x1</td><td>#/lesson/u5/u5l13</td></tr><tr class="p-med"><td>179</td><td>الأذكار والآداب</td><td>عند العطاس</td><td>interaction:mcq</td><td>ما الذي يفعله العاطس قبل الذكر كما ذكر الكتاب؟<br>✔ يُغَطِّي وَجْهَهُ<br>— يَرْفَعُ صَوْتَهُ<br>— يَلْتَفِتُ يَمِينًا<br>— يَقُومُ مِنْ مَجْلِسِهِ<br>التفسير: نصّ الكتاب: «يُغَطِّي الْعَاطِسُ وَجْهَهُ، فَإِذَا عَطَسَ يَقُولُ: (الْحَمْدُ لِلهِ)».</td><td>صياغة تعليمية مساعدة</td><td>53</td><td>سؤال اختيار بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد أنه لا يضيف حكمًا ولا معلومة من خارج الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يُغَطِّي الْعَاطِسُ وَجْهَهُ، فَإِذَا عَطَسَ يَقُولُ: (الْحَمْدُ لِلهِ). وَيَرُدُّ عَلَيْهِ مَنْ سَمِعَهُ فَيَقُولُ: (يَرْحَمُكَ اللهُ). فَيَرُدُّ عَلَيْهِ وَيَقُولُ: (يَهْدِيكُمُ اللهُ وَيُصْلِحُ بَالَكُمْ).</td><td></td><td>u5/u5l13/interaction/x2</td><td>#/lesson/u5/u5l13</td></tr><tr class="p-med"><td>182</td><td>الأذكار والآداب</td><td>التثاؤب</td><td>خلاصة الدرس</td><td>• يردّ التثاؤب ما استطاع، ويمسك بيده على فيه، ولا يقول: آهْ آهْ، وليس له ذكر خاص.</td><td>صياغة تعليمية مساعدة</td><td>54</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَرُدُّهُ مَا اسْتَطَاعَ، وَيُمْسِكُ بِيَدِهِ عَلَى فِيهِ، وَلَا يَقُولُ: آهْ آهْ. وَلَيْسَ لَهُ ذِكْرٌ خَاصٌّ.</td><td></td><td>u5/u5l14/summary</td><td>#/lesson/u5/u5l14</td></tr><tr class="p-med"><td>183</td><td>الأذكار والآداب</td><td>التثاؤب</td><td>interaction:classify</td><td>صنّف ما ورد في باب التثاؤب.<br>التفسير: نصّ الكتاب: «يَرُدُّهُ مَا اسْتَطَاعَ، وَيُمْسِكُ بِيَدِهِ عَلَى فِيهِ، وَلَا يَقُولُ: آهْ آهْ. وَلَيْسَ لَهُ ذِكْرٌ خَاصٌّ».</td><td>صياغة تعليمية مساعدة</td><td>54</td><td>تصنيف بصياغة تعليمية مساعدة مستمدّ من نصّ الدرس؛ يحتاج تأكيد أنّ التصنيف مأخوذ من الكتاب لا من اجتهاد.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَرُدُّهُ مَا اسْتَطَاعَ، وَيُمْسِكُ بِيَدِهِ عَلَى فِيهِ، وَلَا يَقُولُ: آهْ آهْ. وَلَيْسَ لَهُ ذِكْرٌ خَاصٌّ.</td><td></td><td>u5/u5l14/interaction/x1</td><td>#/lesson/u5/u5l14</td></tr><tr class="p-med"><td>184</td><td>الأذكار والآداب</td><td>التثاؤب</td><td>interaction:complete</td><td>أكمل نصّ الكتاب.<br>✔ اسْتَطَاعَ<br>— أَمْكَنَ<br>— قَدَرَ<br>— شَاءَ<br>التفسير: نصّ الكتاب: «يَرُدُّهُ مَا اسْتَطَاعَ».</td><td>صياغة تعليمية مساعدة</td><td>54</td><td>إكمال نصّ بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد مطابقة النصّ للكتاب وسلامة الخيارات.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَرُدُّهُ مَا اسْتَطَاعَ، وَيُمْسِكُ بِيَدِهِ عَلَى فِيهِ، وَلَا يَقُولُ: آهْ آهْ. وَلَيْسَ لَهُ ذِكْرٌ خَاصٌّ.</td><td></td><td>u5/u5l14/interaction/x2</td><td>#/lesson/u5/u5l14</td></tr><tr class="p-med"><td>187</td><td>الأذكار والآداب</td><td>عند الكرب</td><td>خلاصة الدرس</td><td>• دعاء الكرب يجمع بين التوحيد وتعظيم الله وربوبيته للسماوات والأرض والعرش.</td><td>صياغة تعليمية مساعدة</td><td>54</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>(لَا إِلَهَ إِلَّا اللهُ الْعَظِيمُ الْحَلِيمُ، لَا إِلَهَ إِلَّا اللهُ رَبُّ الْعَرْشِ الْعَظِيمِ، لَا إِلَهَ إِلَّا اللهُ رَبُّ السَّمَاوَاتِ وَرَبُّ الْأَرْضِ وَرَبُّ الْعَرْشِ الْعَظِيمِ).</td><td></td><td>u5/u5l15/summary</td><td>#/lesson/u5/u5l15</td></tr><tr class="p-med"><td>188</td><td>الأذكار والآداب</td><td>عند الكرب</td><td>interaction:order</td><td>رتّب جُمل دعاء الكرب كما وردت في الكتاب.<br>التفسير: هذا ترتيب الجُمل الثلاث في نصّ الكتاب.</td><td>صياغة تعليمية مساعدة</td><td>54</td><td>ترتيب خطوات بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد أنّ الترتيب ثابت في نصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>(لَا إِلَهَ إِلَّا اللهُ الْعَظِيمُ الْحَلِيمُ، لَا إِلَهَ إِلَّا اللهُ رَبُّ الْعَرْشِ الْعَظِيمِ، لَا إِلَهَ إِلَّا اللهُ رَبُّ السَّمَاوَاتِ وَرَبُّ الْأَرْضِ وَرَبُّ الْعَرْشِ الْعَظِيمِ).</td><td></td><td>u5/u5l15/interaction/x1</td><td>#/lesson/u5/u5l15</td></tr><tr class="p-med"><td>189</td><td>الأذكار والآداب</td><td>عند الكرب</td><td>interaction:mcq</td><td>كم مرة تكرّرت «لَا إِلَهَ إِلَّا اللهُ» في دعاء الكرب كما أورده الكتاب؟<br>✔ ثلاث مرات<br>— مرة واحدة<br>— مرتان<br>— أربع مرات<br>التفسير: الدعاء في الكتاب ثلاث جُمل، كلٌّ منها تبدأ بـ«لَا إِلَهَ إِلَّا اللهُ».</td><td>صياغة تعليمية مساعدة</td><td>54</td><td>سؤال اختيار بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد أنه لا يضيف حكمًا ولا معلومة من خارج الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>(لَا إِلَهَ إِلَّا اللهُ الْعَظِيمُ الْحَلِيمُ، لَا إِلَهَ إِلَّا اللهُ رَبُّ الْعَرْشِ الْعَظِيمِ، لَا إِلَهَ إِلَّا اللهُ رَبُّ السَّمَاوَاتِ وَرَبُّ الْأَرْضِ وَرَبُّ الْعَرْشِ الْعَظِيمِ).</td><td></td><td>u5/u5l15/interaction/x2</td><td>#/lesson/u5/u5l15</td></tr><tr class="p-med"><td>192</td><td>الأذكار والآداب</td><td>الاستخارة</td><td>خلاصة الدرس</td><td>• الاستخارة عند التردّد بين فعل أمر أو تركه، أو بين أمرين.<br>• يصلّي ركعتين ثم يدعو بعد السلام.<br>• ويُسمّي حاجته في موضعيها من الدعاء.</td><td>صياغة تعليمية مساعدة</td><td>54</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>إِذَا تَرَدَّدَ بَيْنَ فِعْلِ أَمْرٍ أَوْ تَرْكِهِ، أَوْ تَرَدَّدَ بَيْنَ أَمْرَيْنِ أَيَّهُمَا يَفْعَلُهُ، فَإِنَّهُ يُصَلِّي رَكْعَتَيْنِ، وَيَقُولُ بَعْدَمَا يُسَلِّمُ مِنَ الصَّلَاةِ:</td><td></td><td>u5/u5l16/summary</td><td>#/lesson/u5/u5l16</td></tr><tr class="p-med"><td>196</td><td>الأذكار والآداب</td><td>صلة الرحم</td><td>خلاصة الدرس</td><td>• الرحم: الأقارب في النسب من جهة الأب والأم، الأقرب فالأقرب، وأعظمهم الوالدان.<br>• الصلة تكون بما جرى به العرف واتّبعه الناس.<br>• من وصل رحمه وصله الله، ومن قطعها قطعه الله.</td><td>صياغة تعليمية مساعدة</td><td>55</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهُمُ الْأَقَارِبُ فِي النَّسَبِ مِنْ جِهَةِ الْأَبِ وَالْأُمِّ، الْأَقْرَبُ فَالْأَقْرَبُ، وَالْوَاجِبُ مِنْ ذَلِكَ: كُلُّ أُنْثَى يَحْرُمُ نِكَاحُهَا مِنْ جِهَةِ النَّسَبِ، وَكُلُّ رَجُلٍ لَوْ كَانَ أُنْثَى حَرُمَ نِكَاحُهُ مِنْ جِهَةِ النَّسَبِ، وَأَعْظَمُهُمُ الْوَالِدَانِ.</td><td></td><td>u5/u5l17/summary</td><td>#/lesson/u5/u5l17</td></tr><tr class="p-med"><td>199</td><td>الأخلاق</td><td>الصدق</td><td>خلاصة الدرس</td><td>• أمر الله بالصدق ومصاحبة الصادقين.<br>• الصدق يهدي إلى البرّ، والبرّ يهدي إلى الجنة.<br>• الكذب يهدي إلى الفجور، والفجور يهدي إلى النار.</td><td>صياغة تعليمية مساعدة</td><td>59</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الصِّدْقَ يَهْدِي إِلَى الْبِرِّ، وَإِنَّ الْبِرَّ يَهْدِي إِلَى الْجَنَّةِ، وَإِنَّ الرَّجُلَ لَيَصْدُقُ حَتَّى يَكُونَ صِدِّيقًا. وَإِنَّ الْكَذِبَ يَهْدِي إِلَى الْفُجُورِ، وَإِنَّ الْفُجُورَ يَهْدِي إِلَى النَّارِ، وَإِنَّ الرَّجُلَ لَيَكْذِبُ حَتَّى يُكْتَبَ عِنْدَ اللهِ كَذَّابًا»</td><td></td><td>u6/u6l1/summary</td><td>#/lesson/u6/u6l1</td></tr><tr class="p-med"><td>204</td><td>الأخلاق</td><td>الصبر</td><td>خلاصة الدرس</td><td>• ﴿إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُمْ بِغَيْرِ حِسَابٍ﴾.<br>• من يتصبّر يصبّره الله.<br>• الصبر أوسع عطاء أُعطيه أحد.</td><td>صياغة تعليمية مساعدة</td><td>59</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«وَمَنْ يَتَصَبَّرْ يُصَبِّرْهُ اللهُ، وَمَا أُعْطِيَ أَحَدٌ عَطَاءً خَيْرًا وَأَوْسَعَ مِنَ الصَّبْرِ»</td><td></td><td>u6/u6l2/summary</td><td>#/lesson/u6/u6l2</td></tr><tr class="p-med"><td>208</td><td>الأخلاق</td><td>الأمانة</td><td>خلاصة الدرس</td><td>• أمر الله بأداء الأمانات إلى أهلها.<br>• آية المنافق ثلاث: إذا حدّث كذب، وإذا وعد أخلف، وإذا اؤتمن خان.</td><td>صياغة تعليمية مساعدة</td><td>60</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«آيَةُ الْمُنَافِقِ ثَلَاثٌ: إِذَا حَدَّثَ كَذَبَ، وَإِذَا وَعَدَ أَخْلَفَ، وَإِذَا اؤْتُمِنَ خَانَ»</td><td></td><td>u6/u6l3/summary</td><td>#/lesson/u6/u6l3</td></tr><tr class="p-med"><td>210</td><td>الأخلاق</td><td>الأمانة</td><td>موقف تطبيقي (داخل الدرس)</td><td>استُودِعت مبلغًا لصاحبه وطلبه منك. ما مقتضى الآية؟<br>✔ أؤدّي الأمانة إلى أهلها<br>— أؤخّرها حتى أستفيد منها<br>— أعطيه بعضها<br>— أعتذر بالنسيان<br>التفسير: ﴿إِنَّ اللَّهَ يَأْمُرُكُمْ أَنْ تُؤَدُّوا الْأَمَانَاتِ إِلَىٰ أَهْلِهَا﴾.</td><td>صياغة تعليمية مساعدة</td><td>60</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«آيَةُ الْمُنَافِقِ ثَلَاثٌ: إِذَا حَدَّثَ كَذَبَ، وَإِذَا وَعَدَ أَخْلَفَ، وَإِذَا اؤْتُمِنَ خَانَ»</td><td></td><td>u6/u6l3/interaction/i2</td><td>#/lesson/u6/u6l3</td></tr><tr class="p-med"><td>213</td><td>الأخلاق</td><td>العفاف</td><td>خلاصة الدرس</td><td>• العفاف: الكفّ عما لا يحلّ، ومن أخطره الشهوات المحرمة.<br>• قصة يوسف عليه السلام مثالٌ قرآني للعفاف.<br>• كان النبي ﷺ يسأل الله الهدى والتقى والعفاف والغنى.</td><td>صياغة تعليمية مساعدة</td><td>60</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ الْكَفُّ عَمَّا لَا يَحِلُّ، وَمِنْ أَخْطَرِهِ الشَّهَوَاتُ الْمُحَرَّمَةُ.</td><td></td><td>u6/u6l4/summary</td><td>#/lesson/u6/u6l4</td></tr><tr class="p-med"><td>217</td><td>الأخلاق</td><td>الحياء</td><td>خلاصة الدرس</td><td>• الحياء من الإيمان.<br>• استدلّ الكتاب بآية الأحزاب في أدب الدخول على بيوت النبي ﷺ.</td><td>صياغة تعليمية مساعدة</td><td>61</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الْحَيَاءَ مِنَ الْإِيمَانِ»</td><td></td><td>u6/u6l5/summary</td><td>#/lesson/u6/u6l5</td></tr><tr class="p-med"><td>221</td><td>الأخلاق</td><td>الشجاعة</td><td>خلاصة الدرس</td><td>• ﴿وَلَا تَهِنُوا وَلَا تَحْزَنُوا وَأَنْتُمُ الْأَعْلَوْنَ إِنْ كُنْتُمْ مُؤْمِنِينَ﴾.<br>• كان النبي ﷺ أحسن الناس وأشجع الناس وأجود الناس.<br>• وسبق أهل المدينة إلى مصدر الفزع على فرس.</td><td>صياغة تعليمية مساعدة</td><td>61</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>كَانَ النَّبِيُّ ﷺ أَحْسَنَ النَّاسِ وَأَشْجَعَ النَّاسِ وَأَجْوَدَ النَّاسِ، وَلَقَدْ فَزِعَ أَهْلُ الْمَدِينَةِ، فَكَانَ النَّبِيُّ ﷺ سَبَقَهُمْ عَلَى فَرَسٍ.</td><td></td><td>u6/u6l6/summary</td><td>#/lesson/u6/u6l6</td></tr><tr class="p-med"><td>223</td><td>الأخلاق</td><td>الشجاعة</td><td>interaction:complete</td><td>أكمل وصف أنس رضي الله عنه للنبي ﷺ.<br>✔ أَشْجَعَ<br>— أَعْلَمَ<br>— أَزْهَدَ<br>— أَحْلَمَ<br>التفسير: لفظ الحديث في الكتاب: «أَحْسَنَ النَّاسِ وَأَشْجَعَ النَّاسِ وَأَجْوَدَ النَّاسِ».</td><td>صياغة تعليمية مساعدة</td><td>61</td><td>إكمال نصّ بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد مطابقة النصّ للكتاب وسلامة الخيارات.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>كَانَ النَّبِيُّ ﷺ أَحْسَنَ النَّاسِ وَأَشْجَعَ النَّاسِ وَأَجْوَدَ النَّاسِ، وَلَقَدْ فَزِعَ أَهْلُ الْمَدِينَةِ، فَكَانَ النَّبِيُّ ﷺ سَبَقَهُمْ عَلَى فَرَسٍ.</td><td></td><td>u6/u6l6/interaction/x1</td><td>#/lesson/u6/u6l6</td></tr><tr class="p-med"><td>224</td><td>الأخلاق</td><td>الشجاعة</td><td>interaction:classify</td><td>صنّف الأوصاف بحسب ورودها في حديث أنس رضي الله عنه.<br>التفسير: الحديث في الكتاب ذكر ثلاثة أوصاف فقط: أحسن الناس وأشجع الناس وأجود الناس.</td><td>صياغة تعليمية مساعدة</td><td>61</td><td>تصنيف بصياغة تعليمية مساعدة مستمدّ من نصّ الدرس؛ يحتاج تأكيد أنّ التصنيف مأخوذ من الكتاب لا من اجتهاد.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>كَانَ النَّبِيُّ ﷺ أَحْسَنَ النَّاسِ وَأَشْجَعَ النَّاسِ وَأَجْوَدَ النَّاسِ، وَلَقَدْ فَزِعَ أَهْلُ الْمَدِينَةِ، فَكَانَ النَّبِيُّ ﷺ سَبَقَهُمْ عَلَى فَرَسٍ.</td><td></td><td>u6/u6l6/interaction/x2</td><td>#/lesson/u6/u6l6</td></tr><tr class="p-med"><td>227</td><td>الأخلاق</td><td>الكرم</td><td>خلاصة الدرس</td><td>• ﴿وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ﴾ من صفات المؤمنين حقًّا.<br>• إنّ الله كريم يحبّ الكرم، ويحبّ معالي الأخلاق، ويكره سفسافها.</td><td>صياغة تعليمية مساعدة</td><td>62</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ اللهَ كَرِيمٌ يُحِبُّ الْكَرَمَ، وَيُحِبُّ مَعَالِيَ الْأَخْلَاقِ، وَيَكْرَهُ سَفْسَافَهَا»</td><td></td><td>u6/u6l7/summary</td><td>#/lesson/u6/u6l7</td></tr><tr class="p-med"><td>231</td><td>الأخلاق</td><td>الوفاء</td><td>خلاصة الدرس</td><td>• ﴿وَأَوْفُوا بِالْعَهْدِ ۖ إِنَّ الْعَهْدَ كَانَ مَسْئُولًا﴾.<br>• أربع من كنّ فيه كان منافقًا خالصًا: الخيانة، والكذب، والغدر، والفجور في الخصومة.</td><td>صياغة تعليمية مساعدة</td><td>62</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«أَرْبَعٌ مَنْ كُنَّ فِيهِ كَانَ مُنَافِقًا خَالِصًا، وَمَنْ كَانَتْ فِيهِ خَصْلَةٌ مِنْهُنَّ كَانَتْ فِيهِ خَصْلَةٌ مِنَ النِّفَاقِ حَتَّى يَدَعَهَا: إِذَا اؤْتُمِنَ خَانَ، وَإِذَا حَدَّثَ كَذَبَ، وَإِذَا عَاهَدَ غَدَرَ، وَإِذَا خَاصَمَ فَجَرَ»</td><td></td><td>u6/u6l8/summary</td><td>#/lesson/u6/u6l8</td></tr><tr class="p-med"><td>235</td><td>الأخلاق</td><td>حسن الجوار</td><td>خلاصة الدرس</td><td>• أمرت الآية بالإحسان إلى الجار ذي القربى والجار الجنب والصاحب بالجنب.<br>• ما زال جبريل يوصي النبي ﷺ بالجار حتى ظنّ أنه سيورّثه.</td><td>صياغة تعليمية مساعدة</td><td>63</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«مَا زَالَ جِبْرِيلُ يُوصِينِي بِالْجَارِ حَتَّى ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُ»</td><td></td><td>u6/u6l9/summary</td><td>#/lesson/u6/u6l9</td></tr><tr class="p-med"><td>240</td><td>الأخلاق</td><td>مساعدة ذي الحاجة</td><td>خلاصة الدرس</td><td>• ﴿وَافْعَلُوا الْخَيْرَ لَعَلَّكُمْ تُفْلِحُونَ﴾.<br>• من نفّس كربة نفّس الله عنه، ومن يسّر على معسر يسّر الله عليه.<br>• والله في عون العبد ما كان العبد في عون أخيه.</td><td>صياغة تعليمية مساعدة</td><td>63</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«مَنْ نَفَّسَ عَنْ مُؤْمِنٍ كُرْبَةً مِنْ كُرَبِ الدُّنْيَا، نَفَّسَ اللهُ عَنْهُ كُرْبَةً مِنْ كُرَبِ يَوْمِ الْقِيَامَةِ، وَمَنْ يَسَّرَ عَلَى مُعْسِرٍ، يَسَّرَ اللهُ عَلَيْهِ فِي الدُّنْيَا وَالْآخِرَةِ، وَمَنْ سَتَرَ مُسْلِمًا، سَتَرَهُ اللهُ فِي الدُّنْيَا وَالْآخِرَةِ، وَاللهُ فِي عَوْنِ الْعَبْدِ مَا كَانَ الْعَبْدُ فِي عَوْنِ أَخِيهِ»</td><td></td><td>u6/u6l10/summary</td><td>#/lesson/u6/u6l10</td></tr><tr class="p-med"><td>244</td><td>الرقائق</td><td>الخوف والرجاء</td><td>خلاصة الدرس</td><td>• ﴿نَبِّئْ عِبَادِي أَنِّي أَنَا الْغَفُورُ الرَّحِيمُ ۝ وَأَنَّ عَذَابِي هُوَ الْعَذَابُ الْأَلِيمُ﴾.<br>• الحديث يجمع بين سعة رحمة الله وشدة عقوبته.</td><td>صياغة تعليمية مساعدة</td><td>67</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«لَوْ يَعْلَمُ الْمُؤْمِنُ مَا عِنْدَ اللهِ مِنَ الْعُقُوبَةِ، مَا طَمِعَ بِجَنَّتِهِ أَحَدٌ، وَلَوْ يَعْلَمُ الْكَافِرُ مَا عِنْدَ اللهِ مِنَ الرَّحْمَةِ، مَا قَنَطَ مِنْ جَنَّتِهِ أَحَدٌ»</td><td></td><td>u7/u7l1/summary</td><td>#/lesson/u7/u7l1</td></tr><tr class="p-med"><td>248</td><td>الرقائق</td><td>الصحة والفراغ</td><td>خلاصة الدرس</td><td>• ﴿وَإِنْ تَعُدُّوا نِعْمَتَ اللَّهِ لَا تُحْصُوهَا﴾.<br>• نعمتان مغبون فيهما كثير من الناس: الصحة والفراغ.</td><td>صياغة تعليمية مساعدة</td><td>67</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«نِعْمَتَانِ مَغْبُونٌ فِيهِمَا كَثِيرٌ مِنَ النَّاسِ: الصِّحَّةُ وَالْفَرَاغُ»</td><td></td><td>u7/u7l2/summary</td><td>#/lesson/u7/u7l2</td></tr><tr class="p-med"><td>253</td><td>الرقائق</td><td>المبادرة بالأعمال الصالحة</td><td>خلاصة الدرس</td><td>• بادروا بالأعمال فتنًا كقطع الليل المظلم، يبيع الرجل فيها دينه بعرض من الدنيا.</td><td>صياغة تعليمية مساعدة</td><td>67</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«بَادِرُوا بِالْأَعْمَالِ، فِتَنًا كَقِطَعِ اللَّيْلِ الْمُظْلِمِ، يُصْبِحُ الرَّجُلُ مُؤْمِنًا وَيُمْسِي كَافِرًا، أَوْ يُمْسِي مُؤْمِنًا وَيُصْبِحُ كَافِرًا، يَبِيعُ دِينَهُ بِعَرَضٍ مِنَ الدُّنْيَا»</td><td></td><td>u7/u7l3/summary</td><td>#/lesson/u7/u7l3</td></tr><tr class="p-med"><td>254</td><td>الرقائق</td><td>المبادرة بالأعمال الصالحة</td><td>interaction:order</td><td>رتّب معاني الحديث كما وردت في لفظه.<br>التفسير: هذا ترتيب لفظ الحديث كما أورده الكتاب.</td><td>صياغة تعليمية مساعدة</td><td>67</td><td>ترتيب خطوات بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد أنّ الترتيب ثابت في نصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«بَادِرُوا بِالْأَعْمَالِ، فِتَنًا كَقِطَعِ اللَّيْلِ الْمُظْلِمِ، يُصْبِحُ الرَّجُلُ مُؤْمِنًا وَيُمْسِي كَافِرًا، أَوْ يُمْسِي مُؤْمِنًا وَيُصْبِحُ كَافِرًا، يَبِيعُ دِينَهُ بِعَرَضٍ مِنَ الدُّنْيَا»</td><td></td><td>u7/u7l3/interaction/x1</td><td>#/lesson/u7/u7l3</td></tr><tr class="p-med"><td>255</td><td>الرقائق</td><td>المبادرة بالأعمال الصالحة</td><td>interaction:complete</td><td>أكمل لفظ الحديث.<br>✔ الْمُظْلِمِ<br>— الطَّوِيلِ<br>— الْبَارِدِ<br>— الْأَخِيرِ<br>التفسير: لفظ الحديث: «فِتَنًا كَقِطَعِ اللَّيْلِ الْمُظْلِمِ».</td><td>صياغة تعليمية مساعدة</td><td>67</td><td>إكمال نصّ بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد مطابقة النصّ للكتاب وسلامة الخيارات.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«بَادِرُوا بِالْأَعْمَالِ، فِتَنًا كَقِطَعِ اللَّيْلِ الْمُظْلِمِ، يُصْبِحُ الرَّجُلُ مُؤْمِنًا وَيُمْسِي كَافِرًا، أَوْ يُمْسِي مُؤْمِنًا وَيُصْبِحُ كَافِرًا، يَبِيعُ دِينَهُ بِعَرَضٍ مِنَ الدُّنْيَا»</td><td></td><td>u7/u7l3/interaction/x2</td><td>#/lesson/u7/u7l3</td></tr><tr class="p-med"><td>258</td><td>الرقائق</td><td>عابر سبيل</td><td>خلاصة الدرس</td><td>• «كن في الدنيا كأنك غريب أو عابر سبيل».<br>• وكان ابن عمر يقول: إذا أمسيت فلا تنتظر الصباح... وخذ من صحتك لمرضك، ومن حياتك لموتك.</td><td>صياغة تعليمية مساعدة</td><td>68</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«كُنْ فِي الدُّنْيَا كَأَنَّكَ غَرِيبٌ أَوْ عَابِرُ سَبِيلٍ»</td><td></td><td>u7/u7l4/summary</td><td>#/lesson/u7/u7l4</td></tr><tr class="p-med"><td>259</td><td>الرقائق</td><td>عابر سبيل</td><td>interaction:match</td><td>طابِق بين شطرَي وصية ابن عمر رضي الله عنهما.<br>التفسير: هذا نصّ قول ابن عمر رضي الله عنهما كما أورده الكتاب.</td><td>صياغة تعليمية مساعدة</td><td>68</td><td>مطابقة بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد صحّة الأزواج ومطابقتها لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«كُنْ فِي الدُّنْيَا كَأَنَّكَ غَرِيبٌ أَوْ عَابِرُ سَبِيلٍ»</td><td></td><td>u7/u7l4/interaction/x1</td><td>#/lesson/u7/u7l4</td></tr><tr class="p-med"><td>260</td><td>الرقائق</td><td>عابر سبيل</td><td>موقف تطبيقي (داخل الدرس)</td><td>همَمْتَ بعمل صالح ثم قلت: أؤجّله إلى الغد. أيّ شطر من وصية ابن عمر رضي الله عنهما يخاطب حالك؟<br>✔ «إِذَا أَصْبَحْتَ فَلَا تَنْتَظِرِ الْمَسَاءَ»<br>— «كُنْ فِي الدُّنْيَا كَأَنَّكَ غَرِيبٌ»<br>— «وَخُذْ مِنْ صِحَّتِكَ لِمَرَضِكَ»<br>— «وَمِنْ حَيَاتِكَ لِمَوْتِكَ»<br>التفسير: وصية ابن عمر في الكتاب تنهى عن انتظار الوقت التالي: «إِذَا أَمْسَيْتَ فَلَا تَنْتَظِرِ الصَّبَاحَ، وَإِذَا أَصْبَحْتَ فَلَا تَنْتَظِرِ الْمَسَاءَ».</td><td>صياغة تعليمية مساعدة</td><td>68</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«كُنْ فِي الدُّنْيَا كَأَنَّكَ غَرِيبٌ أَوْ عَابِرُ سَبِيلٍ»</td><td></td><td>u7/u7l4/interaction/x2</td><td>#/lesson/u7/u7l4</td></tr><tr class="p-med"><td>263</td><td>الرقائق</td><td>الصور والأعمال</td><td>خلاصة الدرس</td><td>• إنّ الله لا ينظر إلى صوركم وأموالكم، ولكن ينظر إلى قلوبكم وأعمالكم.</td><td>صياغة تعليمية مساعدة</td><td>68</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ اللهَ لَا يَنْظُرُ إِلَى صُوَرِكُمْ وَأَمْوَالِكُمْ، وَلَكِنْ يَنْظُرُ إِلَى قُلُوبِكُمْ وَأَعْمَالِكُمْ»</td><td></td><td>u7/u7l5/summary</td><td>#/lesson/u7/u7l5</td></tr><tr class="p-med"><td>264</td><td>الرقائق</td><td>الصور والأعمال</td><td>interaction:classify</td><td>صنّف بحسب الحديث.<br>التفسير: لفظ الحديث: «إِنَّ اللهَ لَا يَنْظُرُ إِلَى صُوَرِكُمْ وَأَمْوَالِكُمْ، وَلَكِنْ يَنْظُرُ إِلَى قُلُوبِكُمْ وَأَعْمَالِكُمْ».</td><td>صياغة تعليمية مساعدة</td><td>68</td><td>تصنيف بصياغة تعليمية مساعدة مستمدّ من نصّ الدرس؛ يحتاج تأكيد أنّ التصنيف مأخوذ من الكتاب لا من اجتهاد.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ اللهَ لَا يَنْظُرُ إِلَى صُوَرِكُمْ وَأَمْوَالِكُمْ، وَلَكِنْ يَنْظُرُ إِلَى قُلُوبِكُمْ وَأَعْمَالِكُمْ»</td><td></td><td>u7/u7l5/interaction/x1</td><td>#/lesson/u7/u7l5</td></tr><tr class="p-med"><td>265</td><td>الرقائق</td><td>الصور والأعمال</td><td>interaction:complete</td><td>أكمل لفظ الحديث.<br>✔ قُلُوبِكُمْ<br>— نِيَّاتِكُمْ<br>— أَحْوَالِكُمْ<br>— سَرَائِرِكُمْ<br>التفسير: لفظ الحديث في الكتاب: «وَلَكِنْ يَنْظُرُ إِلَى قُلُوبِكُمْ وَأَعْمَالِكُمْ».</td><td>صياغة تعليمية مساعدة</td><td>68</td><td>إكمال نصّ بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد مطابقة النصّ للكتاب وسلامة الخيارات.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ اللهَ لَا يَنْظُرُ إِلَى صُوَرِكُمْ وَأَمْوَالِكُمْ، وَلَكِنْ يَنْظُرُ إِلَى قُلُوبِكُمْ وَأَعْمَالِكُمْ»</td><td></td><td>u7/u7l5/interaction/x2</td><td>#/lesson/u7/u7l5</td></tr><tr class="p-med"><td>268</td><td>الرقائق</td><td>لا يتبعك إلا عملك</td><td>خلاصة الدرس</td><td>• يتبع الميت ثلاثة: أهله وماله وعمله، فيرجع أهله وماله ويبقى عمله.</td><td>صياغة تعليمية مساعدة</td><td>68</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«يَتْبَعُ الْمَيِّتَ ثَلَاثَةٌ، فَيَرْجِعُ اثْنَانِ وَيَبْقَى وَاحِدٌ، يَتْبَعُهُ أَهْلُهُ وَمَالُهُ وَعَمَلُهُ، فَيَرْجِعُ أَهْلُهُ وَمَالُهُ وَيَبْقَى عَمَلُهُ»</td><td></td><td>u7/u7l6/summary</td><td>#/lesson/u7/u7l6</td></tr><tr class="p-med"><td>269</td><td>الرقائق</td><td>لا يتبعك إلا عملك</td><td>interaction:classify</td><td>صنّف الثلاثة الذين يتبعون الميت.<br>التفسير: لفظ الحديث: «فَيَرْجِعُ أَهْلُهُ وَمَالُهُ وَيَبْقَى عَمَلُهُ».</td><td>صياغة تعليمية مساعدة</td><td>68</td><td>تصنيف بصياغة تعليمية مساعدة مستمدّ من نصّ الدرس؛ يحتاج تأكيد أنّ التصنيف مأخوذ من الكتاب لا من اجتهاد.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«يَتْبَعُ الْمَيِّتَ ثَلَاثَةٌ، فَيَرْجِعُ اثْنَانِ وَيَبْقَى وَاحِدٌ، يَتْبَعُهُ أَهْلُهُ وَمَالُهُ وَعَمَلُهُ، فَيَرْجِعُ أَهْلُهُ وَمَالُهُ وَيَبْقَى عَمَلُهُ»</td><td></td><td>u7/u7l6/interaction/x1</td><td>#/lesson/u7/u7l6</td></tr><tr class="p-med"><td>270</td><td>الرقائق</td><td>لا يتبعك إلا عملك</td><td>interaction:complete</td><td>أكمل لفظ الحديث.<br>✔ ثَلَاثَةٌ<br>— اثْنَانِ<br>— أَرْبَعَةٌ<br>— وَاحِدٌ<br>التفسير: لفظ الحديث: «يَتْبَعُ الْمَيِّتَ ثَلَاثَةٌ».</td><td>صياغة تعليمية مساعدة</td><td>68</td><td>إكمال نصّ بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد مطابقة النصّ للكتاب وسلامة الخيارات.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«يَتْبَعُ الْمَيِّتَ ثَلَاثَةٌ، فَيَرْجِعُ اثْنَانِ وَيَبْقَى وَاحِدٌ، يَتْبَعُهُ أَهْلُهُ وَمَالُهُ وَعَمَلُهُ، فَيَرْجِعُ أَهْلُهُ وَمَالُهُ وَيَبْقَى عَمَلُهُ»</td><td></td><td>u7/u7l6/interaction/x2</td><td>#/lesson/u7/u7l6</td></tr><tr class="p-med"><td>273</td><td>الرقائق</td><td>برحمة الله لا بالعمل</td><td>خلاصة الدرس</td><td>• سدّدوا وقاربوا وأبشروا، فإنه لن يُدخل الجنة أحدًا عمله.<br>• «ولا أنا، إلا أن يتغمّدني الله منه برحمة».<br>• أحبّ العمل إلى الله أدومه وإن قلّ.</td><td>صياغة تعليمية مساعدة</td><td>69</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«سَدِّدُوا وَقَارِبُوا، وَأَبْشِرُوا، فَإِنَّهُ لَنْ يُدْخِلَ الْجَنَّةَ أَحَدًا عَمَلُهُ» قَالُوا: وَلَا أَنْتَ يَا رَسُولَ اللهِ؟ قَالَ: «وَلَا أَنَا، إِلَّا أَنْ يَتَغَمَّدَنِيَ اللهُ مِنْهُ بِرَحْمَةٍ، وَاعْلَمُوا أَنَّ أَحَبَّ الْعَمَلِ إِلَى اللهِ أَدْوَمُهُ وَإِنْ قَلَّ»</td><td></td><td>u7/u7l7/summary</td><td>#/lesson/u7/u7l7</td></tr><tr class="p-med"><td>275</td><td>الرقائق</td><td>برحمة الله لا بالعمل</td><td>موقف تطبيقي (داخل الدرس)</td><td>تريد أن تبدأ وردًا من القرآن. أيّ اختيار يوافق الحديث؟<br>✔ صفحة واحدة كل يوم أداوم عليها<br>— جزء كامل يومًا ثم أنقطع أسبوعًا<br>— أؤجّل حتى أتفرّغ<br>— أقرأ عشرة أجزاء في يوم واحد فقط<br>التفسير: لأنّ أحبّ العمل إلى الله أدومه وإن قلّ.</td><td>صياغة تعليمية مساعدة</td><td>69</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«سَدِّدُوا وَقَارِبُوا، وَأَبْشِرُوا، فَإِنَّهُ لَنْ يُدْخِلَ الْجَنَّةَ أَحَدًا عَمَلُهُ» قَالُوا: وَلَا أَنْتَ يَا رَسُولَ اللهِ؟ قَالَ: «وَلَا أَنَا، إِلَّا أَنْ يَتَغَمَّدَنِيَ اللهُ مِنْهُ بِرَحْمَةٍ، وَاعْلَمُوا أَنَّ أَحَبَّ الْعَمَلِ إِلَى اللهِ أَدْوَمُهُ وَإِنْ قَلَّ»</td><td></td><td>u7/u7l7/interaction/i2</td><td>#/lesson/u7/u7l7</td></tr><tr class="p-med"><td>276</td><td>الرقائق</td><td>برحمة الله لا بالعمل</td><td>interaction:complete</td><td>أكمل خاتمة الحديث.<br>✔ أَدْوَمُهُ<br>— أَكْثَرُهُ<br>— أَشَقُّهُ<br>— أَخْفَاهُ<br>التفسير: لفظ الحديث: «أَنَّ أَحَبَّ الْعَمَلِ إِلَى اللهِ أَدْوَمُهُ وَإِنْ قَلَّ».</td><td>صياغة تعليمية مساعدة</td><td>69</td><td>إكمال نصّ بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد مطابقة النصّ للكتاب وسلامة الخيارات.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«سَدِّدُوا وَقَارِبُوا، وَأَبْشِرُوا، فَإِنَّهُ لَنْ يُدْخِلَ الْجَنَّةَ أَحَدًا عَمَلُهُ» قَالُوا: وَلَا أَنْتَ يَا رَسُولَ اللهِ؟ قَالَ: «وَلَا أَنَا، إِلَّا أَنْ يَتَغَمَّدَنِيَ اللهُ مِنْهُ بِرَحْمَةٍ، وَاعْلَمُوا أَنَّ أَحَبَّ الْعَمَلِ إِلَى اللهِ أَدْوَمُهُ وَإِنْ قَلَّ»</td><td></td><td>u7/u7l7/interaction/x1</td><td>#/lesson/u7/u7l7</td></tr><tr class="p-med"><td>277</td><td>الرقائق</td><td>برحمة الله لا بالعمل</td><td>interaction:order</td><td>رتّب أوائل الحديث كما وردت في لفظه.<br>التفسير: لفظ الحديث في الكتاب: «سَدِّدُوا وَقَارِبُوا، وَأَبْشِرُوا».</td><td>صياغة تعليمية مساعدة</td><td>69</td><td>ترتيب خطوات بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد أنّ الترتيب ثابت في نصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«سَدِّدُوا وَقَارِبُوا، وَأَبْشِرُوا، فَإِنَّهُ لَنْ يُدْخِلَ الْجَنَّةَ أَحَدًا عَمَلُهُ» قَالُوا: وَلَا أَنْتَ يَا رَسُولَ اللهِ؟ قَالَ: «وَلَا أَنَا، إِلَّا أَنْ يَتَغَمَّدَنِيَ اللهُ مِنْهُ بِرَحْمَةٍ، وَاعْلَمُوا أَنَّ أَحَبَّ الْعَمَلِ إِلَى اللهِ أَدْوَمُهُ وَإِنْ قَلَّ»</td><td></td><td>u7/u7l7/interaction/x2</td><td>#/lesson/u7/u7l7</td></tr><tr class="p-med"><td>280</td><td>الرقائق</td><td>رحمة الله</td><td>خلاصة الدرس</td><td>• ﴿وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ﴾.<br>• ﴿لَا تَقْنَطُوا مِنْ رَحْمَةِ اللَّهِ ۚ إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا﴾.<br>• «لَلهُ أَرْحَمُ بِعِبَادِهِ مِنْ هَذِهِ بِوَلَدِهَا».</td><td>صياغة تعليمية مساعدة</td><td>69</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>قُدِمَ عَلَى رَسُولِ اللهِ ﷺ بِسَبْيٍ فَإِذَا امْرَأَةٌ مِنَ السَّبْيِ تَبْتَغِي، إِذَا وَجَدَتْ صَبِيًّا فِي السَّبْيِ، أَخَذَتْهُ فَأَلْصَقَتْهُ بِبَطْنِهَا وَأَرْضَعَتْهُ، فَقَالَ لَنَا رَسُولُ اللهِ ﷺ: «أَتَرَوْنَ هَذِهِ الْمَرْأَةَ طَارِحَةً وَلَدَهَا فِي النَّارِ؟» قُلْنَا: لَا وَاللهِ، وَهِيَ تَقْدِرُ عَلَى أَلَّا تَطْرَحَهُ، فَقَالَ رَسُولُ اللهِ ﷺ: «لَلهُ أَرْحَمُ بِعِبَادِهِ مِنْ هَذِهِ بِوَلَدِهَا»</td><td></td><td>u7/u7l8/summary</td><td>#/lesson/u7/u7l8</td></tr><tr class="p-med"><td>285</td><td>الرقائق</td><td>فتنة النساء</td><td>خلاصة الدرس</td><td>• إنّ الدنيا حلوة خضرة، والله مستخلفكم فيها فينظر كيف تعملون، وأول فتنة بني إسرائيل كانت في النساء.</td><td>صياغة تعليمية مساعدة</td><td>70</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الدُّنْيَا حُلْوَةٌ خَضِرَةٌ، وَإِنَّ اللهَ مُسْتَخْلِفُكُمْ فِيهَا، فَيَنْظُرُ كَيْفَ تَعْمَلُونَ، فَاتَّقُوا الدُّنْيَا وَاتَّقُوا النِّسَاءَ، فَإِنَّ أَوَّلَ فِتْنَةِ بَنِي إِسْرَائِيلَ كَانَتْ فِي النِّسَاءِ»</td><td></td><td>u7/u7l9/summary</td><td>#/lesson/u7/u7l9</td></tr><tr class="p-med"><td>286</td><td>الرقائق</td><td>فتنة النساء</td><td>interaction:complete</td><td>أكمل أول الحديث.<br>✔ حُلْوَةٌ<br>— زَائِلَةٌ<br>— قَلِيلَةٌ<br>— غَرَّارَةٌ<br>التفسير: لفظ الحديث: «إِنَّ الدُّنْيَا حُلْوَةٌ خَضِرَةٌ».</td><td>صياغة تعليمية مساعدة</td><td>70</td><td>إكمال نصّ بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد مطابقة النصّ للكتاب وسلامة الخيارات.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الدُّنْيَا حُلْوَةٌ خَضِرَةٌ، وَإِنَّ اللهَ مُسْتَخْلِفُكُمْ فِيهَا، فَيَنْظُرُ كَيْفَ تَعْمَلُونَ، فَاتَّقُوا الدُّنْيَا وَاتَّقُوا النِّسَاءَ، فَإِنَّ أَوَّلَ فِتْنَةِ بَنِي إِسْرَائِيلَ كَانَتْ فِي النِّسَاءِ»</td><td></td><td>u7/u7l9/interaction/x1</td><td>#/lesson/u7/u7l9</td></tr><tr class="p-med"><td>287</td><td>الرقائق</td><td>فتنة النساء</td><td>interaction:match</td><td>طابِق بين الجملة وتمامها في الحديث.<br>التفسير: هذا لفظ الحديث كما رواه مسلم في الكتاب.</td><td>صياغة تعليمية مساعدة</td><td>70</td><td>مطابقة بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد صحّة الأزواج ومطابقتها لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الدُّنْيَا حُلْوَةٌ خَضِرَةٌ، وَإِنَّ اللهَ مُسْتَخْلِفُكُمْ فِيهَا، فَيَنْظُرُ كَيْفَ تَعْمَلُونَ، فَاتَّقُوا الدُّنْيَا وَاتَّقُوا النِّسَاءَ، فَإِنَّ أَوَّلَ فِتْنَةِ بَنِي إِسْرَائِيلَ كَانَتْ فِي النِّسَاءِ»</td><td></td><td>u7/u7l9/interaction/x2</td><td>#/lesson/u7/u7l9</td></tr><tr class="p-med"><td>290</td><td>الرقائق</td><td>فتنة المال</td><td>خلاصة الدرس</td><td>• ما الفقر أخشى عليكم، ولكن أخشى أن تُبسط الدنيا عليكم فتتنافسوها وتهلككم.</td><td>صياغة تعليمية مساعدة</td><td>70</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«وَاللهِ مَا الْفَقْرَ أَخْشَى عَلَيْكُمْ، وَلَكِنِّي أَخْشَى أَنْ تُبْسَطَ الدُّنْيَا عَلَيْكُمْ، كَمَا بُسِطَتْ عَلَى مَنْ كَانَ قَبْلَكُمْ، فَتَنَافَسُوهَا كَمَا تَنَافَسُوهَا، وَتُهْلِكَكُمْ كَمَا أَهْلَكَتْهُمْ»</td><td></td><td>u7/u7l10/summary</td><td>#/lesson/u7/u7l10</td></tr><tr class="p-med"><td>291</td><td>الرقائق</td><td>فتنة المال</td><td>interaction:classify</td><td>صنّف بحسب الحديث.<br>التفسير: لفظ الحديث: «مَا الْفَقْرَ أَخْشَى عَلَيْكُمْ، وَلَكِنِّي أَخْشَى أَنْ تُبْسَطَ الدُّنْيَا عَلَيْكُمْ… فَتَنَافَسُوهَا كَمَا تَنَافَسُوهَا».</td><td>صياغة تعليمية مساعدة</td><td>70</td><td>تصنيف بصياغة تعليمية مساعدة مستمدّ من نصّ الدرس؛ يحتاج تأكيد أنّ التصنيف مأخوذ من الكتاب لا من اجتهاد.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«وَاللهِ مَا الْفَقْرَ أَخْشَى عَلَيْكُمْ، وَلَكِنِّي أَخْشَى أَنْ تُبْسَطَ الدُّنْيَا عَلَيْكُمْ، كَمَا بُسِطَتْ عَلَى مَنْ كَانَ قَبْلَكُمْ، فَتَنَافَسُوهَا كَمَا تَنَافَسُوهَا، وَتُهْلِكَكُمْ كَمَا أَهْلَكَتْهُمْ»</td><td></td><td>u7/u7l10/interaction/x1</td><td>#/lesson/u7/u7l10</td></tr><tr class="p-med"><td>292</td><td>الرقائق</td><td>فتنة المال</td><td>interaction:complete</td><td>أكمل أول الحديث.<br>✔ الْفَقْرَ<br>— الْمَرَضَ<br>— الْعَدُوَّ<br>— الْجَهْلَ<br>التفسير: لفظ الحديث: «وَاللهِ مَا الْفَقْرَ أَخْشَى عَلَيْكُمْ».</td><td>صياغة تعليمية مساعدة</td><td>70</td><td>إكمال نصّ بصياغة تعليمية مساعدة مستمدّة من نصّ الدرس؛ يحتاج تأكيد مطابقة النصّ للكتاب وسلامة الخيارات.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«وَاللهِ مَا الْفَقْرَ أَخْشَى عَلَيْكُمْ، وَلَكِنِّي أَخْشَى أَنْ تُبْسَطَ الدُّنْيَا عَلَيْكُمْ، كَمَا بُسِطَتْ عَلَى مَنْ كَانَ قَبْلَكُمْ، فَتَنَافَسُوهَا كَمَا تَنَافَسُوهَا، وَتُهْلِكَكُمْ كَمَا أَهْلَكَتْهُمْ»</td><td></td><td>u7/u7l10/interaction/x2</td><td>#/lesson/u7/u7l10</td></tr><tr class="p-med"><td>295</td><td>الرقائق</td><td>المجاهدة</td><td>خلاصة الدرس</td><td>• ﴿وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا﴾.<br>• حُجبت النار بالشهوات، وحُجبت الجنة بالمكاره.</td><td>صياغة تعليمية مساعدة</td><td>70</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«حُجِبَتِ النَّارُ بِالشَّهَوَاتِ، وَحُجِبَتِ الْجَنَّةُ بِالْمَكَارِهِ»</td><td></td><td>u7/u7l11/summary</td><td>#/lesson/u7/u7l11</td></tr><tr class="p-med"><td>298</td><td>الرقائق</td><td>المجاهدة</td><td>interaction:truefalse</td><td>في الحديث: حُجبت النار بالمكاره، وحُجبت الجنة بالشهوات.<br>— صحيح<br>✔ خطأ<br>التفسير: اللفظ بعكس ذلك: «حُجِبَتِ النَّارُ بِالشَّهَوَاتِ، وَحُجِبَتِ الْجَنَّةُ بِالْمَكَارِهِ».</td><td>صياغة تعليمية مساعدة</td><td>71</td><td>صحيح/خطأ بصياغة تعليمية مساعدة مستمدّ من نصّ الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«حُجِبَتِ النَّارُ بِالشَّهَوَاتِ، وَحُجِبَتِ الْجَنَّةُ بِالْمَكَارِهِ»</td><td></td><td>u7/u7l11/interaction/x1</td><td>#/lesson/u7/u7l11</td></tr><tr class="p-med"><td>299</td><td>الرقائق</td><td>المجاهدة</td><td>موقف تطبيقي (داخل الدرس)</td><td>شقّت عليك نافلة اعتدتَها في ليلة باردة، فحدّثتك نفسك بتركها. أيّ معنى في هذا الدرس يعينك؟<br>✔ «حُجِبَتِ الْجَنَّةُ بِالْمَكَارِهِ»<br>— «حُجِبَتِ النَّارُ بِالشَّهَوَاتِ»<br>— أنّ النافلة تُترك عند المشقّة<br>— أنّ الأعمال بالنيات<br>التفسير: لفظ الحديث في الكتاب يبيّن أنّ طريق الجنة محفوف بما تكرهه النفس.</td><td>صياغة تعليمية مساعدة</td><td>71</td><td>موقف تطبيقي بصياغة مستحدثة يُعرض داخل الدرس؛ يحتاج تأكيد أنّ الحكم فيه مطابق لنصّ الكتاب.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«حُجِبَتِ النَّارُ بِالشَّهَوَاتِ، وَحُجِبَتِ الْجَنَّةُ بِالْمَكَارِهِ»</td><td></td><td>u7/u7l11/interaction/x2</td><td>#/lesson/u7/u7l11</td></tr><tr class="p-med"><td>302</td><td>الرقائق</td><td>بين حُبّ لقاء الله وكُرهه</td><td>خلاصة الدرس</td><td>• من أحبّ لقاء الله أحبّ الله لقاءه، ومن كره لقاء الله كره الله لقاءه.<br>• ليس المراد كراهية الموت الطبيعية، وإنما ما يكون عند الاحتضار من التبشير.</td><td>صياغة تعليمية مساعدة</td><td>71</td><td>خلاصة مستحدثة تلخّص الدرس؛ يحتاج تأكيد أنها لا تخلّ بمعنى النصّ ولا تختصره اختصالًا مخلًّا.</td><td>متوسطة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«مَنْ أَحَبَّ لِقَاءَ اللهِ أَحَبَّ اللهُ لِقَاءَهُ، وَمَنْ كَرِهَ لِقَاءَ اللهِ كَرِهَ اللهُ لِقَاءَهُ» فَقَالَتْ عَائِشَةُ رضي الله عنها: إِنَّا لَنَكْرَهُ الْمَوْتَ، قَالَ: «لَيْسَ ذَاكِ، وَلَكِنَّ الْمُؤْمِنَ إِذَا حَضَرَهُ الْمَوْتُ بُشِّرَ بِرِضْوَانِ اللهِ وَكَرَامَتِهِ، فَلَيْسَ شَيْءٌ أَحَبَّ إِلَيْهِ مِمَّا أَمَامَهُ، فَأَحَبَّ لِقَاءَ اللهِ وَأَحَبَّ اللهُ لِقَاءَهُ، وَإِنَّ الْكَافِرَ إِذَا حُضِرَ بُشِّرَ بِعَذَابِ اللهِ وَعُقُوبَتِهِ، فَلَيْسَ شَيْءٌ أَكْرَهَ إِلَيْهِ مِمَّا أَمَامَهُ، كَرِهَ لِقَاءَ اللهِ وَكَرِهَ اللهُ لِقَاءَهُ»</td><td></td><td>u7/u7l12/summary</td><td>#/lesson/u7/u7l12</td></tr><tr class="p-low"><td>1</td><td>تفسير ما يتكرر</td><td>الاستعاذة</td><td>مدخل الدرس</td><td>قبل أن تفتح المصحف، هناك جملة واحدة تقولها فتطرد بها عدوًّا لا تراه. ما هي؟ ومَن علَّمك إياها؟</td><td>صياغة تعليمية مساعدة</td><td>7</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>أَعُوذُ بِاللهِ مِنَ الشَّيْطَانِ الرَّجِيمِ</td><td></td><td>u1/u1l1/hook</td><td>#/lesson/u1/u1l1</td></tr><tr class="p-low"><td>2</td><td>تفسير ما يتكرر</td><td>الاستعاذة</td><td>هدف الدرس</td><td>أن تعرف لفظ الاستعاذة ومعناها، ومتى تُقال، وأنها ليست من القرآن.</td><td>صياغة تعليمية مساعدة</td><td>7</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>أَعُوذُ بِاللهِ مِنَ الشَّيْطَانِ الرَّجِيمِ</td><td></td><td>u1/u1l1/objective</td><td>#/lesson/u1/u1l1</td></tr><tr class="p-low"><td>4</td><td>تفسير ما يتكرر</td><td>الاستعاذة</td><td>سؤال النقاش الأسري</td><td>اتّفقوا في البيت على أن يبدأ كل قارئ للقرآن بالاستعاذة بصوت مسموع هذا الأسبوع.</td><td>صياغة تعليمية مساعدة</td><td>7</td><td>اقتراح نشاط أسري مستحدث؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>أَعُوذُ بِاللهِ مِنَ الشَّيْطَانِ الرَّجِيمِ</td><td></td><td>u1/u1l1/family</td><td>#/lesson/u1/u1l1</td></tr><tr class="p-low"><td>6</td><td>تفسير ما يتكرر</td><td>البسملة</td><td>مدخل الدرس</td><td>آيةٌ تقرؤها عشرات المرات كل يوم، وقد يُشكل على كثيرين: هل هي من الفاتحة أم لا؟</td><td>صياغة تعليمية مساعدة</td><td>7</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ آيَةٌ جَاءَتْ لِلْفَصْلِ بَيْنَ السُّوَرِ، فَلَيْسَتْ آيَةً مِنْ سُورَةِ الْفَاتِحَةِ وَلَا مِنْ غَيْرِهَا مِنَ السُّوَرِ.</td><td></td><td>u1/u1l2/hook</td><td>#/lesson/u1/u1l2</td></tr><tr class="p-low"><td>7</td><td>تفسير ما يتكرر</td><td>البسملة</td><td>هدف الدرس</td><td>أن تعرف موضع البسملة من السور، ومعنى ألفاظها الثلاثة.</td><td>صياغة تعليمية مساعدة</td><td>7</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ آيَةٌ جَاءَتْ لِلْفَصْلِ بَيْنَ السُّوَرِ، فَلَيْسَتْ آيَةً مِنْ سُورَةِ الْفَاتِحَةِ وَلَا مِنْ غَيْرِهَا مِنَ السُّوَرِ.</td><td></td><td>u1/u1l2/objective</td><td>#/lesson/u1/u1l2</td></tr><tr class="p-low"><td>11</td><td>تفسير ما يتكرر</td><td>سورة الفاتحة</td><td>مدخل الدرس</td><td>سورة لا تصحّ صلاتك بدونها، تقرؤها في اليوم سبع عشرة مرة على الأقل. فهل تعرف ما تقول؟</td><td>صياغة تعليمية مساعدة</td><td>8</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَجِبُ عَلَى الْمُسْلِمِ أَنْ يَتَعَلَّمَ قِرَاءَةَ سُورَةِ الْفَاتِحَةِ؛ لِأَنَّ الصَّلَاةَ لَا تَصِحُّ إِلَّا بِهَا، وَيَحْسُنُ أَنْ يَتَعَلَّمَ قِرَاءَةَ كِتَابِ اللهِ كَامِلًا، فَإِنْ لَمْ يَكُنْ فَمَا اسْتَطَاعَ مِنْهُ.</td><td></td><td>u1/u1l3/hook</td><td>#/lesson/u1/u1l3</td></tr><tr class="p-low"><td>12</td><td>تفسير ما يتكرر</td><td>سورة الفاتحة</td><td>هدف الدرس</td><td>أن تقرأ الفاتحة بلا خطأ، وتفهم معاني آياتها كما شرحها الكتاب.</td><td>صياغة تعليمية مساعدة</td><td>8</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَجِبُ عَلَى الْمُسْلِمِ أَنْ يَتَعَلَّمَ قِرَاءَةَ سُورَةِ الْفَاتِحَةِ؛ لِأَنَّ الصَّلَاةَ لَا تَصِحُّ إِلَّا بِهَا، وَيَحْسُنُ أَنْ يَتَعَلَّمَ قِرَاءَةَ كِتَابِ اللهِ كَامِلًا، فَإِنْ لَمْ يَكُنْ فَمَا اسْتَطَاعَ مِنْهُ.</td><td></td><td>u1/u1l3/objective</td><td>#/lesson/u1/u1l3</td></tr><tr class="p-low"><td>14</td><td>تفسير ما يتكرر</td><td>سورة الفاتحة</td><td>سؤال النقاش الأسري</td><td>اطلبوا من كل فرد في البيت أن يقرأ الفاتحة، وصحّحوا الأخطاء الشائعة بلطف.</td><td>صياغة تعليمية مساعدة</td><td>8</td><td>اقتراح نشاط أسري مستحدث؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَجِبُ عَلَى الْمُسْلِمِ أَنْ يَتَعَلَّمَ قِرَاءَةَ سُورَةِ الْفَاتِحَةِ؛ لِأَنَّ الصَّلَاةَ لَا تَصِحُّ إِلَّا بِهَا، وَيَحْسُنُ أَنْ يَتَعَلَّمَ قِرَاءَةَ كِتَابِ اللهِ كَامِلًا، فَإِنْ لَمْ يَكُنْ فَمَا اسْتَطَاعَ مِنْهُ.</td><td></td><td>u1/u1l3/family</td><td>#/lesson/u1/u1l3</td></tr><tr class="p-low"><td>18</td><td>تفسير ما يتكرر</td><td>آية الكرسي</td><td>مدخل الدرس</td><td>آية واحدة تقرؤها بعد كل صلاة وقبل نومك، وصفها النبي ﷺ بأنها أعظم آية في كتاب الله.</td><td>صياغة تعليمية مساعدة</td><td>10</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ أَعْظَمُ آيَةٍ فِي الْقُرْآنِ.</td><td></td><td>u1/u1l4/hook</td><td>#/lesson/u1/u1l4</td></tr><tr class="p-low"><td>19</td><td>تفسير ما يتكرر</td><td>آية الكرسي</td><td>هدف الدرس</td><td>أن تحفظ آية الكرسي وتفهم معاني ألفاظها كما شرحها الكتاب.</td><td>صياغة تعليمية مساعدة</td><td>10</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ أَعْظَمُ آيَةٍ فِي الْقُرْآنِ.</td><td></td><td>u1/u1l4/objective</td><td>#/lesson/u1/u1l4</td></tr><tr class="p-low"><td>23</td><td>تفسير ما يتكرر</td><td>آخر آيتين من سورة البقرة</td><td>مدخل الدرس</td><td>آيتان مَن قرأهما في ليلة كفتاه، وفيهما دعاء علّمنا الله أن ندعو به.</td><td>صياغة تعليمية مساعدة</td><td>11</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>﴿لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِنْ رُسُلِهِ﴾: أَيْ: لَا نُفَرِّقُ فِي الْإِيمَانِ بَيْنَ الرُّسُلِ فَنُؤْمِنُ بِبَعْضِهِمْ وَنُنْكِرُ بَعْضَهُمْ، بَلْ نُؤْمِنُ بِهِمْ جَمِيعًا. | ﴿وَقَالُوا﴾: أَيِ: الرَّسُولُ وَالْمُؤْمِنُونَ. | ﴿غُفْرَانَكَ رَبَّنَا﴾: أَيْ: نَسْأَلُكَ مَغْفِرَتَكَ. | ﴿وَإِلَيْكَ الْمَصِيرُ﴾: أَيِ: الْمَرْجِعُ. | ﴿لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا﴾: أَيْ: لَا يَطْلُبُ اللهُ مِنْ عِبَادِهِ مَا لَا يُطِيقُونَهُ. | ﴿لَهَا مَا كَسَبَتْ وَعَلَيْهَا مَا اكْتَسَبَتْ﴾: فَمَنْ فَعَلَ خَيْرًا نَالَ خَيْرًا، وَمَنْ فَعَلَ شَرًّا نَالَ شَرًّا. | ﴿رَبَّنَا وَلَا تَحْمِلْ عَلَيْ</td><td></td><td>u1/u1l5/hook</td><td>#/lesson/u1/u1l5</td></tr><tr class="p-low"><td>24</td><td>تفسير ما يتكرر</td><td>آخر آيتين من سورة البقرة</td><td>هدف الدرس</td><td>أن تعرف معاني آخر آيتين من البقرة وما فيهما من دعاء.</td><td>صياغة تعليمية مساعدة</td><td>11</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>﴿لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِنْ رُسُلِهِ﴾: أَيْ: لَا نُفَرِّقُ فِي الْإِيمَانِ بَيْنَ الرُّسُلِ فَنُؤْمِنُ بِبَعْضِهِمْ وَنُنْكِرُ بَعْضَهُمْ، بَلْ نُؤْمِنُ بِهِمْ جَمِيعًا. | ﴿وَقَالُوا﴾: أَيِ: الرَّسُولُ وَالْمُؤْمِنُونَ. | ﴿غُفْرَانَكَ رَبَّنَا﴾: أَيْ: نَسْأَلُكَ مَغْفِرَتَكَ. | ﴿وَإِلَيْكَ الْمَصِيرُ﴾: أَيِ: الْمَرْجِعُ. | ﴿لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا﴾: أَيْ: لَا يَطْلُبُ اللهُ مِنْ عِبَادِهِ مَا لَا يُطِيقُونَهُ. | ﴿لَهَا مَا كَسَبَتْ وَعَلَيْهَا مَا اكْتَسَبَتْ﴾: فَمَنْ فَعَلَ خَيْرًا نَالَ خَيْرًا، وَمَنْ فَعَلَ شَرًّا نَالَ شَرًّا. | ﴿رَبَّنَا وَلَا تَحْمِلْ عَلَيْ</td><td></td><td>u1/u1l5/objective</td><td>#/lesson/u1/u1l5</td></tr><tr class="p-low"><td>28</td><td>تفسير ما يتكرر</td><td>سورة الكافرون</td><td>مدخل الدرس</td><td>سورة قصيرة تُقرأ في سنة الفجر، وفيها براءةٌ كاملة من الشرك.</td><td>صياغة تعليمية مساعدة</td><td>12</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَتُسَنُّ قِرَاءَتُهَا فِي الرَّكْعَةِ الْأُولَى مِنَ السُّنَّةِ الْقَبْلِيَّةِ لِصَلَاةِ الْفَجْرِ.</td><td></td><td>u1/u1l6/hook</td><td>#/lesson/u1/u1l6</td></tr><tr class="p-low"><td>29</td><td>تفسير ما يتكرر</td><td>سورة الكافرون</td><td>هدف الدرس</td><td>أن تعرف معنى سورة الكافرون وموضع قراءتها في السنة الراتبة.</td><td>صياغة تعليمية مساعدة</td><td>12</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَتُسَنُّ قِرَاءَتُهَا فِي الرَّكْعَةِ الْأُولَى مِنَ السُّنَّةِ الْقَبْلِيَّةِ لِصَلَاةِ الْفَجْرِ.</td><td></td><td>u1/u1l6/objective</td><td>#/lesson/u1/u1l6</td></tr><tr class="p-low"><td>33</td><td>تفسير ما يتكرر</td><td>سورة الإخلاص</td><td>مدخل الدرس</td><td>أربع آيات فقط، لكنها تُعرِّفك بربك كما عرّف نفسه. وهي تُقرأ في الركعة الثانية من سنة الفجر.</td><td>صياغة تعليمية مساعدة</td><td>13</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَتُسَنُّ قِرَاءَتُهَا فِي الرَّكْعَةِ الثَّانِيَةِ مِنَ السُّنَّةِ الْقَبْلِيَّةِ لِصَلَاةِ الْفَجْرِ.</td><td></td><td>u1/u1l7/hook</td><td>#/lesson/u1/u1l7</td></tr><tr class="p-low"><td>34</td><td>تفسير ما يتكرر</td><td>سورة الإخلاص</td><td>هدف الدرس</td><td>أن تعرف معاني سورة الإخلاص وموضع قراءتها.</td><td>صياغة تعليمية مساعدة</td><td>13</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَتُسَنُّ قِرَاءَتُهَا فِي الرَّكْعَةِ الثَّانِيَةِ مِنَ السُّنَّةِ الْقَبْلِيَّةِ لِصَلَاةِ الْفَجْرِ.</td><td></td><td>u1/u1l7/objective</td><td>#/lesson/u1/u1l7</td></tr><tr class="p-low"><td>37</td><td>تفسير ما يتكرر</td><td>سورة الفلق</td><td>مدخل الدرس</td><td>حين تخاف من شرٍّ لا تعرف مصدره، فهذه السورة تجمع لك الاستعاذة من أربعة شرور.</td><td>صياغة تعليمية مساعدة</td><td>13</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>﴿قُلْ﴾: أَيُّهَا الرَّسُولُ. | ﴿بِرَبِّ الْفَلَقِ﴾: وَهُوَ: الصُّبْحُ. | ﴿مِنْ شَرِّ مَا خَلَقَ﴾: أَيْ: جَمِيعِ الْمَخْلُوقَاتِ. | ﴿غَاسِقٍ﴾: أَيِ: اللَّيْلِ شَدِيدِ الظُّلْمَةِ. | ﴿إِذَا وَقَبَ﴾: إِذَا دَخَلَ وَتَغَلْغَلَ، وَمَا فِيهِ مِنَ الشُّرُورِ وَالْمُؤْذِيَاتِ. | ﴿النَّفَّاثَاتِ فِي الْعُقَدِ﴾: أَيِ: السَّاحِرَاتِ اللَّاتِي يَنْفُخْنَ فِيمَا يَعْقِدْنَ مِنْ عُقَدٍ بِقَصْدِ السِّحْرِ. | ﴿وَمِنْ شَرِّ حَاسِدٍ إِذَا حَسَدَ﴾: وَالْحَسَدُ: كَرَاهِيَةُ وُصُولِ النِّعْمَةِ لِلْغَيْرِ.</td><td></td><td>u1/u1l8/hook</td><td>#/lesson/u1/u1l8</td></tr><tr class="p-low"><td>38</td><td>تفسير ما يتكرر</td><td>سورة الفلق</td><td>هدف الدرس</td><td>أن تعرف معاني سورة الفلق والشرور التي يُستعاذ منها فيها.</td><td>صياغة تعليمية مساعدة</td><td>13</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>﴿قُلْ﴾: أَيُّهَا الرَّسُولُ. | ﴿بِرَبِّ الْفَلَقِ﴾: وَهُوَ: الصُّبْحُ. | ﴿مِنْ شَرِّ مَا خَلَقَ﴾: أَيْ: جَمِيعِ الْمَخْلُوقَاتِ. | ﴿غَاسِقٍ﴾: أَيِ: اللَّيْلِ شَدِيدِ الظُّلْمَةِ. | ﴿إِذَا وَقَبَ﴾: إِذَا دَخَلَ وَتَغَلْغَلَ، وَمَا فِيهِ مِنَ الشُّرُورِ وَالْمُؤْذِيَاتِ. | ﴿النَّفَّاثَاتِ فِي الْعُقَدِ﴾: أَيِ: السَّاحِرَاتِ اللَّاتِي يَنْفُخْنَ فِيمَا يَعْقِدْنَ مِنْ عُقَدٍ بِقَصْدِ السِّحْرِ. | ﴿وَمِنْ شَرِّ حَاسِدٍ إِذَا حَسَدَ﴾: وَالْحَسَدُ: كَرَاهِيَةُ وُصُولِ النِّعْمَةِ لِلْغَيْرِ.</td><td></td><td>u1/u1l8/objective</td><td>#/lesson/u1/u1l8</td></tr><tr class="p-low"><td>41</td><td>تفسير ما يتكرر</td><td>سورة الناس</td><td>مدخل الدرس</td><td>عدوٌّ يوسوس عند الغفلة ويختفي عند ذكر الله — فمن أين تأتي الحماية؟</td><td>صياغة تعليمية مساعدة</td><td>14</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>﴿قُلْ﴾: أَيُّهَا الرَّسُولُ. | ﴿الْوَسْوَاسِ الْخَنَّاسِ﴾: أَيِ: الشَّيْطَانِ الَّذِي يُوَسْوِسُ عِنْدَ الْغَفْلَةِ، وَيَخْتَفِي عِنْدَ ذِكْرِ اللهِ. | ﴿مِنَ الْجِنَّةِ وَالنَّاسِ﴾: فَمِنَ الْجِنِّ شَيَاطِينُ، وَمِنَ الْإِنْسِ شَيَاطِينُ.</td><td></td><td>u1/u1l9/hook</td><td>#/lesson/u1/u1l9</td></tr><tr class="p-low"><td>42</td><td>تفسير ما يتكرر</td><td>سورة الناس</td><td>هدف الدرس</td><td>أن تعرف معاني سورة الناس وحقيقة الوسواس الخنّاس.</td><td>صياغة تعليمية مساعدة</td><td>14</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>﴿قُلْ﴾: أَيُّهَا الرَّسُولُ. | ﴿الْوَسْوَاسِ الْخَنَّاسِ﴾: أَيِ: الشَّيْطَانِ الَّذِي يُوَسْوِسُ عِنْدَ الْغَفْلَةِ، وَيَخْتَفِي عِنْدَ ذِكْرِ اللهِ. | ﴿مِنَ الْجِنَّةِ وَالنَّاسِ﴾: فَمِنَ الْجِنِّ شَيَاطِينُ، وَمِنَ الْإِنْسِ شَيَاطِينُ.</td><td></td><td>u1/u1l9/objective</td><td>#/lesson/u1/u1l9</td></tr><tr class="p-low"><td>47</td><td>الأحاديث النبوية</td><td>أصول الإسلام على ثلاثة أحاديث</td><td>مدخل الدرس</td><td>لو قيل لك: اختصر الإسلام في ثلاثة أحاديث، فماذا تختار؟ الإمام أحمد اختار، فماذا اختار؟</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>قَالَ الْإِمَامُ أَحْمَدُ: (أُصُولُ الْإِسْلَامِ عَلَى ثَلَاثَةِ أَحَادِيثَ...) ثُمَّ ذَكَرَهَا، وَهِيَ:</td><td></td><td>u2/u2l0/hook</td><td>#/lesson/u2/u2l0</td></tr><tr class="p-low"><td>48</td><td>الأحاديث النبوية</td><td>أصول الإسلام على ثلاثة أحاديث</td><td>هدف الدرس</td><td>أن تعرف كلمة الإمام أحمد في أصول الإسلام، وأنّ ما جاء به النبي ﷺ وحيٌ يُتَّبع.</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>قَالَ الْإِمَامُ أَحْمَدُ: (أُصُولُ الْإِسْلَامِ عَلَى ثَلَاثَةِ أَحَادِيثَ...) ثُمَّ ذَكَرَهَا، وَهِيَ:</td><td></td><td>u2/u2l0/objective</td><td>#/lesson/u2/u2l0</td></tr><tr class="p-low"><td>53</td><td>الأحاديث النبوية</td><td>الحديث الأول: الأعمال بالنية</td><td>مدخل الدرس</td><td>عملان متشابهان في الظاهر، وبينهما في الميزان ما بين السماء والأرض. ما الفارق؟</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«الْأَعْمَالُ بِالنِّيَّةِ، وَلِكُلِّ امْرِئٍ مَا نَوَى، فَمَنْ كَانَتْ هِجْرَتُهُ إِلَى اللهِ وَرَسُولِهِ فَهِجْرَتُهُ إِلَى اللهِ وَرَسُولِهِ، وَمَنْ كَانَتْ هِجْرَتُهُ لِدُنْيَا يُصِيبُهَا، أَوِ امْرَأَةٍ يَتَزَوَّجُهَا، فَهِجْرَتُهُ إِلَى مَا هَاجَرَ إِلَيْهِ».</td><td></td><td>u2/u2l1/hook</td><td>#/lesson/u2/u2l1</td></tr><tr class="p-low"><td>54</td><td>الأحاديث النبوية</td><td>الحديث الأول: الأعمال بالنية</td><td>هدف الدرس</td><td>أن تعرف نصّ حديث النية، وأنّ العمل لا يكون عبادة إلا بنية التعبّد.</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«الْأَعْمَالُ بِالنِّيَّةِ، وَلِكُلِّ امْرِئٍ مَا نَوَى، فَمَنْ كَانَتْ هِجْرَتُهُ إِلَى اللهِ وَرَسُولِهِ فَهِجْرَتُهُ إِلَى اللهِ وَرَسُولِهِ، وَمَنْ كَانَتْ هِجْرَتُهُ لِدُنْيَا يُصِيبُهَا، أَوِ امْرَأَةٍ يَتَزَوَّجُهَا، فَهِجْرَتُهُ إِلَى مَا هَاجَرَ إِلَيْهِ».</td><td></td><td>u2/u2l1/objective</td><td>#/lesson/u2/u2l1</td></tr><tr class="p-low"><td>56</td><td>الأحاديث النبوية</td><td>الحديث الأول: الأعمال بالنية</td><td>سؤال النقاش الأسري</td><td>اسألوا بعضكم: ما أقرب عمل تفعله كل يوم ويمكن أن ينقلب عبادةً بتغيير النية؟</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>اقتراح نشاط أسري مستحدث؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«الْأَعْمَالُ بِالنِّيَّةِ، وَلِكُلِّ امْرِئٍ مَا نَوَى، فَمَنْ كَانَتْ هِجْرَتُهُ إِلَى اللهِ وَرَسُولِهِ فَهِجْرَتُهُ إِلَى اللهِ وَرَسُولِهِ، وَمَنْ كَانَتْ هِجْرَتُهُ لِدُنْيَا يُصِيبُهَا، أَوِ امْرَأَةٍ يَتَزَوَّجُهَا، فَهِجْرَتُهُ إِلَى مَا هَاجَرَ إِلَيْهِ».</td><td></td><td>u2/u2l1/family</td><td>#/lesson/u2/u2l1</td></tr><tr class="p-low"><td>59</td><td>الأحاديث النبوية</td><td>الحديث الثاني: من أحدث في أمرنا</td><td>مدخل الدرس</td><td>نيّة طيّبة وعمل لم يشرعه الله. فهل تكفي النية؟</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«مَنْ أَحْدَثَ فِي أَمْرِنَا هَذَا مَا لَيْسَ فِيهِ، فَهُوَ رَدٌّ».</td><td></td><td>u2/u2l2/hook</td><td>#/lesson/u2/u2l2</td></tr><tr class="p-low"><td>60</td><td>الأحاديث النبوية</td><td>الحديث الثاني: من أحدث في أمرنا</td><td>هدف الدرس</td><td>أن تعرف نصّ حديث الردّ، وتعريف البدعة كما ذكره الكتاب.</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«مَنْ أَحْدَثَ فِي أَمْرِنَا هَذَا مَا لَيْسَ فِيهِ، فَهُوَ رَدٌّ».</td><td></td><td>u2/u2l2/objective</td><td>#/lesson/u2/u2l2</td></tr><tr class="p-low"><td>62</td><td>الأحاديث النبوية</td><td>الحديث الثالث: الحلال بيّن والحرام بيّن</td><td>مدخل الدرس</td><td>بين الأبيض والأسود منطقة رمادية. كيف يتصرّف العاقل فيها؟ ومَثَلٌ نبويّ يحسم الأمر.</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الْحَلَالَ بَيِّنٌ، وَإِنَّ الْحَرَامَ بَيِّنٌ، وَبَيْنَهُمَا مُشْتَبِهَاتٌ لَا يَعْلَمُهُنَّ كَثِيرٌ مِنَ النَّاسِ، فَمَنِ اتَّقَى الشُّبُهَاتِ اسْتَبْرَأَ لِدِينِهِ، وَعِرْضِهِ، وَمَنْ وَقَعَ فِي الشُّبُهَاتِ وَقَعَ فِي الْحَرَامِ، كَالرَّاعِي يَرْعَى حَوْلَ الْحِمَى، يُوشِكُ أَنْ يَرْتَعَ فِيهِ، أَلَا وَإِنَّ لِكُلِّ مَلِكٍ حِمًى، أَلَا وَإِنَّ حِمَى اللهِ مَحَارِمُهُ، أَلَا وَإِنَّ فِي الْجَسَدِ مُضْغَةً، إِذَا صَلَحَتْ، صَلَحَ الْجَسَدُ كُلُّهُ، وَإِذَا فَسَدَتْ، فَسَدَ الْجَسَدُ كُلُّهُ، أَلَا وَهِيَ الْقَلْبُ».</td><td></td><td>u2/u2l3/hook</td><td>#/lesson/u2/u2l3</td></tr><tr class="p-low"><td>63</td><td>الأحاديث النبوية</td><td>الحديث الثالث: الحلال بيّن والحرام بيّن</td><td>هدف الدرس</td><td>أن تعرف نصّ حديث المشتبهات، ومعناه، وأثر صلاح القلب.</td><td>صياغة تعليمية مساعدة</td><td>18</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الْحَلَالَ بَيِّنٌ، وَإِنَّ الْحَرَامَ بَيِّنٌ، وَبَيْنَهُمَا مُشْتَبِهَاتٌ لَا يَعْلَمُهُنَّ كَثِيرٌ مِنَ النَّاسِ، فَمَنِ اتَّقَى الشُّبُهَاتِ اسْتَبْرَأَ لِدِينِهِ، وَعِرْضِهِ، وَمَنْ وَقَعَ فِي الشُّبُهَاتِ وَقَعَ فِي الْحَرَامِ، كَالرَّاعِي يَرْعَى حَوْلَ الْحِمَى، يُوشِكُ أَنْ يَرْتَعَ فِيهِ، أَلَا وَإِنَّ لِكُلِّ مَلِكٍ حِمًى، أَلَا وَإِنَّ حِمَى اللهِ مَحَارِمُهُ، أَلَا وَإِنَّ فِي الْجَسَدِ مُضْغَةً، إِذَا صَلَحَتْ، صَلَحَ الْجَسَدُ كُلُّهُ، وَإِذَا فَسَدَتْ، فَسَدَ الْجَسَدُ كُلُّهُ، أَلَا وَهِيَ الْقَلْبُ».</td><td></td><td>u2/u2l3/objective</td><td>#/lesson/u2/u2l3</td></tr><tr class="p-low"><td>67</td><td>مراتب الدين</td><td>مراتب الدين الثلاث</td><td>مدخل الدرس</td><td>الدين ليس طبقة واحدة؛ بل ثلاث مراتب يصعد فيها المسلم. فما هي؟</td><td>صياغة تعليمية مساعدة</td><td>23</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>مَرَاتِبُ الدِّينِ ثَلَاثٌ: الْإِسْلَامُ وَالْإِيمَانُ وَالْإِحْسَانُ، وَكُلُّ مَرْتَبَةٍ لَهَا أَرْكَانٌ.</td><td></td><td>u3/u3l0/hook</td><td>#/lesson/u3/u3l0</td></tr><tr class="p-low"><td>68</td><td>مراتب الدين</td><td>مراتب الدين الثلاث</td><td>هدف الدرس</td><td>أن تعرف مراتب الدين الثلاث وأنّ لكل مرتبة أركانًا.</td><td>صياغة تعليمية مساعدة</td><td>23</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>مَرَاتِبُ الدِّينِ ثَلَاثٌ: الْإِسْلَامُ وَالْإِيمَانُ وَالْإِحْسَانُ، وَكُلُّ مَرْتَبَةٍ لَهَا أَرْكَانٌ.</td><td></td><td>u3/u3l0/objective</td><td>#/lesson/u3/u3l0</td></tr><tr class="p-low"><td>73</td><td>مراتب الدين</td><td>أركان الإسلام</td><td>مدخل الدرس</td><td>كلمة واحدة تدخل بها الإسلام، ولها معنى دقيق كثيرٌ من الناس يقولها ولا يعرفه.</td><td>صياغة تعليمية مساعدة</td><td>23</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ خَمْسَةٌ: أَوَّلُهَا وَأَعْظَمُهَا: شَهَادَةُ أَلَّا إِلَهَ إِلَّا اللهُ، وَأَنَّ مُحَمَّدًا رَسُولُ اللهِ.</td><td></td><td>u3/u3l1/hook</td><td>#/lesson/u3/u3l1</td></tr><tr class="p-low"><td>74</td><td>مراتب الدين</td><td>أركان الإسلام</td><td>هدف الدرس</td><td>أن تعرف أركان الإسلام الخمسة، ومعنى الشهادتين، ومعنى العبادة.</td><td>صياغة تعليمية مساعدة</td><td>23</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ خَمْسَةٌ: أَوَّلُهَا وَأَعْظَمُهَا: شَهَادَةُ أَلَّا إِلَهَ إِلَّا اللهُ، وَأَنَّ مُحَمَّدًا رَسُولُ اللهِ.</td><td></td><td>u3/u3l1/objective</td><td>#/lesson/u3/u3l1</td></tr><tr class="p-low"><td>76</td><td>مراتب الدين</td><td>أركان الإسلام</td><td>سؤال النقاش الأسري</td><td>اسألوا الصغار: ما معنى «لا إله إلا الله»؟ ثم صحّحوا الإجابة بنصّ الكتاب.</td><td>صياغة تعليمية مساعدة</td><td>23</td><td>اقتراح نشاط أسري مستحدث؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ خَمْسَةٌ: أَوَّلُهَا وَأَعْظَمُهَا: شَهَادَةُ أَلَّا إِلَهَ إِلَّا اللهُ، وَأَنَّ مُحَمَّدًا رَسُولُ اللهِ.</td><td></td><td>u3/u3l1/family</td><td>#/lesson/u3/u3l1</td></tr><tr class="p-low"><td>77</td><td>مراتب الدين</td><td>أركان الإيمان والقدر الواجب فيها</td><td>مدخل الدرس</td><td>هل يلزمك أن تعرف عدد أبواب الجنة لتكون مؤمنًا؟ الكتاب يفرّق بين قدرٍ واجب وقدرٍ مستحب.</td><td>صياغة تعليمية مساعدة</td><td>24</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ سِتَّةٌ: (الْإِيمَانُ بِاللهِ، وَمَلَائِكَتِهِ، وَكُتُبِهِ، وَرُسُلِهِ، وَالْيَوْمِ الْآخِرِ، وَالْقَدَرِ خَيْرِهِ وَشَرِّهِ).</td><td></td><td>u3/u3l2/hook</td><td>#/lesson/u3/u3l2</td></tr><tr class="p-low"><td>78</td><td>مراتب الدين</td><td>أركان الإيمان والقدر الواجب فيها</td><td>هدف الدرس</td><td>أن تعرف أركان الإيمان الستة، والقدر الواجب المجزئ في كل ركن.</td><td>صياغة تعليمية مساعدة</td><td>24</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ سِتَّةٌ: (الْإِيمَانُ بِاللهِ، وَمَلَائِكَتِهِ، وَكُتُبِهِ، وَرُسُلِهِ، وَالْيَوْمِ الْآخِرِ، وَالْقَدَرِ خَيْرِهِ وَشَرِّهِ).</td><td></td><td>u3/u3l2/objective</td><td>#/lesson/u3/u3l2</td></tr><tr class="p-low"><td>80</td><td>مراتب الدين</td><td>الإحسان</td><td>مدخل الدرس</td><td>ركن واحد، لكنه يغيّر طريقة أدائك لكل عبادة في حياتك.</td><td>صياغة تعليمية مساعدة</td><td>26</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>رُكْنٌ وَاحِدٌ: أَنْ تَعْبُدَ اللهَ كَأَنَّكَ تَرَاهُ، فَإِنْ لَمْ تَكُنْ تَرَاهُ فَإِنَّهُ يَرَاكَ.</td><td></td><td>u3/u3l3/hook</td><td>#/lesson/u3/u3l3</td></tr><tr class="p-low"><td>81</td><td>مراتب الدين</td><td>الإحسان</td><td>هدف الدرس</td><td>أن تعرف ركن الإحسان ونصّه.</td><td>صياغة تعليمية مساعدة</td><td>26</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>رُكْنٌ وَاحِدٌ: أَنْ تَعْبُدَ اللهَ كَأَنَّكَ تَرَاهُ، فَإِنْ لَمْ تَكُنْ تَرَاهُ فَإِنَّهُ يَرَاكَ.</td><td></td><td>u3/u3l3/objective</td><td>#/lesson/u3/u3l3</td></tr><tr class="p-low"><td>85</td><td>الفقه</td><td>شروط الوضوء</td><td>مدخل الدرس</td><td>قبل أن تفتح الصنبور، هناك تسعة أمور لو اختلّ واحدٌ منها لم يصحّ وضوؤك.</td><td>صياغة تعليمية مساعدة</td><td>30</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ تِسْعَةٌ:</td><td></td><td>u4/u4l1/hook</td><td>#/lesson/u4/u4l1</td></tr><tr class="p-low"><td>86</td><td>الفقه</td><td>شروط الوضوء</td><td>هدف الدرس</td><td>أن تعرف شروط الوضوء التسعة كما ذكرها الكتاب.</td><td>صياغة تعليمية مساعدة</td><td>30</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ تِسْعَةٌ:</td><td></td><td>u4/u4l1/objective</td><td>#/lesson/u4/u4l1</td></tr><tr class="p-low"><td>90</td><td>الفقه</td><td>أركان الوضوء</td><td>مدخل الدرس</td><td>ستة أعمال لو تركت واحدًا منها لم يصحّ وضوؤك أبدًا، لا عمدًا ولا سهوًا.</td><td>صياغة تعليمية مساعدة</td><td>30</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ سِتَّةٌ:</td><td></td><td>u4/u4l2/hook</td><td>#/lesson/u4/u4l2</td></tr><tr class="p-low"><td>91</td><td>الفقه</td><td>أركان الوضوء</td><td>هدف الدرس</td><td>أن تعرف أركان الوضوء الستة وترتيبها.</td><td>صياغة تعليمية مساعدة</td><td>30</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ سِتَّةٌ:</td><td></td><td>u4/u4l2/objective</td><td>#/lesson/u4/u4l2</td></tr><tr class="p-low"><td>93</td><td>الفقه</td><td>من سنن الوضوء</td><td>مدخل الدرس</td><td>بين وضوءٍ صحيح ووضوءٍ كامل فرقٌ كبير. هذه السنن هي الفرق.</td><td>صياغة تعليمية مساعدة</td><td>30</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>١: السِّوَاكُ. | ٢: قَوْلُ: (بِاسْمِ اللهِ). | ٣: غَسْلُ الْكَفَّيْنِ ثَلَاثًا. | ٤: بَدَاءَةٌ بِمَضْمَضَةٍ فَاسْتِنْشَاقٍ قَبْلَ غَسْلِ الْوَجْهِ. | ٥: مُبَالَغَةٌ فِيهِمَا لِغَيْرِ صَائِمٍ. | ٦: تَكْرَارُ غَسْلِ الْوَجْهِ -وَمِنْهُ الْمَضْمَضَةُ وَالِاسْتِنْشَاقُ- وَالْيَدَيْنِ وَالرِّجْلَيْنِ ثَلَاثَ مَرَّاتٍ. | ٧: تَخْلِيلُ الشَّعَرِ الْكَثِيفِ وَالْأَصَابِعِ. | ٨: أَخْذُ مَاءٍ جَدِيدٍ لِلرَّأْسِ. | ٩: الْبَدَاءَةُ بِمُقَدَّمِ الرَّأْسِ إِلَى الْقَفَا ثُمَّ الْعَوْدَةُ إِلَى الْمُقَدَّمِ، أَوِ الْبَدَاءَةُ بِالْمُقَدَّمِ إِلَى الْقَفَا مِنْ غَيْرِ عَوْدَةٍ. | ١٠: مَسْحُ الْأُذُنَيْنِ. | ١١</td><td></td><td>u4/u4l3/hook</td><td>#/lesson/u4/u4l3</td></tr><tr class="p-low"><td>94</td><td>الفقه</td><td>من سنن الوضوء</td><td>هدف الدرس</td><td>أن تعرف جملةً من سنن الوضوء، وحكم المسح على الخفين.</td><td>صياغة تعليمية مساعدة</td><td>30</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>١: السِّوَاكُ. | ٢: قَوْلُ: (بِاسْمِ اللهِ). | ٣: غَسْلُ الْكَفَّيْنِ ثَلَاثًا. | ٤: بَدَاءَةٌ بِمَضْمَضَةٍ فَاسْتِنْشَاقٍ قَبْلَ غَسْلِ الْوَجْهِ. | ٥: مُبَالَغَةٌ فِيهِمَا لِغَيْرِ صَائِمٍ. | ٦: تَكْرَارُ غَسْلِ الْوَجْهِ -وَمِنْهُ الْمَضْمَضَةُ وَالِاسْتِنْشَاقُ- وَالْيَدَيْنِ وَالرِّجْلَيْنِ ثَلَاثَ مَرَّاتٍ. | ٧: تَخْلِيلُ الشَّعَرِ الْكَثِيفِ وَالْأَصَابِعِ. | ٨: أَخْذُ مَاءٍ جَدِيدٍ لِلرَّأْسِ. | ٩: الْبَدَاءَةُ بِمُقَدَّمِ الرَّأْسِ إِلَى الْقَفَا ثُمَّ الْعَوْدَةُ إِلَى الْمُقَدَّمِ، أَوِ الْبَدَاءَةُ بِالْمُقَدَّمِ إِلَى الْقَفَا مِنْ غَيْرِ عَوْدَةٍ. | ١٠: مَسْحُ الْأُذُنَيْنِ. | ١١</td><td></td><td>u4/u4l3/objective</td><td>#/lesson/u4/u4l3</td></tr><tr class="p-low"><td>97</td><td>الفقه</td><td>نواقض الوضوء</td><td>مدخل الدرس</td><td>ستة أمور تُبطل طهارتك، بعضها يخفى على كثير من الناس.</td><td>صياغة تعليمية مساعدة</td><td>32</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ سِتَّةٌ:</td><td></td><td>u4/u4l4/hook</td><td>#/lesson/u4/u4l4</td></tr><tr class="p-low"><td>98</td><td>الفقه</td><td>نواقض الوضوء</td><td>هدف الدرس</td><td>أن تعرف نواقض الوضوء الستة.</td><td>صياغة تعليمية مساعدة</td><td>32</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ سِتَّةٌ:</td><td></td><td>u4/u4l4/objective</td><td>#/lesson/u4/u4l4</td></tr><tr class="p-low"><td>100</td><td>الفقه</td><td>شروط الصلاة</td><td>مدخل الدرس</td><td>تسعة أمور تسبق تكبيرة الإحرام. هل تراجعها قبل كل صلاة؟</td><td>صياغة تعليمية مساعدة</td><td>32</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ تِسْعَةٌ:</td><td></td><td>u4/u4l5/hook</td><td>#/lesson/u4/u4l5</td></tr><tr class="p-low"><td>101</td><td>الفقه</td><td>شروط الصلاة</td><td>هدف الدرس</td><td>أن تعرف شروط الصلاة التسعة.</td><td>صياغة تعليمية مساعدة</td><td>32</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ تِسْعَةٌ:</td><td></td><td>u4/u4l5/objective</td><td>#/lesson/u4/u4l5</td></tr><tr class="p-low"><td>104</td><td>الفقه</td><td>أركان الصلاة</td><td>مدخل الدرس</td><td>أربعة عشر ركنًا لا يسقط واحد منها بعمد ولا سهو ولا جهل.</td><td>صياغة تعليمية مساعدة</td><td>32</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ أَرْبَعَةَ عَشَرَ:</td><td></td><td>u4/u4l6/hook</td><td>#/lesson/u4/u4l6</td></tr><tr class="p-low"><td>105</td><td>الفقه</td><td>أركان الصلاة</td><td>هدف الدرس</td><td>أن تعرف أركان الصلاة الأربعة عشر.</td><td>صياغة تعليمية مساعدة</td><td>32</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ أَرْبَعَةَ عَشَرَ:</td><td></td><td>u4/u4l6/objective</td><td>#/lesson/u4/u4l6</td></tr><tr class="p-low"><td>107</td><td>الفقه</td><td>واجبات الصلاة والفرق بينها وبين الأركان</td><td>مدخل الدرس</td><td>نسيتَ التشهد الأول فقمت. هل تبطل صلاتك؟ الجواب في الفرق بين الركن والواجب.</td><td>صياغة تعليمية مساعدة</td><td>33</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ ثَمَانِيَةٌ:</td><td></td><td>u4/u4l7/hook</td><td>#/lesson/u4/u4l7</td></tr><tr class="p-low"><td>108</td><td>الفقه</td><td>واجبات الصلاة والفرق بينها وبين الأركان</td><td>هدف الدرس</td><td>أن تعرف واجبات الصلاة الثمانية، ولفظ التشهد الأول، والفرق بين الركن والواجب.</td><td>صياغة تعليمية مساعدة</td><td>33</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ ثَمَانِيَةٌ:</td><td></td><td>u4/u4l7/objective</td><td>#/lesson/u4/u4l7</td></tr><tr class="p-low"><td>110</td><td>الفقه</td><td>واجبات الصلاة والفرق بينها وبين الأركان</td><td>سؤال النقاش الأسري</td><td>راجعوا معًا لفظ التشهد الأول، واختبروا بعضكم في الفرق بين الركن والواجب.</td><td>صياغة تعليمية مساعدة</td><td>33</td><td>اقتراح نشاط أسري مستحدث؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ ثَمَانِيَةٌ:</td><td></td><td>u4/u4l7/family</td><td>#/lesson/u4/u4l7</td></tr><tr class="p-low"><td>112</td><td>الفقه</td><td>من سنن الصلاة</td><td>مدخل الدرس</td><td>سننٌ كثيرة لو حرصت عليها لصارت صلاتك أقرب إلى صلاة النبي ﷺ.</td><td>صياغة تعليمية مساعدة</td><td>34</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>١: الِاسْتِفْتَاحُ. | ٢: جَعْلُ كَفِّ الْيَدِ الْيُمْنَى عَلَى الْيُسْرَى حِينَ الْقِيَامِ قَبْلَ الرُّكُوعِ وَبَعْدَهُ. | ٣: رَفْعُ الْيَدَيْنِ مَضْمُومَتَيِ الْأَصَابِعِ مَمْدُودَةً حَذْوَ الْمَنْكِبَيْنِ أَوِ الْأُذُنَيْنِ عِنْدَ التَّكْبِيرِ الْأَوَّلِ، وَعِنْدَ الرُّكُوعِ، وَالرَّفْعِ مِنْهُ، وَعِنْدَ الْقِيَامِ مِنَ التَّشَهُّدِ الْأَوَّلِ إِلَى الثَّالِثَةِ. | ٤: مَا زَادَ عَنْ وَاحِدَةٍ فِي تَسْبِيحِ الرُّكُوعِ وَالسُّجُودِ. | ٥: مَا زَادَ عَلَى قَوْلِ: (رَبَّنَا وَلَكَ الْحَمْدُ) بَعْدَ الْقِيَامِ مِنَ الرُّكُوعِ. | ٦: مَا زَادَ عَنْ وَاحِدَةٍ فِي الدُّعَاءِ بِالْمَغْفِرَةِ بَيْنَ الس</td><td></td><td>u4/u4l8/hook</td><td>#/lesson/u4/u4l8</td></tr><tr class="p-low"><td>113</td><td>الفقه</td><td>من سنن الصلاة</td><td>هدف الدرس</td><td>أن تعرف جملةً من سنن الصلاة، والصلاة الإبراهيمية، وما يُستعاذ منه بعد التشهد.</td><td>صياغة تعليمية مساعدة</td><td>34</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>١: الِاسْتِفْتَاحُ. | ٢: جَعْلُ كَفِّ الْيَدِ الْيُمْنَى عَلَى الْيُسْرَى حِينَ الْقِيَامِ قَبْلَ الرُّكُوعِ وَبَعْدَهُ. | ٣: رَفْعُ الْيَدَيْنِ مَضْمُومَتَيِ الْأَصَابِعِ مَمْدُودَةً حَذْوَ الْمَنْكِبَيْنِ أَوِ الْأُذُنَيْنِ عِنْدَ التَّكْبِيرِ الْأَوَّلِ، وَعِنْدَ الرُّكُوعِ، وَالرَّفْعِ مِنْهُ، وَعِنْدَ الْقِيَامِ مِنَ التَّشَهُّدِ الْأَوَّلِ إِلَى الثَّالِثَةِ. | ٤: مَا زَادَ عَنْ وَاحِدَةٍ فِي تَسْبِيحِ الرُّكُوعِ وَالسُّجُودِ. | ٥: مَا زَادَ عَلَى قَوْلِ: (رَبَّنَا وَلَكَ الْحَمْدُ) بَعْدَ الْقِيَامِ مِنَ الرُّكُوعِ. | ٦: مَا زَادَ عَنْ وَاحِدَةٍ فِي الدُّعَاءِ بِالْمَغْفِرَةِ بَيْنَ الس</td><td></td><td>u4/u4l8/objective</td><td>#/lesson/u4/u4l8</td></tr><tr class="p-low"><td>115</td><td>الفقه</td><td>مبطلات الصلاة</td><td>مدخل الدرس</td><td>ثمانية أمور تُبطل صلاتك وأنت قائم بين يدي ربك.</td><td>صياغة تعليمية مساعدة</td><td>36</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ ثَمَانِيَةٌ:</td><td></td><td>u4/u4l9/hook</td><td>#/lesson/u4/u4l9</td></tr><tr class="p-low"><td>116</td><td>الفقه</td><td>مبطلات الصلاة</td><td>هدف الدرس</td><td>أن تعرف مبطلات الصلاة الثمانية.</td><td>صياغة تعليمية مساعدة</td><td>36</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ ثَمَانِيَةٌ:</td><td></td><td>u4/u4l9/objective</td><td>#/lesson/u4/u4l9</td></tr><tr class="p-low"><td>118</td><td>الفقه</td><td>من صلاة التطوع</td><td>مدخل الدرس</td><td>اثنتا عشرة ركعة في اليوم تبني لك بيتًا في الجنة. أتعرف مواضعها؟</td><td>صياغة تعليمية مساعدة</td><td>36</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>السُّنَنُ الرَّوَاتِبُ، وَهِيَ: أَرْبَعُ رَكَعَاتٍ قَبْلَ الظُّهْرِ، وَرَكْعَتَانِ بَعْدَهَا، وَرَكْعَتَانِ بَعْدَ الْمَغْرِبِ، وَرَكْعَتَانِ بَعْدَ الْعِشَاءِ، وَرَكْعَتَانِ قَبْلَ الْفَجْرِ.</td><td></td><td>u4/u4l10/hook</td><td>#/lesson/u4/u4l10</td></tr><tr class="p-low"><td>119</td><td>الفقه</td><td>من صلاة التطوع</td><td>هدف الدرس</td><td>أن تعرف السنن الرواتب وأوقاتها، وصلاة الضحى والوتر.</td><td>صياغة تعليمية مساعدة</td><td>36</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>السُّنَنُ الرَّوَاتِبُ، وَهِيَ: أَرْبَعُ رَكَعَاتٍ قَبْلَ الظُّهْرِ، وَرَكْعَتَانِ بَعْدَهَا، وَرَكْعَتَانِ بَعْدَ الْمَغْرِبِ، وَرَكْعَتَانِ بَعْدَ الْعِشَاءِ، وَرَكْعَتَانِ قَبْلَ الْفَجْرِ.</td><td></td><td>u4/u4l10/objective</td><td>#/lesson/u4/u4l10</td></tr><tr class="p-low"><td>122</td><td>الأذكار والآداب</td><td>أذكار الصباح</td><td>مدخل الدرس</td><td>دقائق معدودة في أول نهارك تجعلك في حفظ الله إلى المساء. فهل تعرف ألفاظها ووقتها؟</td><td>صياغة تعليمية مساعدة</td><td>41</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَوَقْتُهَا مِنْ طُلُوعِ الْفَجْرِ الثَّانِي إِلَى طُلُوعِ الشَّمْسِ.</td><td></td><td>u5/u5l1/hook</td><td>#/lesson/u5/u5l1</td></tr><tr class="p-low"><td>123</td><td>الأذكار والآداب</td><td>أذكار الصباح</td><td>هدف الدرس</td><td>أن تعرف وقت أذكار الصباح وألفاظها كما ذكرها الكتاب.</td><td>صياغة تعليمية مساعدة</td><td>41</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَوَقْتُهَا مِنْ طُلُوعِ الْفَجْرِ الثَّانِي إِلَى طُلُوعِ الشَّمْسِ.</td><td></td><td>u5/u5l1/objective</td><td>#/lesson/u5/u5l1</td></tr><tr class="p-low"><td>125</td><td>الأذكار والآداب</td><td>أذكار الصباح</td><td>سؤال النقاش الأسري</td><td>اجعلوا للبيت وقتًا ثابتًا بعد الفجر لقراءة أذكار الصباح جماعةً.</td><td>صياغة تعليمية مساعدة</td><td>41</td><td>اقتراح نشاط أسري مستحدث؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَوَقْتُهَا مِنْ طُلُوعِ الْفَجْرِ الثَّانِي إِلَى طُلُوعِ الشَّمْسِ.</td><td></td><td>u5/u5l1/family</td><td>#/lesson/u5/u5l1</td></tr><tr class="p-low"><td>127</td><td>الأذكار والآداب</td><td>أذكار المساء</td><td>مدخل الدرس</td><td>حصنك في الليل يبدأ من غروب الشمس. هل تعرف متى يبدأ وقته ومتى ينتهي؟</td><td>صياغة تعليمية مساعدة</td><td>44</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَوَقْتُهَا مِنْ غُرُوبِ الشَّمْسِ إِلَى غِيَابِ الشَّفَقِ الْأَحْمَرِ، وَهُوَ ابْتِدَاءُ وَقْتِ الْعِشَاءِ.</td><td></td><td>u5/u5l2/hook</td><td>#/lesson/u5/u5l2</td></tr><tr class="p-low"><td>128</td><td>الأذكار والآداب</td><td>أذكار المساء</td><td>هدف الدرس</td><td>أن تعرف وقت أذكار المساء وألفاظها، والفروق بينها وبين أذكار الصباح.</td><td>صياغة تعليمية مساعدة</td><td>44</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَوَقْتُهَا مِنْ غُرُوبِ الشَّمْسِ إِلَى غِيَابِ الشَّفَقِ الْأَحْمَرِ، وَهُوَ ابْتِدَاءُ وَقْتِ الْعِشَاءِ.</td><td></td><td>u5/u5l2/objective</td><td>#/lesson/u5/u5l2</td></tr><tr class="p-low"><td>130</td><td>الأذكار والآداب</td><td>الأذكار بعد الصلوات الخمس</td><td>مدخل الدرس</td><td>بعد كل صلاة بابٌ من الأجر لا يستغرق دقائق. فما ترتيبه؟ وما الذي يُجهر به وما الذي يُسرّ؟</td><td>صياغة تعليمية مساعدة</td><td>47</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَسْتَغْفِرُ اللهَ ثَلَاثًا، وَيَقُولُ: (اللَّهُمَّ أَنْتَ السَّلَامُ، وَمِنْكَ السَّلَامُ، تَبَارَكْتَ يَا ذَا الْجَلَالِ وَالْإِكْرَامِ). هَذَا أَوَّلُ مَا يَبْدَأُ بِهِ مِنَ الْأَذْكَارِ، وَأَمَّا الَّذِي بَعْدَهُ فَلَمْ يَثْبُتْ فِيهِ تَرْتِيبٌ.</td><td></td><td>u5/u5l3/hook</td><td>#/lesson/u5/u5l3</td></tr><tr class="p-low"><td>131</td><td>الأذكار والآداب</td><td>الأذكار بعد الصلوات الخمس</td><td>هدف الدرس</td><td>أن تعرف أذكار ما بعد الصلاة، وصفات التسبيح الخمس، وحكم الجهر بها.</td><td>صياغة تعليمية مساعدة</td><td>47</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَسْتَغْفِرُ اللهَ ثَلَاثًا، وَيَقُولُ: (اللَّهُمَّ أَنْتَ السَّلَامُ، وَمِنْكَ السَّلَامُ، تَبَارَكْتَ يَا ذَا الْجَلَالِ وَالْإِكْرَامِ). هَذَا أَوَّلُ مَا يَبْدَأُ بِهِ مِنَ الْأَذْكَارِ، وَأَمَّا الَّذِي بَعْدَهُ فَلَمْ يَثْبُتْ فِيهِ تَرْتِيبٌ.</td><td></td><td>u5/u5l3/objective</td><td>#/lesson/u5/u5l3</td></tr><tr class="p-low"><td>133</td><td>الأذكار والآداب</td><td>أذكار النوم</td><td>مدخل الدرس</td><td>ثلثُ عمرك نوم. هل تجعله عبادةً محفوظة، أم غفلةً مكشوفة؟</td><td>صياغة تعليمية مساعدة</td><td>49</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>إِذَا أَرَدْتَ النَّوْمَ فَتَوَضَّأْ، ثُمَّ انْفُضْ فِرَاشَكَ، ثُمَّ اضْطَجِعْ عَلَى شِقِّكَ الْأَيْمَنِ، وَضَعْ يَدَكَ الْيُمْنَى تَحْتَ خَدِّكَ الْأَيْمَنِ، وَقُلْ:</td><td></td><td>u5/u5l4/hook</td><td>#/lesson/u5/u5l4</td></tr><tr class="p-low"><td>134</td><td>الأذكار والآداب</td><td>أذكار النوم</td><td>هدف الدرس</td><td>أن تعرف هيئة النوم المسنونة وأذكاره، وآخر ما يُقال قبله.</td><td>صياغة تعليمية مساعدة</td><td>49</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>إِذَا أَرَدْتَ النَّوْمَ فَتَوَضَّأْ، ثُمَّ انْفُضْ فِرَاشَكَ، ثُمَّ اضْطَجِعْ عَلَى شِقِّكَ الْأَيْمَنِ، وَضَعْ يَدَكَ الْيُمْنَى تَحْتَ خَدِّكَ الْأَيْمَنِ، وَقُلْ:</td><td></td><td>u5/u5l4/objective</td><td>#/lesson/u5/u5l4</td></tr><tr class="p-low"><td>136</td><td>الأذكار والآداب</td><td>أذكار الاستيقاظ من النوم</td><td>مدخل الدرس</td><td>أول جملة تقولها بعد أن يردّ الله عليك روحك — ما هي؟</td><td>صياغة تعليمية مساعدة</td><td>50</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>(الْحَمْدُ لِلهِ الَّذِي أَحْيَانَا بَعْدَمَا أَمَاتَنَا وَإِلَيْهِ النُّشُورُ).</td><td></td><td>u5/u5l5/hook</td><td>#/lesson/u5/u5l5</td></tr><tr class="p-low"><td>137</td><td>الأذكار والآداب</td><td>أذكار الاستيقاظ من النوم</td><td>هدف الدرس</td><td>أن تعرف ذكر الاستيقاظ وما يُقرأ عند القيام من نوم الليل.</td><td>صياغة تعليمية مساعدة</td><td>50</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>(الْحَمْدُ لِلهِ الَّذِي أَحْيَانَا بَعْدَمَا أَمَاتَنَا وَإِلَيْهِ النُّشُورُ).</td><td></td><td>u5/u5l5/objective</td><td>#/lesson/u5/u5l5</td></tr><tr class="p-low"><td>141</td><td>الأذكار والآداب</td><td>إن رأى في نومه ما يكره</td><td>مدخل الدرس</td><td>رؤيا مزعجة أفزعتك في الليل. ما التصرّف الصحيح؟ وما الخطأ الشائع؟</td><td>صياغة تعليمية مساعدة</td><td>50</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَنْفُثُ عَنْ يَسَارِهِ ثَلَاثَ مَرَّاتٍ، وَيَتَعَوَّذُ بِاللهِ مِنْ شَرِّهِ، وَلَا يُخْبِرُ بِهِ أَحَدًا.</td><td></td><td>u5/u5l6/hook</td><td>#/lesson/u5/u5l6</td></tr><tr class="p-low"><td>142</td><td>الأذكار والآداب</td><td>إن رأى في نومه ما يكره</td><td>هدف الدرس</td><td>أن تعرف ما يفعله من رأى في نومه ما يكره.</td><td>صياغة تعليمية مساعدة</td><td>50</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَنْفُثُ عَنْ يَسَارِهِ ثَلَاثَ مَرَّاتٍ، وَيَتَعَوَّذُ بِاللهِ مِنْ شَرِّهِ، وَلَا يُخْبِرُ بِهِ أَحَدًا.</td><td></td><td>u5/u5l6/objective</td><td>#/lesson/u5/u5l6</td></tr><tr class="p-low"><td>147</td><td>الأذكار والآداب</td><td>من استيقظ من الليل</td><td>مدخل الدرس</td><td>ذكرٌ إن قلته حين تتقلّب في فراشك ثم دعوت استُجيب لك.</td><td>صياغة تعليمية مساعدة</td><td>51</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>(لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ، وَلَهُ الْحَمْدُ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ، الْحَمْدُ لِلهِ، وَسُبْحَانَ اللهِ، وَلَا إِلَهَ إِلَّا اللهُ، وَاللهُ أَكْبَرُ، وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللهِ).</td><td></td><td>u5/u5l7/hook</td><td>#/lesson/u5/u5l7</td></tr><tr class="p-low"><td>148</td><td>الأذكار والآداب</td><td>من استيقظ من الليل</td><td>هدف الدرس</td><td>أن تعرف ذكر من استيقظ من الليل وما رُتِّب عليه.</td><td>صياغة تعليمية مساعدة</td><td>51</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>(لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ، وَلَهُ الْحَمْدُ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ، الْحَمْدُ لِلهِ، وَسُبْحَانَ اللهِ، وَلَا إِلَهَ إِلَّا اللهُ، وَاللهُ أَكْبَرُ، وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللهِ).</td><td></td><td>u5/u5l7/objective</td><td>#/lesson/u5/u5l7</td></tr><tr class="p-low"><td>152</td><td>الأذكار والآداب</td><td>آداب الأكل والشرب</td><td>مدخل الدرس</td><td>ثلاث دُفعات في شرب الماء، وسنّةٌ في نسيان التسمية. كم منها تطبّق؟</td><td>صياغة تعليمية مساعدة</td><td>51</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَكُونُ بِالْيَمِينِ، جَالِسًا، وَيَقُولُ قَبْلَ الْأَكْلِ وَالشُّرْبِ: (بِاسْمِ اللهِ)، وَيَأْكُلُ مِمَّا يَلِيهِ.</td><td></td><td>u5/u5l8/hook</td><td>#/lesson/u5/u5l8</td></tr><tr class="p-low"><td>153</td><td>الأذكار والآداب</td><td>آداب الأكل والشرب</td><td>هدف الدرس</td><td>أن تعرف آداب الأكل والشرب كما ذكرها الكتاب.</td><td>صياغة تعليمية مساعدة</td><td>51</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَكُونُ بِالْيَمِينِ، جَالِسًا، وَيَقُولُ قَبْلَ الْأَكْلِ وَالشُّرْبِ: (بِاسْمِ اللهِ)، وَيَأْكُلُ مِمَّا يَلِيهِ.</td><td></td><td>u5/u5l8/objective</td><td>#/lesson/u5/u5l8</td></tr><tr class="p-low"><td>155</td><td>الأذكار والآداب</td><td>آداب الأكل والشرب</td><td>سؤال النقاش الأسري</td><td>طبّقوا على مائدة اليوم: التسمية، والأكل باليمين، والأكل مما يليه، والحمد في الختام.</td><td>صياغة تعليمية مساعدة</td><td>51</td><td>اقتراح نشاط أسري مستحدث؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَكُونُ بِالْيَمِينِ، جَالِسًا، وَيَقُولُ قَبْلَ الْأَكْلِ وَالشُّرْبِ: (بِاسْمِ اللهِ)، وَيَأْكُلُ مِمَّا يَلِيهِ.</td><td></td><td>u5/u5l8/family</td><td>#/lesson/u5/u5l8</td></tr><tr class="p-low"><td>157</td><td>الأذكار والآداب</td><td>آداب الخلاء</td><td>مدخل الدرس</td><td>أذكارٌ وآدابٌ في أخصّ أحوالك — دليلٌ على شمول هذا الدين.</td><td>صياغة تعليمية مساعدة</td><td>52</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>عِنْدَ دُخُولِهِ يُقَدِّمُ رِجْلَهُ الْيُسْرَى وَيَقُولُ: (بِسْمِ اللهِ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْخُبْثِ وَالْخَبَائِثِ).</td><td></td><td>u5/u5l9/hook</td><td>#/lesson/u5/u5l9</td></tr><tr class="p-low"><td>158</td><td>الأذكار والآداب</td><td>آداب الخلاء</td><td>هدف الدرس</td><td>أن تعرف أذكار دخول الخلاء والخروج منه وآدابه.</td><td>صياغة تعليمية مساعدة</td><td>52</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>عِنْدَ دُخُولِهِ يُقَدِّمُ رِجْلَهُ الْيُسْرَى وَيَقُولُ: (بِسْمِ اللهِ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْخُبْثِ وَالْخَبَائِثِ).</td><td></td><td>u5/u5l9/objective</td><td>#/lesson/u5/u5l9</td></tr><tr class="p-low"><td>160</td><td>الأذكار والآداب</td><td>السلام</td><td>مدخل الدرس</td><td>تحيةُ أهل الجنة، وأول ما تفتح به قلوب الناس. فما صيغتها الكاملة؟</td><td>صياغة تعليمية مساعدة</td><td>52</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>إِذَا لَقِيتَ مُسْلِمًا فَسَلِّمْ عَلَيْهِ قَائِلًا: (السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ)، وَإِنْ سَلَّمَ عَلَيْكَ فَقُلْ: (وَعَلَيْكُمُ السَّلَامُ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ).</td><td></td><td>u5/u5l10/hook</td><td>#/lesson/u5/u5l10</td></tr><tr class="p-low"><td>161</td><td>الأذكار والآداب</td><td>السلام</td><td>هدف الدرس</td><td>أن تعرف صيغة السلام وردّه.</td><td>صياغة تعليمية مساعدة</td><td>52</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>إِذَا لَقِيتَ مُسْلِمًا فَسَلِّمْ عَلَيْهِ قَائِلًا: (السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ)، وَإِنْ سَلَّمَ عَلَيْكَ فَقُلْ: (وَعَلَيْكُمُ السَّلَامُ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ).</td><td></td><td>u5/u5l10/objective</td><td>#/lesson/u5/u5l10</td></tr><tr class="p-low"><td>165</td><td>الأذكار والآداب</td><td>الاستئذان وآداب المجلس</td><td>مدخل الدرس</td><td>طرقتَ الباب ثلاثًا فلم يُؤذن لك. ماذا تفعل؟ وماذا تقول لو سُئلت: مَن؟</td><td>صياغة تعليمية مساعدة</td><td>52</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>إِذَا أَرَدْتَ الدُّخُولَ عَلَى أَحَدٍ فَاسْتَأْذِنْ، وَاقِفًا عَنْ يَمِينِ الْبَابِ أَوْ يَسَارِهِ، وَإِنْ أَرَدْتَ أَنْ تُكَرِّرَ الِاسْتِئْذَانَ فَكَرِّرْهُ ثَلَاثًا فَقَطْ، فَإِنْ سَأَلَكَ فَقَالَ: مَنْ؟ فَقُلْ: فُلَانٌ، وَلَا تَقُلْ: أَنَا. فَإِنْ أَذِنَ لَكَ دَخَلْتَ، وَإِنْ قِيلَ لَكَ: ارْجِعْ. فَارْجِعْ.</td><td></td><td>u5/u5l11/hook</td><td>#/lesson/u5/u5l11</td></tr><tr class="p-low"><td>166</td><td>الأذكار والآداب</td><td>الاستئذان وآداب المجلس</td><td>هدف الدرس</td><td>أن تعرف آداب الاستئذان وآداب المجلس كما ذكرها الكتاب.</td><td>صياغة تعليمية مساعدة</td><td>52</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>إِذَا أَرَدْتَ الدُّخُولَ عَلَى أَحَدٍ فَاسْتَأْذِنْ، وَاقِفًا عَنْ يَمِينِ الْبَابِ أَوْ يَسَارِهِ، وَإِنْ أَرَدْتَ أَنْ تُكَرِّرَ الِاسْتِئْذَانَ فَكَرِّرْهُ ثَلَاثًا فَقَطْ، فَإِنْ سَأَلَكَ فَقَالَ: مَنْ؟ فَقُلْ: فُلَانٌ، وَلَا تَقُلْ: أَنَا. فَإِنْ أَذِنَ لَكَ دَخَلْتَ، وَإِنْ قِيلَ لَكَ: ارْجِعْ. فَارْجِعْ.</td><td></td><td>u5/u5l11/objective</td><td>#/lesson/u5/u5l11</td></tr><tr class="p-low"><td>169</td><td>الأذكار والآداب</td><td>أذكار المسجد</td><td>مدخل الدرس</td><td>ذكرٌ عند الدخول وذكرٌ عند الخروج — بينهما فرقٌ لطيف في المعنى.</td><td>صياغة تعليمية مساعدة</td><td>53</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَقُولُ عِنْدَ دُخُولِهِ: (اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ). وَعِنْدَ خُرُوجِهِ: (اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ فَضْلِكَ).</td><td></td><td>u5/u5l12/hook</td><td>#/lesson/u5/u5l12</td></tr><tr class="p-low"><td>170</td><td>الأذكار والآداب</td><td>أذكار المسجد</td><td>هدف الدرس</td><td>أن تعرف ذكر دخول المسجد والخروج منه.</td><td>صياغة تعليمية مساعدة</td><td>53</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَقُولُ عِنْدَ دُخُولِهِ: (اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ). وَعِنْدَ خُرُوجِهِ: (اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ فَضْلِكَ).</td><td></td><td>u5/u5l12/objective</td><td>#/lesson/u5/u5l12</td></tr><tr class="p-low"><td>175</td><td>الأذكار والآداب</td><td>عند العطاس</td><td>مدخل الدرس</td><td>ثلاث جُمل قصيرة بينك وبين أخيك تُحوّل عطسةً عابرة إلى سنّة وأجر.</td><td>صياغة تعليمية مساعدة</td><td>53</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يُغَطِّي الْعَاطِسُ وَجْهَهُ، فَإِذَا عَطَسَ يَقُولُ: (الْحَمْدُ لِلهِ). وَيَرُدُّ عَلَيْهِ مَنْ سَمِعَهُ فَيَقُولُ: (يَرْحَمُكَ اللهُ). فَيَرُدُّ عَلَيْهِ وَيَقُولُ: (يَهْدِيكُمُ اللهُ وَيُصْلِحُ بَالَكُمْ).</td><td></td><td>u5/u5l13/hook</td><td>#/lesson/u5/u5l13</td></tr><tr class="p-low"><td>176</td><td>الأذكار والآداب</td><td>عند العطاس</td><td>هدف الدرس</td><td>أن تعرف ما يقوله العاطس ومن سمعه وما يردّ به.</td><td>صياغة تعليمية مساعدة</td><td>53</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يُغَطِّي الْعَاطِسُ وَجْهَهُ، فَإِذَا عَطَسَ يَقُولُ: (الْحَمْدُ لِلهِ). وَيَرُدُّ عَلَيْهِ مَنْ سَمِعَهُ فَيَقُولُ: (يَرْحَمُكَ اللهُ). فَيَرُدُّ عَلَيْهِ وَيَقُولُ: (يَهْدِيكُمُ اللهُ وَيُصْلِحُ بَالَكُمْ).</td><td></td><td>u5/u5l13/objective</td><td>#/lesson/u5/u5l13</td></tr><tr class="p-low"><td>180</td><td>الأذكار والآداب</td><td>التثاؤب</td><td>مدخل الدرس</td><td>سؤال يتكرّر: هل للتثاؤب ذكرٌ خاص؟ الجواب في سطرين.</td><td>صياغة تعليمية مساعدة</td><td>54</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَرُدُّهُ مَا اسْتَطَاعَ، وَيُمْسِكُ بِيَدِهِ عَلَى فِيهِ، وَلَا يَقُولُ: آهْ آهْ. وَلَيْسَ لَهُ ذِكْرٌ خَاصٌّ.</td><td></td><td>u5/u5l14/hook</td><td>#/lesson/u5/u5l14</td></tr><tr class="p-low"><td>181</td><td>الأذكار والآداب</td><td>التثاؤب</td><td>هدف الدرس</td><td>أن تعرف ما يُفعل عند التثاؤب، وأنه لا ذكر خاص له.</td><td>صياغة تعليمية مساعدة</td><td>54</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>يَرُدُّهُ مَا اسْتَطَاعَ، وَيُمْسِكُ بِيَدِهِ عَلَى فِيهِ، وَلَا يَقُولُ: آهْ آهْ. وَلَيْسَ لَهُ ذِكْرٌ خَاصٌّ.</td><td></td><td>u5/u5l14/objective</td><td>#/lesson/u5/u5l14</td></tr><tr class="p-low"><td>185</td><td>الأذكار والآداب</td><td>عند الكرب</td><td>مدخل الدرس</td><td>حين يضيق صدرك ولا تجد مخرجًا، هذه كلمات علّمك إياها نبيّك ﷺ.</td><td>صياغة تعليمية مساعدة</td><td>54</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>(لَا إِلَهَ إِلَّا اللهُ الْعَظِيمُ الْحَلِيمُ، لَا إِلَهَ إِلَّا اللهُ رَبُّ الْعَرْشِ الْعَظِيمِ، لَا إِلَهَ إِلَّا اللهُ رَبُّ السَّمَاوَاتِ وَرَبُّ الْأَرْضِ وَرَبُّ الْعَرْشِ الْعَظِيمِ).</td><td></td><td>u5/u5l15/hook</td><td>#/lesson/u5/u5l15</td></tr><tr class="p-low"><td>186</td><td>الأذكار والآداب</td><td>عند الكرب</td><td>هدف الدرس</td><td>أن تحفظ دعاء الكرب.</td><td>صياغة تعليمية مساعدة</td><td>54</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>(لَا إِلَهَ إِلَّا اللهُ الْعَظِيمُ الْحَلِيمُ، لَا إِلَهَ إِلَّا اللهُ رَبُّ الْعَرْشِ الْعَظِيمِ، لَا إِلَهَ إِلَّا اللهُ رَبُّ السَّمَاوَاتِ وَرَبُّ الْأَرْضِ وَرَبُّ الْعَرْشِ الْعَظِيمِ).</td><td></td><td>u5/u5l15/objective</td><td>#/lesson/u5/u5l15</td></tr><tr class="p-low"><td>190</td><td>الأذكار والآداب</td><td>الاستخارة</td><td>مدخل الدرس</td><td>حِرْتَ بين أمرين ولا تدري أيّهما خير لك. صلاةٌ ودعاءٌ يحسمان تردّدك.</td><td>صياغة تعليمية مساعدة</td><td>54</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>إِذَا تَرَدَّدَ بَيْنَ فِعْلِ أَمْرٍ أَوْ تَرْكِهِ، أَوْ تَرَدَّدَ بَيْنَ أَمْرَيْنِ أَيَّهُمَا يَفْعَلُهُ، فَإِنَّهُ يُصَلِّي رَكْعَتَيْنِ، وَيَقُولُ بَعْدَمَا يُسَلِّمُ مِنَ الصَّلَاةِ:</td><td></td><td>u5/u5l16/hook</td><td>#/lesson/u5/u5l16</td></tr><tr class="p-low"><td>191</td><td>الأذكار والآداب</td><td>الاستخارة</td><td>هدف الدرس</td><td>أن تعرف متى تُشرع الاستخارة وكيفيتها ولفظ دعائها.</td><td>صياغة تعليمية مساعدة</td><td>54</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>إِذَا تَرَدَّدَ بَيْنَ فِعْلِ أَمْرٍ أَوْ تَرْكِهِ، أَوْ تَرَدَّدَ بَيْنَ أَمْرَيْنِ أَيَّهُمَا يَفْعَلُهُ، فَإِنَّهُ يُصَلِّي رَكْعَتَيْنِ، وَيَقُولُ بَعْدَمَا يُسَلِّمُ مِنَ الصَّلَاةِ:</td><td></td><td>u5/u5l16/objective</td><td>#/lesson/u5/u5l16</td></tr><tr class="p-low"><td>193</td><td>الأذكار والآداب</td><td>الاستخارة</td><td>سؤال النقاش الأسري</td><td>اتفقوا على أن يستخير كل واحد منكم في قرارٍ قادم، وتذاكروا معنى (ثم أرضني).</td><td>صياغة تعليمية مساعدة</td><td>54</td><td>اقتراح نشاط أسري مستحدث؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>إِذَا تَرَدَّدَ بَيْنَ فِعْلِ أَمْرٍ أَوْ تَرْكِهِ، أَوْ تَرَدَّدَ بَيْنَ أَمْرَيْنِ أَيَّهُمَا يَفْعَلُهُ، فَإِنَّهُ يُصَلِّي رَكْعَتَيْنِ، وَيَقُولُ بَعْدَمَا يُسَلِّمُ مِنَ الصَّلَاةِ:</td><td></td><td>u5/u5l16/family</td><td>#/lesson/u5/u5l16</td></tr><tr class="p-low"><td>194</td><td>الأذكار والآداب</td><td>صلة الرحم</td><td>مدخل الدرس</td><td>مَن هم رَحِمُك الذين تجب صلتهم؟ وما مقدار الصلة الواجبة؟</td><td>صياغة تعليمية مساعدة</td><td>55</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهُمُ الْأَقَارِبُ فِي النَّسَبِ مِنْ جِهَةِ الْأَبِ وَالْأُمِّ، الْأَقْرَبُ فَالْأَقْرَبُ، وَالْوَاجِبُ مِنْ ذَلِكَ: كُلُّ أُنْثَى يَحْرُمُ نِكَاحُهَا مِنْ جِهَةِ النَّسَبِ، وَكُلُّ رَجُلٍ لَوْ كَانَ أُنْثَى حَرُمَ نِكَاحُهُ مِنْ جِهَةِ النَّسَبِ، وَأَعْظَمُهُمُ الْوَالِدَانِ.</td><td></td><td>u5/u5l17/hook</td><td>#/lesson/u5/u5l17</td></tr><tr class="p-low"><td>195</td><td>الأذكار والآداب</td><td>صلة الرحم</td><td>هدف الدرس</td><td>أن تعرف تعريف الرحم الواجب صلته، وصفة الصلة، وجزاء الواصل والقاطع.</td><td>صياغة تعليمية مساعدة</td><td>55</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهُمُ الْأَقَارِبُ فِي النَّسَبِ مِنْ جِهَةِ الْأَبِ وَالْأُمِّ، الْأَقْرَبُ فَالْأَقْرَبُ، وَالْوَاجِبُ مِنْ ذَلِكَ: كُلُّ أُنْثَى يَحْرُمُ نِكَاحُهَا مِنْ جِهَةِ النَّسَبِ، وَكُلُّ رَجُلٍ لَوْ كَانَ أُنْثَى حَرُمَ نِكَاحُهُ مِنْ جِهَةِ النَّسَبِ، وَأَعْظَمُهُمُ الْوَالِدَانِ.</td><td></td><td>u5/u5l17/objective</td><td>#/lesson/u5/u5l17</td></tr><tr class="p-low"><td>197</td><td>الأخلاق</td><td>الصدق</td><td>مدخل الدرس</td><td>كلمةٌ صغيرة تُكتب بها عند الله صِدِّيقًا، أو كذّابًا. أيّهما تختار؟</td><td>صياغة تعليمية مساعدة</td><td>59</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الصِّدْقَ يَهْدِي إِلَى الْبِرِّ، وَإِنَّ الْبِرَّ يَهْدِي إِلَى الْجَنَّةِ، وَإِنَّ الرَّجُلَ لَيَصْدُقُ حَتَّى يَكُونَ صِدِّيقًا. وَإِنَّ الْكَذِبَ يَهْدِي إِلَى الْفُجُورِ، وَإِنَّ الْفُجُورَ يَهْدِي إِلَى النَّارِ، وَإِنَّ الرَّجُلَ لَيَكْذِبُ حَتَّى يُكْتَبَ عِنْدَ اللهِ كَذَّابًا»</td><td></td><td>u6/u6l1/hook</td><td>#/lesson/u6/u6l1</td></tr><tr class="p-low"><td>198</td><td>الأخلاق</td><td>الصدق</td><td>هدف الدرس</td><td>أن تعرف دليل الصدق من الكتاب والسنة وأثره في صاحبه.</td><td>صياغة تعليمية مساعدة</td><td>59</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الصِّدْقَ يَهْدِي إِلَى الْبِرِّ، وَإِنَّ الْبِرَّ يَهْدِي إِلَى الْجَنَّةِ، وَإِنَّ الرَّجُلَ لَيَصْدُقُ حَتَّى يَكُونَ صِدِّيقًا. وَإِنَّ الْكَذِبَ يَهْدِي إِلَى الْفُجُورِ، وَإِنَّ الْفُجُورَ يَهْدِي إِلَى النَّارِ، وَإِنَّ الرَّجُلَ لَيَكْذِبُ حَتَّى يُكْتَبَ عِنْدَ اللهِ كَذَّابًا»</td><td></td><td>u6/u6l1/objective</td><td>#/lesson/u6/u6l1</td></tr><tr class="p-low"><td>200</td><td>الأخلاق</td><td>الصدق</td><td>سؤال النقاش الأسري</td><td>اجعلوا شعار الأسبوع في البيت: «لا كذب ولو مازحًا».</td><td>صياغة تعليمية مساعدة</td><td>59</td><td>اقتراح نشاط أسري مستحدث؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الصِّدْقَ يَهْدِي إِلَى الْبِرِّ، وَإِنَّ الْبِرَّ يَهْدِي إِلَى الْجَنَّةِ، وَإِنَّ الرَّجُلَ لَيَصْدُقُ حَتَّى يَكُونَ صِدِّيقًا. وَإِنَّ الْكَذِبَ يَهْدِي إِلَى الْفُجُورِ، وَإِنَّ الْفُجُورَ يَهْدِي إِلَى النَّارِ، وَإِنَّ الرَّجُلَ لَيَكْذِبُ حَتَّى يُكْتَبَ عِنْدَ اللهِ كَذَّابًا»</td><td></td><td>u6/u6l1/family</td><td>#/lesson/u6/u6l1</td></tr><tr class="p-low"><td>202</td><td>الأخلاق</td><td>الصبر</td><td>مدخل الدرس</td><td>أجرٌ واحد في القرآن لم يُذكر له حساب ولا عدد. لمن هو؟</td><td>صياغة تعليمية مساعدة</td><td>59</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«وَمَنْ يَتَصَبَّرْ يُصَبِّرْهُ اللهُ، وَمَا أُعْطِيَ أَحَدٌ عَطَاءً خَيْرًا وَأَوْسَعَ مِنَ الصَّبْرِ»</td><td></td><td>u6/u6l2/hook</td><td>#/lesson/u6/u6l2</td></tr><tr class="p-low"><td>203</td><td>الأخلاق</td><td>الصبر</td><td>هدف الدرس</td><td>أن تعرف دليل الصبر من الكتاب والسنة وفضله.</td><td>صياغة تعليمية مساعدة</td><td>59</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«وَمَنْ يَتَصَبَّرْ يُصَبِّرْهُ اللهُ، وَمَا أُعْطِيَ أَحَدٌ عَطَاءً خَيْرًا وَأَوْسَعَ مِنَ الصَّبْرِ»</td><td></td><td>u6/u6l2/objective</td><td>#/lesson/u6/u6l2</td></tr><tr class="p-low"><td>206</td><td>الأخلاق</td><td>الأمانة</td><td>مدخل الدرس</td><td>ثلاث علامات إن اجتمعت في رجل فهو منافق. أتعرفها؟</td><td>صياغة تعليمية مساعدة</td><td>60</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«آيَةُ الْمُنَافِقِ ثَلَاثٌ: إِذَا حَدَّثَ كَذَبَ، وَإِذَا وَعَدَ أَخْلَفَ، وَإِذَا اؤْتُمِنَ خَانَ»</td><td></td><td>u6/u6l3/hook</td><td>#/lesson/u6/u6l3</td></tr><tr class="p-low"><td>207</td><td>الأخلاق</td><td>الأمانة</td><td>هدف الدرس</td><td>أن تعرف دليل الأمانة وعلامات المنافق الثلاث.</td><td>صياغة تعليمية مساعدة</td><td>60</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«آيَةُ الْمُنَافِقِ ثَلَاثٌ: إِذَا حَدَّثَ كَذَبَ، وَإِذَا وَعَدَ أَخْلَفَ، وَإِذَا اؤْتُمِنَ خَانَ»</td><td></td><td>u6/u6l3/objective</td><td>#/lesson/u6/u6l3</td></tr><tr class="p-low"><td>211</td><td>الأخلاق</td><td>العفاف</td><td>مدخل الدرس</td><td>أبوابٌ مغلقة، وامرأةٌ ذات منصب وجمال، ولا رقيب. ماذا قال يوسف عليه السلام؟</td><td>صياغة تعليمية مساعدة</td><td>60</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ الْكَفُّ عَمَّا لَا يَحِلُّ، وَمِنْ أَخْطَرِهِ الشَّهَوَاتُ الْمُحَرَّمَةُ.</td><td></td><td>u6/u6l4/hook</td><td>#/lesson/u6/u6l4</td></tr><tr class="p-low"><td>212</td><td>الأخلاق</td><td>العفاف</td><td>هدف الدرس</td><td>أن تعرف تعريف العفاف ودليله ودعاء النبي ﷺ به.</td><td>صياغة تعليمية مساعدة</td><td>60</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>وَهِيَ الْكَفُّ عَمَّا لَا يَحِلُّ، وَمِنْ أَخْطَرِهِ الشَّهَوَاتُ الْمُحَرَّمَةُ.</td><td></td><td>u6/u6l4/objective</td><td>#/lesson/u6/u6l4</td></tr><tr class="p-low"><td>215</td><td>الأخلاق</td><td>الحياء</td><td>مدخل الدرس</td><td>خُلقٌ واحد جعله النبي ﷺ شعبةً من الإيمان. فما هو؟</td><td>صياغة تعليمية مساعدة</td><td>61</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الْحَيَاءَ مِنَ الْإِيمَانِ»</td><td></td><td>u6/u6l5/hook</td><td>#/lesson/u6/u6l5</td></tr><tr class="p-low"><td>216</td><td>الأخلاق</td><td>الحياء</td><td>هدف الدرس</td><td>أن تعرف دليل الحياء من الكتاب والسنة.</td><td>صياغة تعليمية مساعدة</td><td>61</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الْحَيَاءَ مِنَ الْإِيمَانِ»</td><td></td><td>u6/u6l5/objective</td><td>#/lesson/u6/u6l5</td></tr><tr class="p-low"><td>219</td><td>الأخلاق</td><td>الشجاعة</td><td>مدخل الدرس</td><td>فزع أهل المدينة ليلًا، فمَن كان أوّل من سبقهم إلى مصدر الصوت؟</td><td>صياغة تعليمية مساعدة</td><td>61</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>كَانَ النَّبِيُّ ﷺ أَحْسَنَ النَّاسِ وَأَشْجَعَ النَّاسِ وَأَجْوَدَ النَّاسِ، وَلَقَدْ فَزِعَ أَهْلُ الْمَدِينَةِ، فَكَانَ النَّبِيُّ ﷺ سَبَقَهُمْ عَلَى فَرَسٍ.</td><td></td><td>u6/u6l6/hook</td><td>#/lesson/u6/u6l6</td></tr><tr class="p-low"><td>220</td><td>الأخلاق</td><td>الشجاعة</td><td>هدف الدرس</td><td>أن تعرف دليل الشجاعة، وحال النبي ﷺ فيها.</td><td>صياغة تعليمية مساعدة</td><td>61</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>كَانَ النَّبِيُّ ﷺ أَحْسَنَ النَّاسِ وَأَشْجَعَ النَّاسِ وَأَجْوَدَ النَّاسِ، وَلَقَدْ فَزِعَ أَهْلُ الْمَدِينَةِ، فَكَانَ النَّبِيُّ ﷺ سَبَقَهُمْ عَلَى فَرَسٍ.</td><td></td><td>u6/u6l6/objective</td><td>#/lesson/u6/u6l6</td></tr><tr class="p-low"><td>225</td><td>الأخلاق</td><td>الكرم</td><td>مدخل الدرس</td><td>الله كريم يحبّ الكرم — وهذا وحده يكفي لتغيير علاقتك بالعطاء.</td><td>صياغة تعليمية مساعدة</td><td>62</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ اللهَ كَرِيمٌ يُحِبُّ الْكَرَمَ، وَيُحِبُّ مَعَالِيَ الْأَخْلَاقِ، وَيَكْرَهُ سَفْسَافَهَا»</td><td></td><td>u6/u6l7/hook</td><td>#/lesson/u6/u6l7</td></tr><tr class="p-low"><td>226</td><td>الأخلاق</td><td>الكرم</td><td>هدف الدرس</td><td>أن تعرف دليل الكرم من الكتاب والسنة.</td><td>صياغة تعليمية مساعدة</td><td>62</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ اللهَ كَرِيمٌ يُحِبُّ الْكَرَمَ، وَيُحِبُّ مَعَالِيَ الْأَخْلَاقِ، وَيَكْرَهُ سَفْسَافَهَا»</td><td></td><td>u6/u6l7/objective</td><td>#/lesson/u6/u6l7</td></tr><tr class="p-low"><td>229</td><td>الأخلاق</td><td>الوفاء</td><td>مدخل الدرس</td><td>العهد الذي تعطيه اليوم ستُسأل عنه غدًا. فهل تُحسن حفظه؟</td><td>صياغة تعليمية مساعدة</td><td>62</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«أَرْبَعٌ مَنْ كُنَّ فِيهِ كَانَ مُنَافِقًا خَالِصًا، وَمَنْ كَانَتْ فِيهِ خَصْلَةٌ مِنْهُنَّ كَانَتْ فِيهِ خَصْلَةٌ مِنَ النِّفَاقِ حَتَّى يَدَعَهَا: إِذَا اؤْتُمِنَ خَانَ، وَإِذَا حَدَّثَ كَذَبَ، وَإِذَا عَاهَدَ غَدَرَ، وَإِذَا خَاصَمَ فَجَرَ»</td><td></td><td>u6/u6l8/hook</td><td>#/lesson/u6/u6l8</td></tr><tr class="p-low"><td>230</td><td>الأخلاق</td><td>الوفاء</td><td>هدف الدرس</td><td>أن تعرف دليل الوفاء وخصال النفاق الأربع.</td><td>صياغة تعليمية مساعدة</td><td>62</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«أَرْبَعٌ مَنْ كُنَّ فِيهِ كَانَ مُنَافِقًا خَالِصًا، وَمَنْ كَانَتْ فِيهِ خَصْلَةٌ مِنْهُنَّ كَانَتْ فِيهِ خَصْلَةٌ مِنَ النِّفَاقِ حَتَّى يَدَعَهَا: إِذَا اؤْتُمِنَ خَانَ، وَإِذَا حَدَّثَ كَذَبَ، وَإِذَا عَاهَدَ غَدَرَ، وَإِذَا خَاصَمَ فَجَرَ»</td><td></td><td>u6/u6l8/objective</td><td>#/lesson/u6/u6l8</td></tr><tr class="p-low"><td>233</td><td>الأخلاق</td><td>حسن الجوار</td><td>مدخل الدرس</td><td>ظنّ النبي ﷺ من كثرة وصية جبريل بالجار أنه سيجعل له ميراثًا. أهكذا تعامل جارك؟</td><td>صياغة تعليمية مساعدة</td><td>63</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«مَا زَالَ جِبْرِيلُ يُوصِينِي بِالْجَارِ حَتَّى ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُ»</td><td></td><td>u6/u6l9/hook</td><td>#/lesson/u6/u6l9</td></tr><tr class="p-low"><td>234</td><td>الأخلاق</td><td>حسن الجوار</td><td>هدف الدرس</td><td>أن تعرف دليل حسن الجوار من الكتاب والسنة.</td><td>صياغة تعليمية مساعدة</td><td>63</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«مَا زَالَ جِبْرِيلُ يُوصِينِي بِالْجَارِ حَتَّى ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُ»</td><td></td><td>u6/u6l9/objective</td><td>#/lesson/u6/u6l9</td></tr><tr class="p-low"><td>236</td><td>الأخلاق</td><td>حسن الجوار</td><td>سؤال النقاش الأسري</td><td>اتفقوا على هديّة بسيطة أو زيارة قصيرة لجارٍ هذا الأسبوع.</td><td>صياغة تعليمية مساعدة</td><td>63</td><td>اقتراح نشاط أسري مستحدث؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«مَا زَالَ جِبْرِيلُ يُوصِينِي بِالْجَارِ حَتَّى ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُ»</td><td></td><td>u6/u6l9/family</td><td>#/lesson/u6/u6l9</td></tr><tr class="p-low"><td>238</td><td>الأخلاق</td><td>مساعدة ذي الحاجة</td><td>مدخل الدرس</td><td>كربةٌ تفرّجها عن أخيك اليوم، يفرّج الله بها عنك كربةً يوم القيامة.</td><td>صياغة تعليمية مساعدة</td><td>63</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«مَنْ نَفَّسَ عَنْ مُؤْمِنٍ كُرْبَةً مِنْ كُرَبِ الدُّنْيَا، نَفَّسَ اللهُ عَنْهُ كُرْبَةً مِنْ كُرَبِ يَوْمِ الْقِيَامَةِ، وَمَنْ يَسَّرَ عَلَى مُعْسِرٍ، يَسَّرَ اللهُ عَلَيْهِ فِي الدُّنْيَا وَالْآخِرَةِ، وَمَنْ سَتَرَ مُسْلِمًا، سَتَرَهُ اللهُ فِي الدُّنْيَا وَالْآخِرَةِ، وَاللهُ فِي عَوْنِ الْعَبْدِ مَا كَانَ الْعَبْدُ فِي عَوْنِ أَخِيهِ»</td><td></td><td>u6/u6l10/hook</td><td>#/lesson/u6/u6l10</td></tr><tr class="p-low"><td>239</td><td>الأخلاق</td><td>مساعدة ذي الحاجة</td><td>هدف الدرس</td><td>أن تعرف دليل مساعدة المحتاج وجزاءها.</td><td>صياغة تعليمية مساعدة</td><td>63</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«مَنْ نَفَّسَ عَنْ مُؤْمِنٍ كُرْبَةً مِنْ كُرَبِ الدُّنْيَا، نَفَّسَ اللهُ عَنْهُ كُرْبَةً مِنْ كُرَبِ يَوْمِ الْقِيَامَةِ، وَمَنْ يَسَّرَ عَلَى مُعْسِرٍ، يَسَّرَ اللهُ عَلَيْهِ فِي الدُّنْيَا وَالْآخِرَةِ، وَمَنْ سَتَرَ مُسْلِمًا، سَتَرَهُ اللهُ فِي الدُّنْيَا وَالْآخِرَةِ، وَاللهُ فِي عَوْنِ الْعَبْدِ مَا كَانَ الْعَبْدُ فِي عَوْنِ أَخِيهِ»</td><td></td><td>u6/u6l10/objective</td><td>#/lesson/u6/u6l10</td></tr><tr class="p-low"><td>242</td><td>الرقائق</td><td>الخوف والرجاء</td><td>مدخل الدرس</td><td>آيتان متجاورتان: مغفرةٌ ورحمة، وعذابٌ أليم. لماذا جمع الله بينهما؟</td><td>صياغة تعليمية مساعدة</td><td>67</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«لَوْ يَعْلَمُ الْمُؤْمِنُ مَا عِنْدَ اللهِ مِنَ الْعُقُوبَةِ، مَا طَمِعَ بِجَنَّتِهِ أَحَدٌ، وَلَوْ يَعْلَمُ الْكَافِرُ مَا عِنْدَ اللهِ مِنَ الرَّحْمَةِ، مَا قَنَطَ مِنْ جَنَّتِهِ أَحَدٌ»</td><td></td><td>u7/u7l1/hook</td><td>#/lesson/u7/u7l1</td></tr><tr class="p-low"><td>243</td><td>الرقائق</td><td>الخوف والرجاء</td><td>هدف الدرس</td><td>أن تعرف الجمع بين الخوف والرجاء بدليله من الكتاب والسنة.</td><td>صياغة تعليمية مساعدة</td><td>67</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«لَوْ يَعْلَمُ الْمُؤْمِنُ مَا عِنْدَ اللهِ مِنَ الْعُقُوبَةِ، مَا طَمِعَ بِجَنَّتِهِ أَحَدٌ، وَلَوْ يَعْلَمُ الْكَافِرُ مَا عِنْدَ اللهِ مِنَ الرَّحْمَةِ، مَا قَنَطَ مِنْ جَنَّتِهِ أَحَدٌ»</td><td></td><td>u7/u7l1/objective</td><td>#/lesson/u7/u7l1</td></tr><tr class="p-low"><td>246</td><td>الرقائق</td><td>الصحة والفراغ</td><td>مدخل الدرس</td><td>نعمتان لا تشعر بقيمتهما إلا بعد فقدهما، وكثير من الناس مغبونون فيهما.</td><td>صياغة تعليمية مساعدة</td><td>67</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«نِعْمَتَانِ مَغْبُونٌ فِيهِمَا كَثِيرٌ مِنَ النَّاسِ: الصِّحَّةُ وَالْفَرَاغُ»</td><td></td><td>u7/u7l2/hook</td><td>#/lesson/u7/u7l2</td></tr><tr class="p-low"><td>247</td><td>الرقائق</td><td>الصحة والفراغ</td><td>هدف الدرس</td><td>أن تعرف حديث النعمتين المغبون فيهما كثير من الناس.</td><td>صياغة تعليمية مساعدة</td><td>67</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«نِعْمَتَانِ مَغْبُونٌ فِيهِمَا كَثِيرٌ مِنَ النَّاسِ: الصِّحَّةُ وَالْفَرَاغُ»</td><td></td><td>u7/u7l2/objective</td><td>#/lesson/u7/u7l2</td></tr><tr class="p-low"><td>249</td><td>الرقائق</td><td>الصحة والفراغ</td><td>سؤال النقاش الأسري</td><td>اسألوا بعضكم: كيف قضيتَ فراغك اليوم؟ واقترحوا عملًا صالحًا يملأ فراغ الغد.</td><td>صياغة تعليمية مساعدة</td><td>67</td><td>اقتراح نشاط أسري مستحدث؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«نِعْمَتَانِ مَغْبُونٌ فِيهِمَا كَثِيرٌ مِنَ النَّاسِ: الصِّحَّةُ وَالْفَرَاغُ»</td><td></td><td>u7/u7l2/family</td><td>#/lesson/u7/u7l2</td></tr><tr class="p-low"><td>251</td><td>الرقائق</td><td>المبادرة بالأعمال الصالحة</td><td>مدخل الدرس</td><td>فتنٌ كقطع الليل المظلم، يُصبح الرجل مؤمنًا ويُمسي كافرًا. فماذا تفعل الآن؟</td><td>صياغة تعليمية مساعدة</td><td>67</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«بَادِرُوا بِالْأَعْمَالِ، فِتَنًا كَقِطَعِ اللَّيْلِ الْمُظْلِمِ، يُصْبِحُ الرَّجُلُ مُؤْمِنًا وَيُمْسِي كَافِرًا، أَوْ يُمْسِي مُؤْمِنًا وَيُصْبِحُ كَافِرًا، يَبِيعُ دِينَهُ بِعَرَضٍ مِنَ الدُّنْيَا»</td><td></td><td>u7/u7l3/hook</td><td>#/lesson/u7/u7l3</td></tr><tr class="p-low"><td>252</td><td>الرقائق</td><td>المبادرة بالأعمال الصالحة</td><td>هدف الدرس</td><td>أن تعرف حديث المبادرة بالأعمال وسببه.</td><td>صياغة تعليمية مساعدة</td><td>67</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«بَادِرُوا بِالْأَعْمَالِ، فِتَنًا كَقِطَعِ اللَّيْلِ الْمُظْلِمِ، يُصْبِحُ الرَّجُلُ مُؤْمِنًا وَيُمْسِي كَافِرًا، أَوْ يُمْسِي مُؤْمِنًا وَيُصْبِحُ كَافِرًا، يَبِيعُ دِينَهُ بِعَرَضٍ مِنَ الدُّنْيَا»</td><td></td><td>u7/u7l3/objective</td><td>#/lesson/u7/u7l3</td></tr><tr class="p-low"><td>256</td><td>الرقائق</td><td>عابر سبيل</td><td>مدخل الدرس</td><td>أخذ النبي ﷺ بمنكب ابن عمر فقال له كلمةً غيّرت نظرته للدنيا كلها.</td><td>صياغة تعليمية مساعدة</td><td>68</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«كُنْ فِي الدُّنْيَا كَأَنَّكَ غَرِيبٌ أَوْ عَابِرُ سَبِيلٍ»</td><td></td><td>u7/u7l4/hook</td><td>#/lesson/u7/u7l4</td></tr><tr class="p-low"><td>257</td><td>الرقائق</td><td>عابر سبيل</td><td>هدف الدرس</td><td>أن تعرف حديث (كن في الدنيا كأنك غريب) ووصية ابن عمر.</td><td>صياغة تعليمية مساعدة</td><td>68</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«كُنْ فِي الدُّنْيَا كَأَنَّكَ غَرِيبٌ أَوْ عَابِرُ سَبِيلٍ»</td><td></td><td>u7/u7l4/objective</td><td>#/lesson/u7/u7l4</td></tr><tr class="p-low"><td>261</td><td>الرقائق</td><td>الصور والأعمال</td><td>مدخل الدرس</td><td>الناس ينظرون إلى مظهرك ومالك. فإلى أيّ شيء ينظر الله؟</td><td>صياغة تعليمية مساعدة</td><td>68</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ اللهَ لَا يَنْظُرُ إِلَى صُوَرِكُمْ وَأَمْوَالِكُمْ، وَلَكِنْ يَنْظُرُ إِلَى قُلُوبِكُمْ وَأَعْمَالِكُمْ»</td><td></td><td>u7/u7l5/hook</td><td>#/lesson/u7/u7l5</td></tr><tr class="p-low"><td>262</td><td>الرقائق</td><td>الصور والأعمال</td><td>هدف الدرس</td><td>أن تعرف حديث (إن الله لا ينظر إلى صوركم وأموالكم).</td><td>صياغة تعليمية مساعدة</td><td>68</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ اللهَ لَا يَنْظُرُ إِلَى صُوَرِكُمْ وَأَمْوَالِكُمْ، وَلَكِنْ يَنْظُرُ إِلَى قُلُوبِكُمْ وَأَعْمَالِكُمْ»</td><td></td><td>u7/u7l5/objective</td><td>#/lesson/u7/u7l5</td></tr><tr class="p-low"><td>266</td><td>الرقائق</td><td>لا يتبعك إلا عملك</td><td>مدخل الدرس</td><td>ثلاثة يتبعون الميت إلى قبره، فيرجع اثنان ويبقى واحد. فمن يبقى؟</td><td>صياغة تعليمية مساعدة</td><td>68</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«يَتْبَعُ الْمَيِّتَ ثَلَاثَةٌ، فَيَرْجِعُ اثْنَانِ وَيَبْقَى وَاحِدٌ، يَتْبَعُهُ أَهْلُهُ وَمَالُهُ وَعَمَلُهُ، فَيَرْجِعُ أَهْلُهُ وَمَالُهُ وَيَبْقَى عَمَلُهُ»</td><td></td><td>u7/u7l6/hook</td><td>#/lesson/u7/u7l6</td></tr><tr class="p-low"><td>267</td><td>الرقائق</td><td>لا يتبعك إلا عملك</td><td>هدف الدرس</td><td>أن تعرف حديث ما يتبع الميت.</td><td>صياغة تعليمية مساعدة</td><td>68</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«يَتْبَعُ الْمَيِّتَ ثَلَاثَةٌ، فَيَرْجِعُ اثْنَانِ وَيَبْقَى وَاحِدٌ، يَتْبَعُهُ أَهْلُهُ وَمَالُهُ وَعَمَلُهُ، فَيَرْجِعُ أَهْلُهُ وَمَالُهُ وَيَبْقَى عَمَلُهُ»</td><td></td><td>u7/u7l6/objective</td><td>#/lesson/u7/u7l6</td></tr><tr class="p-low"><td>271</td><td>الرقائق</td><td>برحمة الله لا بالعمل</td><td>مدخل الدرس</td><td>قالوا: ولا أنت يا رسول الله؟ قال: «ولا أنا». فما الذي يُدخل الجنة إذًا؟</td><td>صياغة تعليمية مساعدة</td><td>69</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«سَدِّدُوا وَقَارِبُوا، وَأَبْشِرُوا، فَإِنَّهُ لَنْ يُدْخِلَ الْجَنَّةَ أَحَدًا عَمَلُهُ» قَالُوا: وَلَا أَنْتَ يَا رَسُولَ اللهِ؟ قَالَ: «وَلَا أَنَا، إِلَّا أَنْ يَتَغَمَّدَنِيَ اللهُ مِنْهُ بِرَحْمَةٍ، وَاعْلَمُوا أَنَّ أَحَبَّ الْعَمَلِ إِلَى اللهِ أَدْوَمُهُ وَإِنْ قَلَّ»</td><td></td><td>u7/u7l7/hook</td><td>#/lesson/u7/u7l7</td></tr><tr class="p-low"><td>272</td><td>الرقائق</td><td>برحمة الله لا بالعمل</td><td>هدف الدرس</td><td>أن تعرف حديث (سدّدوا وقاربوا) وأحبّ العمل إلى الله.</td><td>صياغة تعليمية مساعدة</td><td>69</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«سَدِّدُوا وَقَارِبُوا، وَأَبْشِرُوا، فَإِنَّهُ لَنْ يُدْخِلَ الْجَنَّةَ أَحَدًا عَمَلُهُ» قَالُوا: وَلَا أَنْتَ يَا رَسُولَ اللهِ؟ قَالَ: «وَلَا أَنَا، إِلَّا أَنْ يَتَغَمَّدَنِيَ اللهُ مِنْهُ بِرَحْمَةٍ، وَاعْلَمُوا أَنَّ أَحَبَّ الْعَمَلِ إِلَى اللهِ أَدْوَمُهُ وَإِنْ قَلَّ»</td><td></td><td>u7/u7l7/objective</td><td>#/lesson/u7/u7l7</td></tr><tr class="p-low"><td>274</td><td>الرقائق</td><td>برحمة الله لا بالعمل</td><td>سؤال النقاش الأسري</td><td>اتفقوا في البيت على عمل صالح صغير يوميّ يستمر شهرًا كاملًا.</td><td>صياغة تعليمية مساعدة</td><td>69</td><td>اقتراح نشاط أسري مستحدث؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«سَدِّدُوا وَقَارِبُوا، وَأَبْشِرُوا، فَإِنَّهُ لَنْ يُدْخِلَ الْجَنَّةَ أَحَدًا عَمَلُهُ» قَالُوا: وَلَا أَنْتَ يَا رَسُولَ اللهِ؟ قَالَ: «وَلَا أَنَا، إِلَّا أَنْ يَتَغَمَّدَنِيَ اللهُ مِنْهُ بِرَحْمَةٍ، وَاعْلَمُوا أَنَّ أَحَبَّ الْعَمَلِ إِلَى اللهِ أَدْوَمُهُ وَإِنْ قَلَّ»</td><td></td><td>u7/u7l7/family</td><td>#/lesson/u7/u7l7</td></tr><tr class="p-low"><td>278</td><td>الرقائق</td><td>رحمة الله</td><td>مدخل الدرس</td><td>امرأةٌ في السبي وجدت صبيًّا فألصقته ببطنها وأرضعته. فماذا قال النبي ﷺ لأصحابه؟</td><td>صياغة تعليمية مساعدة</td><td>69</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>قُدِمَ عَلَى رَسُولِ اللهِ ﷺ بِسَبْيٍ فَإِذَا امْرَأَةٌ مِنَ السَّبْيِ تَبْتَغِي، إِذَا وَجَدَتْ صَبِيًّا فِي السَّبْيِ، أَخَذَتْهُ فَأَلْصَقَتْهُ بِبَطْنِهَا وَأَرْضَعَتْهُ، فَقَالَ لَنَا رَسُولُ اللهِ ﷺ: «أَتَرَوْنَ هَذِهِ الْمَرْأَةَ طَارِحَةً وَلَدَهَا فِي النَّارِ؟» قُلْنَا: لَا وَاللهِ، وَهِيَ تَقْدِرُ عَلَى أَلَّا تَطْرَحَهُ، فَقَالَ رَسُولُ اللهِ ﷺ: «لَلهُ أَرْحَمُ بِعِبَادِهِ مِنْ هَذِهِ بِوَلَدِهَا»</td><td></td><td>u7/u7l8/hook</td><td>#/lesson/u7/u7l8</td></tr><tr class="p-low"><td>279</td><td>الرقائق</td><td>رحمة الله</td><td>هدف الدرس</td><td>أن تعرف سعة رحمة الله بدليلها من الكتاب والسنة.</td><td>صياغة تعليمية مساعدة</td><td>69</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>قُدِمَ عَلَى رَسُولِ اللهِ ﷺ بِسَبْيٍ فَإِذَا امْرَأَةٌ مِنَ السَّبْيِ تَبْتَغِي، إِذَا وَجَدَتْ صَبِيًّا فِي السَّبْيِ، أَخَذَتْهُ فَأَلْصَقَتْهُ بِبَطْنِهَا وَأَرْضَعَتْهُ، فَقَالَ لَنَا رَسُولُ اللهِ ﷺ: «أَتَرَوْنَ هَذِهِ الْمَرْأَةَ طَارِحَةً وَلَدَهَا فِي النَّارِ؟» قُلْنَا: لَا وَاللهِ، وَهِيَ تَقْدِرُ عَلَى أَلَّا تَطْرَحَهُ، فَقَالَ رَسُولُ اللهِ ﷺ: «لَلهُ أَرْحَمُ بِعِبَادِهِ مِنْ هَذِهِ بِوَلَدِهَا»</td><td></td><td>u7/u7l8/objective</td><td>#/lesson/u7/u7l8</td></tr><tr class="p-low"><td>283</td><td>الرقائق</td><td>فتنة النساء</td><td>مدخل الدرس</td><td>أول فتنة وقعت في بني إسرائيل، حذّر منها النبي ﷺ أمته.</td><td>صياغة تعليمية مساعدة</td><td>70</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الدُّنْيَا حُلْوَةٌ خَضِرَةٌ، وَإِنَّ اللهَ مُسْتَخْلِفُكُمْ فِيهَا، فَيَنْظُرُ كَيْفَ تَعْمَلُونَ، فَاتَّقُوا الدُّنْيَا وَاتَّقُوا النِّسَاءَ، فَإِنَّ أَوَّلَ فِتْنَةِ بَنِي إِسْرَائِيلَ كَانَتْ فِي النِّسَاءِ»</td><td></td><td>u7/u7l9/hook</td><td>#/lesson/u7/u7l9</td></tr><tr class="p-low"><td>284</td><td>الرقائق</td><td>فتنة النساء</td><td>هدف الدرس</td><td>أن تعرف حديث فتنة الدنيا والنساء.</td><td>صياغة تعليمية مساعدة</td><td>70</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«إِنَّ الدُّنْيَا حُلْوَةٌ خَضِرَةٌ، وَإِنَّ اللهَ مُسْتَخْلِفُكُمْ فِيهَا، فَيَنْظُرُ كَيْفَ تَعْمَلُونَ، فَاتَّقُوا الدُّنْيَا وَاتَّقُوا النِّسَاءَ، فَإِنَّ أَوَّلَ فِتْنَةِ بَنِي إِسْرَائِيلَ كَانَتْ فِي النِّسَاءِ»</td><td></td><td>u7/u7l9/objective</td><td>#/lesson/u7/u7l9</td></tr><tr class="p-low"><td>288</td><td>الرقائق</td><td>فتنة المال</td><td>مدخل الدرس</td><td>لم يكن الفقر أخوف ما خافه النبي ﷺ على أمته. فما الذي خافه؟</td><td>صياغة تعليمية مساعدة</td><td>70</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«وَاللهِ مَا الْفَقْرَ أَخْشَى عَلَيْكُمْ، وَلَكِنِّي أَخْشَى أَنْ تُبْسَطَ الدُّنْيَا عَلَيْكُمْ، كَمَا بُسِطَتْ عَلَى مَنْ كَانَ قَبْلَكُمْ، فَتَنَافَسُوهَا كَمَا تَنَافَسُوهَا، وَتُهْلِكَكُمْ كَمَا أَهْلَكَتْهُمْ»</td><td></td><td>u7/u7l10/hook</td><td>#/lesson/u7/u7l10</td></tr><tr class="p-low"><td>289</td><td>الرقائق</td><td>فتنة المال</td><td>هدف الدرس</td><td>أن تعرف حديث خشية بسط الدنيا على الأمة.</td><td>صياغة تعليمية مساعدة</td><td>70</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«وَاللهِ مَا الْفَقْرَ أَخْشَى عَلَيْكُمْ، وَلَكِنِّي أَخْشَى أَنْ تُبْسَطَ الدُّنْيَا عَلَيْكُمْ، كَمَا بُسِطَتْ عَلَى مَنْ كَانَ قَبْلَكُمْ، فَتَنَافَسُوهَا كَمَا تَنَافَسُوهَا، وَتُهْلِكَكُمْ كَمَا أَهْلَكَتْهُمْ»</td><td></td><td>u7/u7l10/objective</td><td>#/lesson/u7/u7l10</td></tr><tr class="p-low"><td>293</td><td>الرقائق</td><td>المجاهدة</td><td>مدخل الدرس</td><td>حُجبت الجنة بالمكاره، وحُجبت النار بالشهوات. فأيّ الطريقين تسلك؟</td><td>صياغة تعليمية مساعدة</td><td>70</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«حُجِبَتِ النَّارُ بِالشَّهَوَاتِ، وَحُجِبَتِ الْجَنَّةُ بِالْمَكَارِهِ»</td><td></td><td>u7/u7l11/hook</td><td>#/lesson/u7/u7l11</td></tr><tr class="p-low"><td>294</td><td>الرقائق</td><td>المجاهدة</td><td>هدف الدرس</td><td>أن تعرف دليل مجاهدة النفس من الكتاب والسنة.</td><td>صياغة تعليمية مساعدة</td><td>70</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«حُجِبَتِ النَّارُ بِالشَّهَوَاتِ، وَحُجِبَتِ الْجَنَّةُ بِالْمَكَارِهِ»</td><td></td><td>u7/u7l11/objective</td><td>#/lesson/u7/u7l11</td></tr><tr class="p-low"><td>300</td><td>الرقائق</td><td>بين حُبّ لقاء الله وكُرهه</td><td>مدخل الدرس</td><td>قالت عائشة: إنّا لنكره الموت! فصحّح لها النبي ﷺ المفهوم في جملة واحدة.</td><td>صياغة تعليمية مساعدة</td><td>71</td><td>مدخل تشويقي مستحدث ليس من الكتاب؛ يحتاج إقرار الصياغة والأسلوب.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«مَنْ أَحَبَّ لِقَاءَ اللهِ أَحَبَّ اللهُ لِقَاءَهُ، وَمَنْ كَرِهَ لِقَاءَ اللهِ كَرِهَ اللهُ لِقَاءَهُ» فَقَالَتْ عَائِشَةُ رضي الله عنها: إِنَّا لَنَكْرَهُ الْمَوْتَ، قَالَ: «لَيْسَ ذَاكِ، وَلَكِنَّ الْمُؤْمِنَ إِذَا حَضَرَهُ الْمَوْتُ بُشِّرَ بِرِضْوَانِ اللهِ وَكَرَامَتِهِ، فَلَيْسَ شَيْءٌ أَحَبَّ إِلَيْهِ مِمَّا أَمَامَهُ، فَأَحَبَّ لِقَاءَ اللهِ وَأَحَبَّ اللهُ لِقَاءَهُ، وَإِنَّ الْكَافِرَ إِذَا حُضِرَ بُشِّرَ بِعَذَابِ اللهِ وَعُقُوبَتِهِ، فَلَيْسَ شَيْءٌ أَكْرَهَ إِلَيْهِ مِمَّا أَمَامَهُ، كَرِهَ لِقَاءَ اللهِ وَكَرِهَ اللهُ لِقَاءَهُ»</td><td></td><td>u7/u7l12/hook</td><td>#/lesson/u7/u7l12</td></tr><tr class="p-low"><td>301</td><td>الرقائق</td><td>بين حُبّ لقاء الله وكُرهه</td><td>هدف الدرس</td><td>أن تفرّق بين كراهية الموت وكراهية لقاء الله.</td><td>صياغة تعليمية مساعدة</td><td>71</td><td>هدف إجرائي مستحدث للدرس؛ يحتاج إقرار الصياغة.</td><td>منخفضة</td><td>بانتظار المراجعة</td><td></td><td></td><td>«مَنْ أَحَبَّ لِقَاءَ اللهِ أَحَبَّ اللهُ لِقَاءَهُ، وَمَنْ كَرِهَ لِقَاءَ اللهِ كَرِهَ اللهُ لِقَاءَهُ» فَقَالَتْ عَائِشَةُ رضي الله عنها: إِنَّا لَنَكْرَهُ الْمَوْتَ، قَالَ: «لَيْسَ ذَاكِ، وَلَكِنَّ الْمُؤْمِنَ إِذَا حَضَرَهُ الْمَوْتُ بُشِّرَ بِرِضْوَانِ اللهِ وَكَرَامَتِهِ، فَلَيْسَ شَيْءٌ أَحَبَّ إِلَيْهِ مِمَّا أَمَامَهُ، فَأَحَبَّ لِقَاءَ اللهِ وَأَحَبَّ اللهُ لِقَاءَهُ، وَإِنَّ الْكَافِرَ إِذَا حُضِرَ بُشِّرَ بِعَذَابِ اللهِ وَعُقُوبَتِهِ، فَلَيْسَ شَيْءٌ أَكْرَهَ إِلَيْهِ مِمَّا أَمَامَهُ، كَرِهَ لِقَاءَ اللهِ وَكَرِهَ اللهُ لِقَاءَهُ»</td><td></td><td>u7/u7l12/objective</td><td>#/lesson/u7/u7l12</td></tr></tbody></table>
</body></html>